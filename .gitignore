
# agent-harness-hub (ctx): índice local, cache de binários e overrides locais do harness
.venv/
.ctx/
.claude/settings.local.json

# r36os: build artifacts
/out/
# r36os: build cache (sources, build trees, ccache, distfiles, abuild keys, factory areas,
# VM disk); created No-COW on Btrfs. `git clean -fdx` deletes it, abuild keys included.
/.cache/
# rascunhos locais para validação (não versionados)
/var/
# diretórios de trabalho do abuild (fontes baixadas e pacote montado)
/aports/*/src/
/aports/*/pkg/
/aports/*/tmp/
__pycache__/
*.pyc
.pytest_cache/

# Build tool (not in SYSTEM): static binaries of the initramfs for the device tree
# selection (openspec change boot-dtb-select, D2 and D5). lume-bootsel chooses the device
# tree and kexec (kexec-tools) reloads the same kernel with it. The initramfs has no C
# library, so both are static; Alpine has no static libfdt, so libfdt is built here from
# the dtc sources.
pkgname=lume-bootsel
pkgver=1.0
pkgrel=14
_dtcver=1.7.2
_kexecver=2.0.32
pkgdesc="Device tree selection for the initramfs of Lume Retro OS (static, with kexec)"
url="https://example.invalid"
arch="all"
license="GPL-2.0-or-later"
makedepends="linux-headers"
options="!check" # tested on the PC with a fake root (tests/unit/test_lume_bootsel.py)
source="lume-bootsel.c
	https://www.kernel.org/pub/software/utils/dtc/dtc-$_dtcver.tar.xz
	https://www.kernel.org/pub/linux/utils/kernel/kexec/kexec-tools-$_kexecver.tar.xz
	"

build() {
	cd "$srcdir"
	${CC:-cc} $CFLAGS -Wall -Wextra -static -I dtc-$_dtcver/libfdt -o lume-bootsel \
		lume-bootsel.c dtc-$_dtcver/libfdt/fdt*.c $LDFLAGS

	cd "$srcdir"/kexec-tools-$_kexecver
	./configure --without-lzma --without-zlib --without-xen LDFLAGS="$LDFLAGS -static"
	make
}

package() {
	local d="$pkgdir"/usr/lib/lume/initramfs/bin
	install -Dm755 "$srcdir"/lume-bootsel "$d"/lume-bootsel
	install -Dm755 "$srcdir"/kexec-tools-$_kexecver/build/sbin/kexec "$d"/kexec
}

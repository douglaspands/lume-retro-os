# Lume Retro OS: the power fragment (build-speed D2, node 8.1). The zram service and script, the sysctl settings and the backlight udev rule.
# The files live in files/ at the same paths and modes they have in the image, and the package
# ships them as they are.
#
# noarch: built once in the x86_64 builder and published as the same .apk for every
# architecture (r36os build, packages.build_noarch). No ELF file may be added to files/.
pkgname=lume-power
pkgver=1.0
pkgrel=0
pkgdesc="Power and memory settings: ZRAM swap, sysctl, backlight rule"
url="https://example.invalid"
arch="noarch"
license="GPL-2.0-or-later"
depends="lume-core"
options="!check" # tested on the host (tests/unit and the shell suites)
# etc/sysctl.d/00-alpine.conf is the Lume version of a setting an Alpine package could ship.
# On Alpine 3.24 apk lists no owner for it (checked with baselayout, procps-ng installed), so
# this is a guard: replaces lets apk install ours on top and replaces_priority makes the Lume
# file win whichever package apk unpacks first.
replaces="alpine-baselayout alpine-baselayout-data procps procps-ng"
replaces_priority=100
# services `r36os push --hot` restarts when they are running (empty: none)
_lume_restart=""
builddir="$srcdir"

build() {
	:
}

package() {
	mkdir -p "$pkgdir"
	cp -a "$startdir"/files/. "$pkgdir"/
	# a checkout may have any umask: pin the directories (the files keep the git modes)
	find "$pkgdir" -type d -exec chmod 755 {} +
	chown -R 0:0 "$pkgdir"
}

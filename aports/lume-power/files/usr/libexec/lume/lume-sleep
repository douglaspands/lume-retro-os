#!/bin/sh
# lume-sleep (openspec device-fixes D11, task 8.3): suspend and power off by the power button.
# The protocol is frozen in task 3.2: docs/LAUNCHER.md ("Protocolo do sono") and
# lume/lume-core/src/sleep.rs; the input daemon (aports/lume-input/input.c) mirrors it.
#
#   lume-sleep run                    the service (OpenRC lume-sleep, root, after the frontend):
#                                     creates the request folder and waits in inotifyd on it,
#                                     blocked in the kernel while idle (no loop, no timer)
#   lume-sleep <event> <dir> <name>   the inotifyd handler; inotifyd waits for it, so the
#                                     requests run one at a time
#
# A `suspend` request, in this order (each step that fails logs `sleep FAIL <step>: <reason>`
# and the sequence goes on):
#   1. status `suspending <seq>`, phase `suspend <seq>`; lume-input relays it to its clients
#      (lume-run pauses the game, which also closes the sound stream, D9 7.3; lume-ui stops
#      drawing) and answers in `clients` within 2 s; this waits for it up to 3 s
#   2. sound: nothing to do (D9, 7.3: the paused game already closed the PCM, and the kernel
#      powers the DAPM down on suspend)
#   3. clock: `lume-clock save` when the image has it (device-fixes 9.1, D15)
#   4. sync, after `persist flush` when the image has it
#   4b. the card (game-experience-tuning D11, task 9.3): the suspension mark
#      ROMS/logs/.suspended-<console> with the boot number, ROMS remounted read-only (no
#      process can write to the card until it is checked at the wake; the open files and the
#      point of the game stay as they are) and the fingerprint of the card (lume-cardid: the
#      boot counter logs/.boot, its entry and the allocation bitmap, read from the block
#      device past the kernel caches). A remount that fails (a file open for writing) is
#      logged and the suspension goes on, with the check at the wake all the same.
#   5. backlight 0, the level remembered
#   6. Wi-Fi radio off, only when it was on (NetworkManager, nmcli)
#   7. governor: `suspend` to the FIFO of lume-power (device-fixes 8.6 adds the scenario; an
#      older lume-power ignores the message)
#   8. USB gadget unbound from the UDC, the name remembered (J1 on the GA36: without it the
#      musb never comes back after freeze and the PC loses the console)
#   8b. wakeup sources (task 8.1): each `nowake <device folder under /sys>` line of the console
#      file whose power/wakeup is `enabled` is set to `disabled`, so only the power button
#      wakes the console (the charger plug, the battery and the RTC alarm do not)
#   9. the mode of the console (/usr/share/lume/sleep/<board>.conf: freeze, or mem = `deep`
#      to mem_sleep first); `sleep OK suspend <mode>`, status `suspended <seq> <mode>`, and the
#      write to /sys/power/state, where the console sleeps until the power button
# Back, first of all (the processes are already thawed, ROMS is still read-only): the
# fingerprint read again. Another line (the card started on the other console, or another
# card) or a card that stays unreadable: the exFAT is shut down (no write reaches the card
# even if ROMS stayed writable) and the console restarts at once with `reboot -n -f` (no sync,
# no shutdown runlevel: nothing is written with the stale allocation table); the mark makes the
# next boot log `sleep FAIL card changed during suspend` (logs.sh, suspend_marks). The same
# line: ROMS writable again and the mark removed, then the rest
# (or after a refusal of the kernel: `sleep FAIL suspend <mode>: <reason>`, with the same
# steps undone, so the screen is on again), backwards: the wakeup sources enabled again, the
# gadget bound again in the background ~1 s later, governor `resume`, Wi-Fi on, backlight level back; then status `resuming`, phase
# `resume <seq>` (lume-input drops the queued input and relays it), status `awake` and
# `sleep OK resume after <s>`. A `suspend` within 1 s of the wake is the press that woke the
# console: dropped. A request made during a sequence is dropped too (kernel log only).
#
# A `poweroff` request (the button held 2 s): status `poweroff`, `sleep OK poweroff: power
# button held`, then SIGUSR1 to the session (/run/frontend.pid): the session ends the frontend
# (lume-run quits the game politely) and runs its power_off, the path of the Power off item
# (persist flush, the clock, sync, lume-logd stopped, ROMS remounted read-only, poweroff). With
# no session, or one that did not power off within 30 s, this runs `poweroff` itself (the
# shutdown runlevel, with its own read-only remount).
#
# Environment for the tests: SL_LIBDIR, SL_RUN, LUME_SLEEP_DIR, LUME_SLEEP_CONF, SL_SYS,
# SL_GROUP, SL_OWNER (uid trusted for `clients`), SL_KMSG, SL_WAIT (tenths of a second),
# SL_STEP, SL_GUARD (centiseconds), SL_USB_DELAY, SL_POWEROFF, SL_POWEROFF_WAIT,
# SL_SESSION_PID, SL_CLOCK, SL_NMCLI, SL_SYNC, SL_TIMEOUT, SL_POWER_FIFO, SL_UPTIME, SL_SELF,
# SL_TRACE (one line per step and per sysfs write), SL_PERSIST, SL_MOUNT, SL_CARDID,
# SL_REBOOT, SL_SYSRQ, SL_RO_TRIES, SL_CARD_TRIES, BOARD_FILE, LOGS_RAM, LOGS_DIR, LOGS_MOUNT,
# MOUNTS_FILE.

SL_LIBDIR=${SL_LIBDIR:-/usr/libexec/lume}
# lib.sh creates /run/lume when sourced (silenced for the tests, which have no /run access)
. "$SL_LIBDIR/lib.sh" 2>/dev/null
. "$SL_LIBDIR/logs.sh"

SL_RUN=${SL_RUN:-/run/lume}
SL_DIR=${LUME_SLEEP_DIR:-$SL_RUN/sleep}
SL_CONF=${LUME_SLEEP_CONF:-/usr/share/lume/sleep}
SL_SYS=${SL_SYS:-/sys}
SL_GROUP=${SL_GROUP:-game}
SL_OWNER=${SL_OWNER:-0}
SL_KMSG=${SL_KMSG:-/dev/kmsg}
# the wait for lume-input's `clients` (3 s, lume_core::sleep::SERVICE_WAIT) in steps of 0.1 s
SL_WAIT=${SL_WAIT:-30}
SL_STEP=${SL_STEP:-0.1}
# the wake guard (1 s, WAKE_GUARD) in centiseconds of uptime
SL_GUARD=${SL_GUARD:-100}
SL_USB_DELAY=${SL_USB_DELAY:-1}
SL_POWEROFF=${SL_POWEROFF:-poweroff}
SL_POWEROFF_WAIT=${SL_POWEROFF_WAIT:-30}
SL_SESSION_PID=${SL_SESSION_PID:-/run/frontend.pid}
SL_CLOCK=${SL_CLOCK:-lume-clock}
SL_NMCLI=${SL_NMCLI:-nmcli}
SL_SYNC=${SL_SYNC:-sync}
SL_TIMEOUT=${SL_TIMEOUT:-timeout}
SL_POWER_FIFO=${SL_POWER_FIFO:-$SL_RUN/power}
SL_UPTIME=${SL_UPTIME:-/proc/uptime}
SL_SELF=${SL_SELF:-$0}
SL_TRACE=${SL_TRACE:-}
SL_PERSIST=${SL_PERSIST:-$SL_LIBDIR/persist}
SL_MOUNT=${SL_MOUNT:-mount}
SL_CARDID=${SL_CARDID:-lume-cardid}
SL_REBOOT=${SL_REBOOT:-reboot}
SL_SYSRQ=${SL_SYSRQ:-/proc/sysrq-trigger}
# the read-only remount tried 5 times 0.1 s apart (a flush that has a file open for a moment);
# an unreadable card at the wake read 5 times 0.1 s apart before it counts as changed
SL_RO_TRIES=${SL_RO_TRIES:-5}
SL_CARD_TRIES=${SL_CARD_TRIES:-5}
SL_UDC_FILE=$SL_SYS/kernel/config/usb_gadget/lume/UDC
# private state, outside the folder the game group writes to (root only)
SL_SEQ_FILE=$SL_RUN/sleep.seq
SL_STATUS_FILE=$SL_RUN/sleep.status
SL_AWAKE_FILE=$SL_RUN/sleep.awake
# the background rebind of the gadget: its pid and the UDC name it writes back
SL_USB_PID=$SL_RUN/sleep.usb.pid
SL_USB_NAME=$SL_RUN/sleep.usb

# --- small helpers ---------------------------------------------------------------------------

sl_kmsg() {
	echo "<5>lume-sleep: $*" >"$SL_KMSG" 2>/dev/null
	return 0
}

sl_trace() {
	[ -z "$SL_TRACE" ] || echo "$*" >>"$SL_TRACE"
	return 0
}

# sl_event <OK|FAIL> <detail>
sl_event() {
	event sleep "$1" "$2"
}

# sl_reason <text>: the last line of a command's error output without the "sh: " prefixes and
# the file name, in SL_ERR (the part after the last ": ")
sl_reason() {
	local l last=
	while IFS= read -r l; do
		[ -z "$l" ] || last=$l
	done <<EOF
$1
EOF
	SL_ERR=${last##*: }
	[ -n "$SL_ERR" ] || SL_ERR=${2:-failed}
}

# sl_write <file> <value>: one sysfs write; on failure the reason is in SL_ERR
sl_write() {
	local out
	sl_trace "write ${1#"$SL_SYS"/} $2"
	if out=$({ printf '%s\n' "$2" >"$1"; } 2>&1); then
		return 0
	fi
	sl_reason "$out" "write error"
	return 1
}

# sl_put <name> <line>: an own file of the folder, written by rename from a temporary file in
# the private run directory (never a path the game group can plant a link on)
sl_put() {
	printf '%s\n' "$2" >"$SL_RUN/.sleep.$1.tmp" && mv -f "$SL_RUN/.sleep.$1.tmp" "$SL_DIR/$1"
}

# sl_status <status line>: the private copy (what the admission reads) and the published one
sl_status() {
	printf '%s\n' "$*" >"$SL_STATUS_FILE"
	sl_put status "$*"
}

sl_phase() {
	sl_trace "phase $*"
	sl_put phase "$*"
}

# uptime in centiseconds -> SL_UP (it counts the time suspended)
sl_uptime() {
	local u
	read -r u _ <"$SL_UPTIME"
	SL_UP=$((${u%.*} * 100 + 1${u#*.} - 100))
}

# the mode of this console -> SL_MODE (lume_core::sleep::parse_mode_conf: the last valid
# `mode freeze|mem` line wins; no file, no line or a bad value: freeze)
sl_mode() {
	local l b
	SL_MODE=freeze
	b=$(board)
	[ -r "$SL_CONF/${b:-none}.conf" ] || return 0
	set -f
	while IFS= read -r l; do
		l=${l%%#*}
		# shellcheck disable=SC2086
		set -- $l
		[ "$#" = 2 ] && [ "$1" = mode ] || continue
		case $2 in
		freeze | mem) SL_MODE=$2 ;;
		esac
	done <"$SL_CONF/$b.conf"
	set +f
}

# sl_run_cmd <step> <command...>: a command with a deadline (it must never hold the
# suspension); on failure the reason is in SL_ERR
sl_run_cmd() {
	local out rc
	shift
	sl_trace "run $*"
	out=$($SL_TIMEOUT 5 "$@" 2>&1 </dev/null)
	rc=$?
	[ "$rc" != 0 ] || return 0
	sl_reason "$out" "exit $rc"
	return 1
}

# sl_power <message>: one line to the FIFO of lume-power (opened read-write: never blocks)
sl_power() {
	[ -p "$SL_POWER_FIFO" ] || {
		SL_ERR="power service not running"
		return 1
	}
	sl_trace "power $1"
	{ printf '%s\n' "$1" >&4; } 4<>"$SL_POWER_FIFO" 2>/dev/null || {
		SL_ERR="write to $SL_POWER_FIFO failed"
		return 1
	}
}

# --- 1. the clients --------------------------------------------------------------------------

# sl_clients <seq>: waits for `clients` of this sequence, written by root (lume-input)
sl_clients() {
	local n=0 l f=$SL_DIR/clients
	while [ "$n" -lt "$SL_WAIT" ]; do
		if [ -f "$f" ] && [ "$(stat -c %u "$f" 2>/dev/null)" = "$SL_OWNER" ]; then
			l=
			read -r l <"$f"
			case $l in
			"suspend $1 ok "*)
				sl_trace "clients $l"
				return 0
				;;
			"suspend $1 timeout "*)
				sl_trace "clients $l"
				sl_event FAIL "clients: ${l#"suspend $1 timeout "} answered within 2s"
				return 0
				;;
			esac
		fi
		sleep "$SL_STEP"
		n=$((n + 1))
	done
	sl_trace "clients none"
	sl_event FAIL "clients: lume-input did not answer within 3s"
}

# --- 4b. the card (game-experience-tuning D11, task 9.3) -------------------------------------
# One card serves two consoles. While this one sleeps the kernel keeps the exFAT allocation
# state of ROMS in RAM; a card that started on the other console meanwhile and came back would
# be written with it (clusters the other console gave to other files: the game lists and the
# events.log of 2026-11-19). The kernel cannot tell (same card, same CID), and a read through
# the file system can come from its caches, so the check reads the block device (lume-cardid).

# the device of ROMS -> SL_DEV (empty: not mounted, or read-only already, so nothing to guard)
sl_card_dev() {
	local dev mnt type opts rest
	SL_DEV=
	{
		while read -r dev mnt type opts rest; do
			[ "$mnt" = "$LOGS_MOUNT" ] || continue
			SL_DEV=$dev
			case ",$opts," in *,ro,*) SL_DEV= ;; esac
		done <"${MOUNTS_FILE:-/proc/mounts}"
	} 2>/dev/null
	[ -n "$SL_DEV" ]
}

# the fingerprint of the card -> SL_ID (on failure the reason is in SL_ERR)
sl_card_id() {
	local rc
	SL_ID=$($SL_TIMEOUT 5 "$SL_CARDID" "$SL_DEV" "${LOGS_DIR#"$LOGS_MOUNT"/}/.boot" 2>&1 </dev/null)
	rc=$?
	[ "$rc" != 0 ] || return 0
	sl_reason "$SL_ID" "exit $rc"
	return 1
}

# the suspension mark: this boot's number, while the card is still consistent
sl_mark_put() {
	local out m
	m=$(suspend_mark)
	boot_n_var
	sl_trace "mark ${m##*/} $BOOT_N"
	if out=$({ printf '%s\n' "$BOOT_N" >"$m.tmp" && fsync "$m.tmp" && mv -f "$m.tmp" "$m"; } 2>&1); then
		SL_MARK=$m
		return 0
	fi
	rm -f "$m.tmp"
	sl_reason "$out" "write error"
	return 1
}

# The processes holding a file of ROMS open for writing, one trace line each: "writer <comm>
# <flags> <path>", the path cut to its first two folders under the mount (a save or a ROM
# would name the game). Read only when the read-only remount failed (task 9.4).
sl_card_writers() {
	local p f t fl comm rel
	for p in "${SL_PROC:-/proc}"/[0-9]*; do
		for f in "$p"/fd/*; do
			t=$(readlink "$f" 2>/dev/null) || continue
			case $t in "$LOGS_MOUNT"/*) ;; *) continue ;; esac
			fl=
			while read -r k v; do
				[ "$k" = flags: ] && fl=$v && break
			done <"$p/fdinfo/${f##*/}" 2>/dev/null
			[ -n "$fl" ] || continue
			[ $((0$fl & 3)) -ne 0 ] || continue
			read -r comm <"$p/comm" 2>/dev/null || comm=?
			rel=${t#"$LOGS_MOUNT"/}
			case $rel in */*/*) rel=${rel%"${rel#*/*/}"}; rel=${rel%/} ;; */*) rel=${rel%/*} ;; *) rel=. ;; esac
			sl_trace "writer $comm $fl $rel"
		done
	done
}

sl_card_down() {
	local n=0
	SL_DEV= SL_RO= SL_CARD= SL_MARK=
	sl_card_dev || return 0
	sl_mark_put || sl_event FAIL "card: suspend mark not written ($SL_ERR)"
	while :; do
		if sl_run_cmd remount "$SL_MOUNT" -o remount,ro "$LOGS_MOUNT"; then
			SL_RO=1
			break
		fi
		n=$((n + 1))
		if [ "$n" -ge "$SL_RO_TRIES" ]; then
			sl_card_writers
			sl_event FAIL "card: $LOGS_MOUNT not read-only ($SL_ERR); checked at the wake all the same"
			break
		fi
		sleep "$SL_STEP"
	done
	if sl_card_id; then
		SL_CARD=$SL_ID
		sl_trace "card $SL_ID"
	else
		sl_event FAIL "card: no fingerprint ($SL_ERR); not checked at the wake"
	fi
}

# the card changed: nothing more may reach it. The exFAT shut down first (when ROMS stayed
# writable it stops the writes of the thawed processes and the kernel writeback), then the
# restart without sync and without the shutdown runlevel. A reboot that returns: sysrq b.
sl_card_changed() {
	sl_trace "card changed: $1"
	sl_kmsg "card changed during suspend ($1): restarting without writing to it"
	$SL_TIMEOUT 5 "$SL_CARDID" --shutdown "$LOGS_MOUNT" </dev/null >/dev/null 2>&1
	sl_trace "reboot"
	$SL_REBOOT -n -f </dev/null >/dev/null 2>&1
	sl_kmsg "reboot -n -f returned: sysrq b"
	echo b >"$SL_SYSRQ" 2>/dev/null
	exit 0
}

# sl_card_up <slept>: the first step back, before anything can write to ROMS. Without a
# suspension (cancelled, refused by the kernel) only the undo.
sl_card_up() {
	local n=0
	[ -n "$SL_DEV" ] || return 0
	if [ -n "$1" ] && [ -n "$SL_CARD" ]; then
		while :; do
			if sl_card_id; then
				[ "$SL_ID" != "$SL_CARD" ] || break
				sl_trace "card $SL_ID"
				sl_card_changed "fingerprint changed"
			fi
			n=$((n + 1))
			[ "$n" -lt "$SL_CARD_TRIES" ] || sl_card_changed "card unreadable: $SL_ERR"
			sleep "$SL_STEP"
		done
		sl_trace "card same"
	fi
	if [ -n "$SL_RO" ] && ! sl_run_cmd remount "$SL_MOUNT" -o remount,rw "$LOGS_MOUNT"; then
		sl_event FAIL "card: $LOGS_MOUNT not writable again ($SL_ERR)"
		return 0
	fi
	[ -z "$SL_MARK" ] || rm -f "$SL_MARK"
}

# --- 3 to 8: the steps and their undo --------------------------------------------------------

sl_steps_down() {
	local d l n
	# clock (9.1): skipped silently when the image has no lume-clock
	if command -v "$SL_CLOCK" >/dev/null 2>&1; then
		sl_run_cmd clock "$SL_CLOCK" save || sl_event FAIL "clock: $SL_ERR"
	fi
	# the RetroArch configuration still waiting for its debounce goes to the card now
	if [ -x "$SL_PERSIST" ]; then
		sl_run_cmd persist "$SL_PERSIST" flush || sl_event FAIL "persist: $SL_ERR"
	fi
	# sync
	sl_run_cmd sync "$SL_SYNC" || sl_event FAIL "sync: $SL_ERR"
	# 4b. the card: mark, read-only, fingerprint
	sl_card_down
	# backlight
	SL_BL= SL_BL_LEVEL=
	for d in "$SL_SYS"/class/backlight/*; do
		[ -e "$d/brightness" ] || continue
		l=
		read -r l <"$d/brightness" 2>/dev/null
		if [ -n "$l" ] && [ "$l" != 0 ]; then
			if sl_write "$d/brightness" 0; then
				SL_BL=$d SL_BL_LEVEL=$l
			else
				sl_event FAIL "backlight: $SL_ERR"
			fi
		fi
		break
	done
	# Wi-Fi: only a radio that is on, and only with NetworkManager answering
	SL_WIFI=
	if command -v "$SL_NMCLI" >/dev/null 2>&1; then
		l=$($SL_TIMEOUT 5 "$SL_NMCLI" radio wifi 2>/dev/null </dev/null)
		if [ "$l" = enabled ]; then
			if sl_run_cmd wifi "$SL_NMCLI" radio wifi off; then
				SL_WIFI=1
			else
				sl_event FAIL "wifi: $SL_ERR"
			fi
		fi
	fi
	# governor
	SL_GOV=
	if sl_power suspend; then
		SL_GOV=1
	else
		sl_event FAIL "governor: $SL_ERR"
	fi
	# USB gadget: a rebind of the last wake still waiting is cancelled (the gadget is still
	# unbound and its name is in the file)
	SL_UDC=
	if [ -r "$SL_USB_PID" ]; then
		read -r n <"$SL_USB_PID"
		[ -z "$n" ] || kill "$n" 2>/dev/null
		read -r SL_UDC <"$SL_USB_NAME" 2>/dev/null
		rm -f "$SL_USB_PID" "$SL_USB_NAME"
	fi
	if [ -e "$SL_UDC_FILE" ]; then
		l=
		read -r l <"$SL_UDC_FILE" 2>/dev/null
		if [ -n "$l" ]; then
			if sl_write "$SL_UDC_FILE" ""; then
				SL_UDC=$l
			else
				sl_event FAIL "usb: unbind failed ($SL_ERR)"
			fi
		fi
	fi
	sl_nowake_down
}

# 8b. the wakeup sources that must not wake the console (task 8.1, D11). The console file
# names them as `nowake <device folder>`, relative to /sys, shell patterns allowed (the R36S
# RTC is rk808-rtc.<n>.auto). Only the sysfs switch is used: the drivers of these devices
# arm their interrupt as a wakeup only when power/wakeup is enabled (axp20x_usb_power,
# rtc-sun6i, rtc-rk808), and a power supply with it disabled has no wakeup source left for
# power_supply_changed() to hold. A folder that is missing is skipped; one already disabled
# is left alone (and not enabled on the way back). The power key is never listed: on the GA36
# the axp20x-pek driver makes itself a wakeup source, on the R36S the RK817 interrupt line
# wakes through `wakeup-source` on the PMIC node (the DTS).
sl_nowake_down() {
	local l v f b
	SL_NOWAKE=
	b=$(board)
	[ -r "$SL_CONF/${b:-none}.conf" ] || return 0
	while IFS= read -r l; do
		l=${l%%#*}
		set -f
		# shellcheck disable=SC2086
		set -- $l
		set +f
		[ "$#" = 2 ] && [ "$1" = nowake ] || continue
		case $2 in
		/* | *..*)
			sl_event FAIL "wakeup: refused path $2"
			continue
			;;
		esac
		# shellcheck disable=SC2086
		for f in "$SL_SYS"/$2/power/wakeup; do
			[ -f "$f" ] || continue
			v=
			read -r v <"$f" 2>/dev/null
			[ "$v" = enabled ] || continue
			if sl_write "$f" disabled; then
				SL_NOWAKE="$SL_NOWAKE $f"
			else
				sl_event FAIL "wakeup: ${f#"$SL_SYS"/} not disabled ($SL_ERR)"
			fi
		done
	done <"$SL_CONF/$b.conf"
}

sl_nowake_up() {
	local f
	set -f
	for f in $SL_NOWAKE; do
		sl_write "$f" enabled || sl_event FAIL "wakeup: ${f#"$SL_SYS"/} not enabled again ($SL_ERR)"
	done
	set +f
}

# the gadget bound again, in the background ~1 s after the wake (it never delays the screen)
sl_usb_rebind() {
	[ -n "$SL_UDC" ] || return 0
	printf '%s\n' "$SL_UDC" >"$SL_USB_NAME"
	(
		sleep "$SL_USB_DELAY"
		if sl_write "$SL_UDC_FILE" "$SL_UDC"; then
			sl_trace "usb rebound $SL_UDC"
		else
			sl_event FAIL "usb: UDC not rebound ($SL_ERR)"
		fi
		rm -f "$SL_USB_PID" "$SL_USB_NAME"
	) </dev/null >/dev/null 2>&1 &
	echo "$!" >"$SL_USB_PID"
}

sl_steps_up() {
	sl_nowake_up
	sl_usb_rebind
	if [ -n "$SL_GOV" ]; then
		sl_power resume || sl_event FAIL "governor: $SL_ERR"
	fi
	if [ -n "$SL_WIFI" ]; then
		sl_run_cmd wifi "$SL_NMCLI" radio wifi on || sl_event FAIL "wifi: $SL_ERR"
	fi
	if [ -n "$SL_BL" ]; then
		sl_write "$SL_BL/brightness" "$SL_BL_LEVEL" || sl_event FAIL "backlight: $SL_ERR"
	fi
}

# --- the requests ----------------------------------------------------------------------------

sl_current() {
	SL_CUR=
	read -r SL_CUR <"$SL_STATUS_FILE" 2>/dev/null
	SL_CUR=${SL_CUR:-awake}
}

sl_suspend() {
	local seq t0 why= slept=
	sl_current
	case $SL_CUR in
	awake) ;;
	*)
		sl_kmsg "suspend request dropped: busy ($SL_CUR)"
		return 0
		;;
	esac
	if [ -r "$SL_AWAKE_FILE" ]; then
		read -r t0 <"$SL_AWAKE_FILE"
		sl_uptime
		if [ -n "$t0" ] && [ $((SL_UP - t0)) -lt "$SL_GUARD" ]; then
			sl_kmsg "suspend request dropped: the press that woke the console"
			return 0
		fi
	fi
	seq=0
	read -r seq <"$SL_SEQ_FILE" 2>/dev/null
	seq=$((${seq:-0} + 1))
	echo "$seq" >"$SL_SEQ_FILE"

	# 1. the clients
	sl_status "suspending $seq"
	rm -f "$SL_DIR/clients"
	sl_phase "suspend $seq"
	sl_clients "$seq"
	# 2. sound: nothing (D9, 7.3)
	# 3 to 8
	sl_steps_down
	# 9. the kernel
	sl_mode
	if [ -e "$SL_DIR/poweroff" ]; then
		# the button held meanwhile: no suspension, the power off runs next
		why="cancelled: power off requested"
		sl_kmsg "suspend $why"
	elif [ "$SL_MODE" = mem ] && ! sl_write "$SL_SYS/power/mem_sleep" deep; then
		why="write /sys/power/mem_sleep deep failed ($SL_ERR)"
	else
		sl_status "suspended $seq $SL_MODE"
		sl_event OK "suspend $SL_MODE"
		sl_uptime
		t0=$SL_UP
		if sl_write "$SL_SYS/power/state" "$SL_MODE"; then
			slept=1
		else
			why="write /sys/power/state failed ($SL_ERR)"
		fi
	fi
	# back: the card first (it restarts the console when it changed), then the steps backwards
	sl_card_up "$slept"
	sl_status "resuming $seq"
	sl_steps_up
	sl_phase "resume $seq"
	sl_status awake
	if [ -n "$why" ]; then
		case $why in
		cancelled*) ;;
		*) sl_event FAIL "suspend $SL_MODE: $why" ;;
		esac
	else
		sl_uptime
		echo "$SL_UP" >"$SL_AWAKE_FILE"
		sl_event OK "resume after $(((SL_UP - t0) / 100))"
	fi
	# a suspend request made during the sequence (the Suspend item, a second tap) is dropped
	if [ -f "$SL_DIR/suspend" ]; then
		rm -f "$SL_DIR/suspend"
		sl_kmsg "suspend request dropped: busy (suspending $seq)"
	fi
}

sl_poweroff() {
	local pid=
	sl_current
	if [ "$SL_CUR" = poweroff ]; then
		sl_kmsg "poweroff request dropped: busy (poweroff)"
		return 0
	fi
	sl_status poweroff
	sl_event OK "poweroff: power button held"
	read -r pid <"$SL_SESSION_PID" 2>/dev/null
	if [ -n "$pid" ] && kill -USR1 "$pid" 2>/dev/null; then
		sl_trace "session $pid"
		sl_kmsg "power button held: the session powers off"
		# a session that does not power off (frontend hung) still ends in a power off
		(
			sleep "$SL_POWEROFF_WAIT"
			sl_kmsg "the session did not power off within ${SL_POWEROFF_WAIT}s: powering off"
			sl_trace "poweroff fallback"
			$SL_POWEROFF
		) </dev/null >/dev/null 2>&1 &
		return 0
	fi
	sl_trace "poweroff direct"
	sl_kmsg "power button held: no session, powering off"
	$SL_POWEROFF </dev/null >/dev/null 2>&1
}

# sl_handle <event> <name>: one inotifyd event in the folder
sl_handle() {
	local name=$2 shown
	case $1 in
	w | y) ;;
	*) return 0 ;;
	esac
	# own files, lume-input's and hidden names are not requests
	case $name in
	'' | phase | clients | status | .*) return 0 ;;
	esac
	[ -f "$SL_DIR/$name" ] || return 0
	rm -f "$SL_DIR/$name"
	case $name in
	suspend) sl_suspend ;;
	poweroff) sl_poweroff ;;
	*)
		# tr before cut: cut ends its line with a newline, which tr would turn into a '?'
		shown=$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '?' | cut -c1-32)
		sl_event FAIL "refused request: $shown"
		;;
	esac
}

sl_service() {
	local l f
	mkdir -p "$SL_RUN" "$SL_DIR"
	chown "0:$SL_GROUP" "$SL_DIR" 2>/dev/null || sl_kmsg "cannot give $SL_DIR to the group $SL_GROUP"
	chmod 1770 "$SL_DIR"
	# a phase left at `suspend` by a service that died would keep lume-input holding its clients
	l=
	read -r l <"$SL_DIR/phase" 2>/dev/null
	case $l in
	"suspend "*) sl_phase "resume ${l#suspend }" ;;
	esac
	rm -f "$SL_DIR/clients" "$SL_USB_PID" "$SL_USB_NAME"
	sl_status awake
	# requests made before the service came up
	for f in "$SL_DIR"/*; do
		[ -f "$f" ] && sl_handle w "${f##*/}"
	done
	# w: file closed after writing (the requests are created empty), y: moved in
	exec inotifyd "$SL_SELF" "$SL_DIR:wy"
}

case ${1:-} in
run) sl_service ;;
*) sl_handle "${1:-}" "${3:-}" ;;
esac
exit 0

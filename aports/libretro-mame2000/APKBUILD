# Lume Retro OS local package (not in Alpine).
# MAME 2000 (MAME 0.37b5, the iMAME4All base): the lightest arcade core, under measurement
# against fbneo on the GA36 (game-experience-tuning 10). Default upstream build (Makefile,
# platform unix, -O2), no per-CPU flags: they wait for P-10. ARM=1 is not passed: on unix it
# only turns on 32-bit ARM inline assembly (smull in src/libretro/osinline.h), which does
# not build for aarch64. The commit is the newest of master (2026-09-01). MAME
# non-commercial license (section "Usage and Distribution License" of readme.txt, installed
# in /usr/share/licenses/). The info file comes from libretro-core-info
# (mame2000_libretro.info), copied by rootfs/configure.sh.
pkgname=libretro-mame2000
pkgver=0_git20260901
pkgrel=0
_commit="181b42e5da0d2f0c7a2e59244f23633ed594de2e"
pkgdesc="MAME 2000 (MAME 0.37b5), arcade core for libretro"
url="https://github.com/libretro/mame2000-libretro"
arch="all"
license="custom:MAME"
makedepends="linux-headers"
source="$pkgname-$_commit.tar.gz::https://github.com/libretro/mame2000-libretro/archive/$_commit.tar.gz"
builddir="$srcdir/mame2000-libretro-$_commit"
options="!check" # No tests

build() {
	make -f Makefile
}

package() {
	install -Dm644 mame2000_libretro.so "$pkgdir"/usr/lib/libretro/mame2000_libretro.so
	install -Dm644 readme.txt "$pkgdir"/usr/share/licenses/$pkgname/readme.txt
}
sha512sums="
af67c1a00734df774dcdf91f2fcacda420c2e12d05f6c180c083946ed6992b42cc06558869606f7fe99f9e9af141dd49e12d7c6d05f55592d5a39c2e743fd351  libretro-mame2000-181b42e5da0d2f0c7a2e59244f23633ed594de2e.tar.gz
"

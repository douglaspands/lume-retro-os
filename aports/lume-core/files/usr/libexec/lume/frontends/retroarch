#!/bin/sh
# RetroArch frontend: the user config (persisted) with the distro's fixed keys written into
# it before every start. Fixed files, in order (a later one wins): retroarch-lume.cfg (all
# boards), retroarch-<board>.cfg if it exists, and /run/lume/retroarch-extra.cfg if it
# exists (used by the self-test).
#
# Why not --appendconfig: RetroArch treats an appended config like an override and reloads
# the whole configuration from disk on every core init (config_load_override, runloop.c),
# which includes opening a game and closing it (back to the menu core). A setting changed
# in the menu lives only in memory until RetroArch saves on exit, so that reload threw it
# away. Merged into the user config, there is no override and nothing is reloaded.
#
# RetroArch's "Reset to Default Config" loads LUME_RETROARCH_DEFAULTS after its built-in
# defaults (aports/retroarch patch 0006): the factory user config with the fixed keys
# merged in, written to the user's runtime dir (RAM) on every start.
#
# Opened by the lume-launcher (LUME_LAUNCHER set by lume-run), quitting goes back to the game
# list: LUME_RETROARCH_QUIT=launcher tells RetroArch to label the item "Quit" and to skip
# the confirmation (aports/retroarch patch 0010).
#
# Keys for one run only (lume-launcher D7), given before the RetroArch arguments:
#   --lume-set KEY=VALUE   the value for this run (aspect_ratio_index)
#   --lume-keep KEY        a key RetroArch itself changes for this run (state_slot, by -e)
# and the keys of the core given with -L in retroarch-core.keys (same handling).
# The user's values of those keys are saved in LUME_RESTORE (on the card) and written back
# when RetroArch ends; if it was killed, at the start of the next run. RetroArch saves its
# whole config, so without this the run's value would become the user's.
#
# Factory defaults are applied once per card (game-experience-tuning D3, revised after J1):
# RetroArch saves every key on exit (and every option of a core in its .opt), so a card
# always "has" a key and adding only the missing ones never brings a new default in. Every
# key of factory/retroarch/retroarch.cfg (every start) and every option of
# factory/retroarch/config/<corename>/<corename>.opt (a game run of that core; the folder
# RetroArch uses) is recorded in APPLIED on the card, one "<file> <key>=<value>" line each
# (retroarch.cfg or opt:<corename>), and a factory line missing from the record is written
# over the card's value once. A recorded default is never applied again, so the user's
# choice stays (it only comes back to a card that lacks the key, as the "#unset" of a run
# leaves it); a factory value that changes in a new image is a new line and is applied once.
# The first time (APPLIED has no line of that file: a card from before the record, or a core
# options file the user already had) the card keeps every value: each factory line is only
# recorded, except the "<file> <key>" lines of factory/new-defaults, applied once. A file
# born from the factory copy records everything. user_language is only added when missing:
# the build language never overrides the one picked in the menu (FRONTEND.md).
# BOARD_FILE, LUME_SHARE, LUME_INFO, LUME_EXTRA_CFG, LUME_RESTORE and LUME_FACTORY_APPLIED
# only change for the tests.
SHARE=${LUME_SHARE:-/usr/share/lume}
FACTORY=$SHARE/factory/retroarch
# outside factory/retroarch: lume-persist copies that folder to a new card
NEW_DEFAULTS=$SHARE/factory/new-defaults
# the .info files of the installed cores (rootfs/configure.sh, libretro_info_path)
INFO=${LUME_INFO:-/usr/share/lume/libretro-info}
RESTORE=${LUME_RESTORE:-/storage/system/lume/retroarch-restore.cfg}
APPLIED=${LUME_FACTORY_APPLIED:-/storage/system/lume/factory-applied}
EXTRA=${LUME_EXTRA_CFG:-/run/lume/retroarch-extra.cfg}
USER_CFG=$HOME/.config/retroarch/retroarch.cfg
DEFAULTS=${XDG_RUNTIME_DIR:-/tmp}/retroarch-defaults.cfg
CFGS=$SHARE/retroarch-lume.cfg
BOARD=$(cat "${BOARD_FILE:-/etc/lume/board}" 2>/dev/null)
[ -n "$BOARD" ] && [ -f "$SHARE/retroarch-$BOARD.cfg" ] && CFGS="$CFGS $SHARE/retroarch-$BOARD.cfg"
[ -f "$EXTRA" ] && CFGS="$CFGS $EXTRA"

# Writes the fixed keys into the user config: a fixed key replaces the user's line in
# place, a missing one is appended, every other line is kept as it is.
merge_fixed() {  # user_cfg fixed_cfg...
	local user=$1
	shift
	mkdir -p "${user%/*}"
	[ -f "$user" ] || : > "$user"
	awk '
		function key(l) { if (match(l, /^[A-Za-z0-9_]+[ \t]*=/)) { k = substr(l, 1, RLENGTH - 1); sub(/[ \t]+$/, "", k); return k } return "" }
		FILENAME != USER { k = key($0); if (k != "") { if (!(k in fixed)) order[++n] = k; fixed[k] = $0 } next }
		{ k = key($0); if (k != "" && (k in fixed)) { if (!(k in done)) print fixed[k]; done[k] = 1 } else print }
		END { for (i = 1; i <= n; i++) if (!(order[i] in done)) print fixed[order[i]] }
	' USER="$user" "$@" "$user" > "$user.tmp.$$" && mv -f "$user.tmp.$$" "$user"
}

# Writes back the user's values saved in $RESTORE: "KEY = value" lines replace the key,
# "#unset KEY" lines remove it (the user had none); then the file goes away.
restore_user_keys() {
	[ -f "$RESTORE" ] || return 0
	# no user config yet (it is restored before the fixed keys create it): keep the file
	[ -f "$USER_CFG" ] || return 0
	awk '
		function key(l) { if (match(l, /^[A-Za-z0-9_]+[ \t]*=/)) { k = substr(l, 1, RLENGTH - 1); sub(/[ \t]+$/, "", k); return k } return "" }
		FILENAME != USER { if ($1 == "#unset") { del[$2] = 1; next } k = key($0); if (k != "") { if (!(k in val)) order[++n] = k; val[k] = $0 } next }
		{ k = key($0); if (k != "" && (k in del)) next; if (k != "" && (k in val)) { if (!(k in done)) print val[k]; done[k] = 1 } else print }
		END { for (i = 1; i <= n; i++) if (!(order[i] in done)) print val[order[i]] }
	' USER="$USER_CFG" "$RESTORE" "$USER_CFG" > "$USER_CFG.tmp.$$" && mv -f "$USER_CFG.tmp.$$" "$USER_CFG" &&
		rm -f "$RESTORE"
}

# Applies to a user file the "KEY = value" lines of a factory file that APPLIED does not list
# yet for this file id: the factory line replaces the user's (in place; a repeated key keeps
# one line) or is appended, and "<id> KEY=value" is added to APPLIED. When APPLIED has no
# line of this id yet (first time: the values on the card are the user's), the lines are only
# recorded, except the "<id> KEY" lines of NEW_DEFAULTS, applied. A recorded default (and a
# key in keep_keys, never recorded) is only added when the user file lacks it, as the "#unset"
# of a run leaves it; the user's value is never changed again. A user file that does not exist
# is born as a copy of the factory one, and its defaults are recorded. One awk per pair of
# files, reading APPLIED once; nothing is written when every default is already recorded.
# The user file is written first and APPLIED after it (each temp file + mv in its folder),
# so a cut between the two applies the same values again on the next start. Without a
# writable APPLIED (no card) nothing is applied.
seed_defaults() {  # id user_file factory_file [keep_keys]
	local id=$1 user=$2 factory=$3 keep=${4:-} new="" rc
	[ -f "$factory" ] || return 0
	set -- "$factory"
	[ -f "$NEW_DEFAULTS" ] && set -- "$NEW_DEFAULTS" "$@"
	if [ -f "$APPLIED" ]; then
		set -- "$APPLIED" "$@"
	else
		mkdir -p "${APPLIED%/*}" 2>/dev/null
	fi
	if [ -f "$user" ]; then
		set -- "$@" "$user"
	else
		new=1
		mkdir -p "${user%/*}"
	fi
	# exit 1: nothing to apply, nothing written
	awk '
		function key(l) { if (match(l, /^[A-Za-z0-9_]+[ \t]*=/)) { k = substr(l, 1, RLENGTH - 1); sub(/[ \t]+$/, "", k); return k } return "" }
		FILENAME == APPLIED { done[$0] = 1; old[++o] = $0; if (index($0, ID " ") == 1) seen = 1; next }
		FILENAME == NEWDEF { if ($0 !~ /^[ \t]*(#|$)/) { sub(/[ \t\r]+$/, ""); nd[$0] = 1 } next }
		FILENAME == FACTORY {
			fl[++f] = $0
			k = key($0)
			if (k == "") next
			v = substr($0, index($0, "=") + 1); sub(/^[ \t]+/, "", v); sub(/[ \t\r]+$/, "", v)
			if (!(k in want)) order[++n] = k
			want[k] = $0; ent[k] = ID " " k "=" v
			next
		}
		{ line[++m] = $0; k = key($0); if (k != "") have[k] = 1 }
		END {
			first = !NEW && !seen
			for (i = 1; i <= n; i++) {
				k = order[i]
				if (!index(KEEP, " " k " ") && !(ent[k] in done)) {
					rec[++r] = ent[k]
					if (!first || ((ID " " k) in nd)) { put[k] = 1; w++; continue }
				}
				if (!NEW && !(k in have)) { add[k] = 1; w++ }
			}
			if (!w && !r && !NEW) exit 1
			if (NEW) for (i = 1; i <= f; i++) print fl[i] > OUT
			else if (w) {
				for (i = 1; i <= m; i++) {
					k = key(line[i])
					if (k != "" && (k in put)) { if (!(k in wrote)) print want[k] > OUT; wrote[k] = 1 }
					else print line[i] > OUT
				}
				for (i = 1; i <= n; i++) { k = order[i]; if (((k in put) || (k in add)) && !(k in wrote)) print want[k] > OUT }
			}
			if (NEW || w) close(OUT)
			if (!r) exit 0
			for (i = 1; i <= o; i++) print old[i] > LOUT
			for (i = 1; i <= r; i++) print rec[i] > LOUT
			close(LOUT)
		}
	' ID="$id" KEEP=" $keep " NEW="$new" APPLIED="$APPLIED" FACTORY="$factory" \
		NEWDEF="$NEW_DEFAULTS" OUT="$user.tmp.$$" LOUT="$APPLIED.tmp.$$" "$@"
	rc=$?
	[ "$rc" = 1 ] && return 0
	if [ "$rc" != 0 ]; then
		rm -f "$user.tmp.$$" "$APPLIED.tmp.$$"
		return 0
	fi
	[ -f "$user.tmp.$$" ] && mv -f "$user.tmp.$$" "$user"
	if [ -f "$APPLIED.tmp.$$" ]; then
		sync "$APPLIED.tmp.$$" 2>/dev/null
		mv -f "$APPLIED.tmp.$$" "$APPLIED"
	fi
	return 0
}

# CORE_NAME = the folder of a core's options: the corename of its .info, empty without one.
# RetroArch names that folder after the library_name the core itself reports, which a _lume
# build (cores_lume.py) keeps from the upstream core; only its .info corename carries the
# " (<label>)" suffix, dropped here (GA36, 2026-11-20: genesis_plus_gx_lume saved its options
# in config/Genesis Plus GX/). Read by the shell itself: no process for each game.
core_name() {  # core
	core_info_name "$1"
	case $1 in *_lume) CORE_NAME=${CORE_NAME% (*)} ;; esac
}

core_info_name() {  # core
	CORE_NAME=""
	[ -f "$INFO/${1}_libretro.info" ] || return 0
	local l
	while IFS= read -r l; do
		case $l in
		"corename "*|"corename	"*|corename=*)
			l=${l#*=}
			l=${l#"${l%%[! 	]*}"}
			l=${l%"${l##*[! 	]}"}
			l=${l#\"}
			CORE_NAME=${l%\"}
			return 0 ;;
		esac
	done < "$INFO/${1}_libretro.info"
}

# a run killed before it could put the user's values back
restore_user_keys
# factory defaults not yet applied on this card (D3); after the restore, so a key the user
# never had (the "#unset" of a run) gets the factory value, and before the fixed keys, so a
# board key that is also a factory default (video_threaded) keeps the board's value
seed_defaults retroarch.cfg "$USER_CFG" "$FACTORY/retroarch.cfg" user_language
# shellcheck disable=SC2086
merge_fixed "$USER_CFG" $CFGS
# distro defaults for the reset: factory config + fixed keys (skipped if the runtime dir
# is not writable; the reset then behaves as upstream)
if cp "$FACTORY/retroarch.cfg" "$DEFAULTS" 2>/dev/null; then
	# shellcheck disable=SC2086
	merge_fixed "$DEFAULTS" $CFGS
	export LUME_RETROARCH_DEFAULTS="$DEFAULTS"
fi
[ -n "${LUME_MERGE_ONLY:-}" ] && exit 0
[ -n "${LUME_LAUNCHER:-}" ] && export LUME_RETROARCH_QUIT=launcher
# Opened by the launcher, RetroArch shows no screen of its own around the game (the user,
# 2026-11-17; a Lume splash comes later): no load animation with the system and the game
# name, and the QUIT of lume-run ends at once, without "Press again to quit"
if [ -n "${LUME_LAUNCHER:-}" ]; then
	LAUNCHER_KEYS=${XDG_RUNTIME_DIR:-/tmp}/retroarch-launcher.cfg
	printf 'menu_show_load_content_animation = "false"\nquit_press_twice = "false"\n' > "$LAUNCHER_KEYS"
	merge_fixed "$USER_CFG" "$LAUNCHER_KEYS"
fi
# As the reserve frontend there is no lume-run to open the menu (Fn+B or the Lume menu, and
# the Fn never reaches RetroArch): Start + Select opens it again (lume-hud-actions D9)
if [ -z "${LUME_LAUNCHER:-}" ]; then
	RESERVE_KEYS=${XDG_RUNTIME_DIR:-/tmp}/retroarch-reserve.cfg
	printf 'input_menu_toggle_gamepad_combo = "4"\n' > "$RESERVE_KEYS"
	merge_fixed "$USER_CFG" "$RESERVE_KEYS"
fi

# keys of this run only
RUN_KEYS=${XDG_RUNTIME_DIR:-/tmp}/retroarch-run.cfg
: > "$RUN_KEYS"
SAVE=""
while :; do
	case "${1:-}" in
	--lume-set)
		k=${2%%=*}
		printf '%s = "%s"\n' "$k" "${2#*=}" >> "$RUN_KEYS"
		SAVE="$SAVE $k"
		shift 2 ;;
	--lume-keep)
		SAVE="$SAVE $2"
		shift 2 ;;
	*) break ;;
	esac
done
# keys of the core of this run (retroarch-core.keys): "<core> <key>=<value>" lines for
# the libretro file given with -L, added to the keys of this run; "*" lines count for every
# core (a game run: the RetroArch menu without a game has no -L and keeps the user's values)
CORE=""
prev=""
for a in "$@"; do
	[ "$prev" = -L ] && CORE=${a##*/} && CORE=${CORE%_libretro.so}
	prev=$a
done
# the factory options of this core not yet applied on this card (D3); nothing to do (no
# process at all) for a core without factory options
if [ -n "$CORE" ] && [ -d "$FACTORY/config" ]; then
	core_name "$CORE"
	if [ -n "$CORE_NAME" ] && [ -f "$FACTORY/config/$CORE_NAME/$CORE_NAME.opt" ]; then
		seed_defaults "opt:$CORE_NAME" "$HOME/.config/retroarch/config/$CORE_NAME/$CORE_NAME.opt" \
			"$FACTORY/config/$CORE_NAME/$CORE_NAME.opt"
	fi
fi
if [ -n "$CORE" ] && [ -f "$SHARE/retroarch-core.keys" ]; then
	# One awk for the whole file. The first field says who the line is for; the lines are
	# written in the order of their priority, the last one wins in merge_fixed:
	#   "*" < "<core>" < "<board>:*" < "<board>:<core>"
	# A line of another console (or of an unknown one) is ignored. awk prints the key names
	# (once each) for SAVE.
	SAVE="$SAVE $(awk -v core="$CORE" -v board="$BOARD" -v out="$RUN_KEYS" '
		$1 == "" || $1 ~ /^#/ { next }
		{
			t = -1
			if ($1 == "*") t = 0
			else if ($1 == core) t = 1
			else if (board != "" && $1 == board ":*") t = 2
			else if (board != "" && $1 == board ":" core) t = 3
			if (t < 0) next
			kv = $2; p = index(kv, "=")
			if (p < 2) next
			k = substr(kv, 1, p - 1)
			if (k !~ /^[A-Za-z0-9_]+$/) next
			n[t]++; line[t, n[t]] = k " = \"" substr(kv, p + 1) "\""; name[t, n[t]] = k
		}
		END {
			for (t = 0; t <= 3; t++)
				for (i = 1; i <= n[t]; i++) {
					print line[t, i] >> out
					if (!(name[t, i] in seen)) { seen[name[t, i]] = 1; print name[t, i] }
				}
		}
	' "$SHARE/retroarch-core.keys")"
fi
if [ -z "$SAVE" ]; then
	exec retroarch \
		--config "$USER_CFG" \
		--verbose "$@"
fi
# the user's values first, on the card, so a cut run still gives them back
mkdir -p "${RESTORE%/*}"
for k in $SAVE; do
	line=$(grep -E "^$k[[:space:]]*=" "$USER_CFG" | tail -n 1)
	if [ -n "$line" ]; then echo "$line"; else echo "#unset $k"; fi
done > "$RESTORE.tmp" && sync "$RESTORE.tmp" 2>/dev/null; mv -f "$RESTORE.tmp" "$RESTORE"
[ -s "$RUN_KEYS" ] && merge_fixed "$USER_CFG" "$RUN_KEYS"
retroarch \
	--config "$USER_CFG" \
	--verbose "$@"
rc=$?
restore_user_keys
exit $rc

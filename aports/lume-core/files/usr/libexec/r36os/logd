#!/bin/sh
# r36os-logd (D14): logs de diagnóstico em ROMS/logs/.
#
#   logd start  contador de boot, desligamento anterior (limpo ou abrupto), logs.conf
#               com os padrões e eventos do boot (ROMS, kernel)
#   logd run    laço: retrato do hardware (uma vez), métricas a cada interval s e
#               descarga em lote a cada flush s
#   logd flush  descarga imediata (usada pelo self-test e pela sessão)
#   logd stop   descarga final e marcador de desligamento limpo
. "${LOGD_LIBDIR:-/usr/libexec/r36os}/lib.sh"
. "${LOGD_LIBDIR:-/usr/libexec/r36os}/logs.sh"

CLEAN_MARK=$LOGS_DIR/.clean
COUNTER=$LOGS_DIR/.boot

cmd_start() {
	local prev n
	mkdir -p "$LOGS_RAM"
	n=0
	if logs_on_disk; then
		mkdir -p "$LOGS_DIR/boot" "$LOGS_DIR/hw" "$LOGS_DIR/metrics" "$LOGS_DIR/trace" "$LOGS_DIR/frontend"
		if [ ! -f "$LOGS_CONF" ]; then
			mkdir -p "$(dirname "$LOGS_CONF")"
			printf '%s\n' "$LOGS_CONF_DEFAULT" > "$LOGS_CONF"
		fi
		prev=$(tr -cd '0-9' < "$COUNTER" 2>/dev/null)
		n=$(( ${prev:-0} + 1 ))
		echo "$n" > "$COUNTER.tmp" && fsync "$COUNTER.tmp" 2>/dev/null && mv -f "$COUNTER.tmp" "$COUNTER"
		echo "$n" > "$LOGS_RAM/boot-n"
		if [ -n "$prev" ]; then
			if [ -f "$CLEAN_MARK" ]; then
				event shutdown OK "previous clean (boot $prev)"
			else
				event shutdown FAIL "previous abrupt (boot $prev): power loss or crash"
			fi
		fi
		rm -f "$CLEAN_MARK"
	else
		echo 0 > "$LOGS_RAM/boot-n"
		event logs FAIL "no ROMS: logs in RAM only for this boot"
	fi
	logs_conf
	event boot OK "started: $(board) kernel $(uname -r) boot_id=$(cat /proc/sys/kernel/random/boot_id)"

	# ROMS (mensagens do initramfs no dmesg)
	dmesg | sed -n 's/.*lume: \(ROMS partition created.*\)/\1/p' | while read -r l; do event roms OK "$l"; done
	dmesg | sed -n 's/.*lume: ROMS checked: \(.*\)/\1/p' | while read -r l; do event roms OK "checked: $l"; done
	dmesg | sed -n 's/.*lume: \(ERROR.*\)/\1/p' | while read -r l; do event boot FAIL "$l"; done
	# Device tree choice (lume-bootsel in the initramfs; "before kexec:" once per kexec, so
	# twice after a revert): the choice, the confirmation on the screen or the revert
	dmesg | sed -En 's/.*lume-bootsel: (before kexec: )*(selected .*|fallback: .*|ERROR.*|confirmed on screen: .*|not confirmed .*)/\2/p' |
		while read -r l; do
			case "$l" in
			selected*|"confirmed on screen"*) event boot OK "device tree $l" ;;
			*) event boot FAIL "device tree $l" ;;
			esac
		done
	# Erros do kernel neste boot (nível err ou pior): contagem e os 3 primeiros
	local errs
	errs=$(dmesg -l err,crit,alert,emerg 2>/dev/null)
	if [ -n "$errs" ]; then
		event kernel FAIL "$(echo "$errs" | wc -l) error message(s); first: $(echo "$errs" | head -n 3 | sed 's/^\[[^]]*\] *//' | tr '\n' '|')"
	else
		event kernel OK "no error messages"
	fi
	logs_flush
}

# Cost budget (game-governor D8, P-60): the sample every LOG_INTERVAL seconds starts no
# process of its own. Files are read with the shell's read, numbers worked out with shell
# arithmetic, the time comes from log_clock (logs.sh), the pid of a process is kept between
# samples (proc_pid) and the kernel messages come from a reader of /dev/kmsg started once
# (kmsg_start). What remains: one pidof when a watched process changed or retroarch is
# looked for and absent outside the launcher, the GET_STATUS query (nc) while RetroArch runs,
# one stat when the frontend log changed, and the batch work of logs_flush.
# PROC_ROOT and SYS_ROOT are overridden by the tests.
PROC_ROOT=${PROC_ROOT:-/proc}
SYS_ROOT=${SYS_ROOT:-/sys}
NL='
'
SAMPLE_N=0

# Variable CSV columns, found once per boot. Each thermal zone keeps its type (ZT_<i>) and
# its first passive trip in °C (ZP_<i>) for the temperature event.
ZONES="" POLICIES="" CPUS="" BAT=""
discover() {
	local z p c ps i=0 l
	ZONES="" POLICIES="" CPUS="" BAT=""
	for z in "$SYS_ROOT"/class/thermal/thermal_zone*; do
		[ -r "$z/temp" ] || continue
		ZONES="$ZONES $z"
		i=$((i + 1))
		_rd "$z/type"
		eval "ZT_$i=\$V ZP_$i=\$(passive_trip \"\$z\")"
	done
	for p in "$SYS_ROOT"/devices/system/cpu/cpufreq/policy*; do [ -r "$p/scaling_cur_freq" ] && POLICIES="$POLICIES $p"; done
	{
		while read -r c l; do
			case "$c" in cpu) continue ;; cpu[0-9]*) CPUS="$CPUS${c#cpu} " ;; *) break ;; esac
			unset "CP_T_${c#cpu}" "CP_I_${c#cpu}"
		done < "$PROC_ROOT/stat"
	} 2>/dev/null
	for ps in "$SYS_ROOT"/class/power_supply/*; do
		_rd "$ps/type"
		[ "$V" = Battery ] && { BAT=$ps; break; }
	done
	{
		printf 'time,uptime_s'
		for z in $ZONES; do printf ',temp_%s_c' "$(cat "$z/type" 2>/dev/null | tr -c 'a-zA-Z0-9_\n' '_')"; done
		for p in $POLICIES; do printf ',freq_%s_mhz' "${p##*/}"; done
		for c in $CPUS; do printf ',cpu%s_pct' "$c"; done
		printf ',mem_avail_mb,swap_used_mb,bat_pct,bat_mv,bat_ma,bat_status,frontend,core,content,fps,fps_nominal'
		printf ',lume_ui_rss_kb,lume_ui_cpu_pct,lume_run_rss_kb,lume_run_cpu_pct,input_rss_kb,input_cpu_pct\n'
	} > "$LOGS_RAM/metrics.header"
}

# Primeiro trip passivo de cada zona (°C), para o evento de temperatura
passive_trip() {  # zona
	local t
	for t in "$1"/trip_point_*_type; do
		[ "$(cat "$t" 2>/dev/null)" = passive ] || continue
		echo $(( $(cat "${t%_type}_temp") / 1000 ))
		return
	done
}

# State of the lume-launcher (lume-launcher D10): lume-run writes ui, game:<runner> or off
# to its status file. Under the launcher no game name is ever logged: lume-run writes the
# game lines of events.log itself.
LUME_STATUS=${LUME_STATUS:-/run/user/1000/lume/status}
LUME=""
lume_active() { [ -f "$LUME_STATUS" ] && proc_pid lume-run; }

# PID of a process by name in PID (fails when it is not running). The pid of the previous
# sample is kept in PU_<name>_P and checked by /proc/<pid>/comm (a builtin read), so pidof,
# which walks all of /proc, runs only when the process changed (logd budget: 1% of a core).
proc_pid() {  # name
	local var=$1 comm=""
	while :; do
		case "$var" in *-*) var="${var%%-*}_${var#*-}" ;; *) break ;; esac
	done
	eval "PID=\${PU_${var}_P:-}"
	[ -n "$PID" ] && { read -r comm < "/proc/$PID/comm"; } 2>/dev/null
	if [ -z "$PID" ] || [ "$comm" != "$1" ]; then
		PID=$(pidof "$1" 2>/dev/null)
		PID=${PID%% *}
	fi
	eval "PU_${var}_P=\$PID"
	[ -n "$PID" ]
}

# PID of retroarch in RA_PID (fails when it is not running), looked up once per sample:
# sample() sets RA_CACHE and clears RA_FRESH, the first lookup sets RA_FRESH and the next
# ones in the same sample reuse it. A call outside a sample (the tests call frontend_state
# and trace_sample alone) always looks again.
RA_PID="" RA_FRESH="" RA_CACHE=""
ra_pid() {
	if [ -z "$RA_CACHE" ] || [ -z "$RA_FRESH" ]; then
		RA_PID=""
		proc_pid retroarch && RA_PID=$PID
		RA_FRESH=1
	fi
	[ -n "$RA_PID" ]
}

# Frontend state through the local network command (GET_STATUS)
FE_STATE="" FE_CORE="" FE_CONTENT="" FE_FRAMES=""
frontend_state() {
	local r st rest s
	FE_CORE="" FE_CONTENT="" FE_FRAMES="" LUME=""
	lume_active && LUME=1
	# the launcher on screen (the most common state): no RetroArch to look for
	if [ -n "$LUME" ]; then
		{ read -r s < "$LUME_STATUS"; } 2>/dev/null
		case "$s" in game:*) ;; *) FE_STATE=launcher; return ;; esac
	fi
	if ! ra_pid; then
		if [ -n "$LUME" ]; then
			case "$s" in
			game:*) FE_STATE=game FE_CORE=${s#game:} ;;
			*) FE_STATE=launcher ;;
			esac
			return
		fi
		# another frontend installed in /usr/libexec/r36os/frontends/, or none
		if pgrep -f /usr/libexec/r36os/frontends/ >/dev/null 2>&1; then
			FE_STATE=other
		else
			FE_STATE=stopped
		fi
		return
	fi
	r=$(printf GET_STATUS | nc -u -w1 127.0.0.1 55355 2>/dev/null)
	set -- $r
	st=${2:-}
	case "$st" in
	PLAYING|PAUSED)
		FE_STATE=game
		[ "$st" = PAUSED ] && FE_STATE=paused
		rest=${r#GET_STATUS $st }
		FE_CORE=${rest%%,*}
		rest=${rest#*,}
		FE_CONTENT=${rest%,crc32=*}
		# video frame counter (aports/retroarch patch 0004); absent on older builds
		case "$r" in *,frames=*)
			FE_FRAMES=${r##*,frames=}
			FE_FRAMES=${FE_FRAMES%%[!0-9]*} ;;
		esac
		[ -n "$LUME" ] && FE_CONTENT=""
		;;
	CONTENTLESS) FE_STATE=menu ;;
	*) FE_STATE=no_answer ;;
	esac
}

# A CSV value in CSV: commas and line breaks become ";" (shell expansions, no process)
csv_field() { CSV=${1//,/;}; CSV=${CSV//"$NL"/;}; }

# Resident memory (KiB) and CPU (% of one core since the previous sample) of a process by
# name, as "rss,cpu" in PU_OUT; "," when it is not running (lume-launcher 6.4: lume-ui,
# lume-run, r36os-input). /proc ticks are USER_HZ (100), so ticks per second is the
# percentage. Not called in $(...): the previous sample lives in shell variables.
# Shell builtins only (the logd cost budget is 1% of a core): the pid is kept between
# samples and pidof runs only when that pid no longer has the name.
PU_OUT=""
# uptime ("123.4" or "123.45") in centiseconds, in CS, with shell arithmetic only
uptime_cs() {
	local i=${1%%.*} f=""
	case "$1" in *.*) f=${1#*.} ;; esac
	f=${f}00
	f=${f%"${f#??}"}
	# "1$f - 100": a leading zero would make "08" an invalid octal number
	CS=$(( i * 100 + 1$f - 100 ))
}
proc_usage() {  # name uptime
	local name=$1 up=$2 pid old stat ticks rss="" k v x var prev_t prev_u pct=""
	var=$name
	while :; do
		case "$var" in *-*) var="${var%%-*}_${var#*-}" ;; *) break ;; esac
	done
	eval "old=\${PU_${var}_P:-}"
	proc_pid "$name"
	pid=$PID
	if [ -z "$pid" ] || ! { read -r stat < "/proc/$pid/stat"; } 2>/dev/null; then
		eval "PU_${var}_P='' PU_${var}_T='' PU_${var}_U=''"
		PU_OUT=","
		return 0
	fi
	# a new process (lume-ui comes back after each game): no CPU until its second sample
	[ "$pid" = "$old" ] || eval "PU_${var}_T='' PU_${var}_U=''"
	# fields after "(comm) ": utime and stime are the 12th and 13th
	set -- ${stat##*) }
	ticks=$(( ${12} + ${13} ))
	{
		while read -r k v x; do
			[ "$k" = VmRSS: ] && { rss=$v; break; }
		done < "/proc/$pid/status"
	} 2>/dev/null
	uptime_cs "$up"
	eval "prev_t=\${PU_${var}_T:-} prev_u=\${PU_${var}_U:-}"
	if [ -n "$prev_t" ] && [ "$ticks" -ge "$prev_t" ] && [ "$CS" -gt "$prev_u" ]; then
		# tenths of a percent: ticks are centiseconds of CPU
		x=$(( (ticks - prev_t) * 1000 / (CS - prev_u) ))
		pct="$((x / 10)).$((x % 10))"
	fi
	eval "PU_${var}_P=$pid PU_${var}_T=$ticks PU_${var}_U=$CS"
	PU_OUT="$rss,$pct"
}

# Frontend trace (trace/boot-<n>.log): one line per sample with the RetroArch process
# state, the new kernel messages and, when it stops answering, a detailed snapshot. It
# tells WHERE a freeze happened. It also detects a hung frontend (blocked, no CPU and no
# display vblank) and recovers from it by killing it, so the session restarts it.
NOANS=0 DEEP_N=0 PREV_STATE="" PREV_PID="" PREV_TICKS="" PREV_VB="" HANG=0 RECOVER_N=0
DEEP_MAX=6          # detailed snapshots per boot
NOANS_LIMIT=3       # consecutive samples without an answer (15 s) before declaring it
HANG_LIMIT=2        # consecutive samples blocked with no CPU and no vblank (10 s)
RECOVER_MAX=${RECOVER_MAX:-3}   # times per boot the hung frontend is killed (0 = only log)
KICK_MAX=${KICK_MAX:-5}         # times per boot the TCON vblank interrupt is re-enabled
KICK_N=0 KICK_WROTE="" SNAPPED=""
# PID whose vblank interrupt was re-enabled. Its display runs again, so a moving vblank no
# longer proves it lives: if it stays blocked with no CPU it is hung all the same (the GA36
# image 214119 showed it: the vblank came back, RetroArch never woke up and was never killed).
KICKED_PID=""
FRONTEND_LOG_FILE=${FRONTEND_LOG:-/var/log/frontend.log}
INTERRUPTS_FILE=${INTERRUPTS_FILE:-/proc/interrupts}
DEVMEM_BIN=${DEVMEM_BIN:-r36os-devmem}   # reads/writes one 32-bit register (GA36 only)
# TCON_GINT0 (offset 4): VBLANK_ENABLE(0) bit 31, VBLANK_ENABLE(1) bit 30, TCON0_TRI_FINISH_ENABLE
# bit 27. A healthy console shows 0xc8000200 there; a frozen one showed 0x00000a00 (all three
# masked, a TRI_FINISH flag pending) while RetroArch waited for a page flip.
TCON_VBLANK_MASK=0xC8000000

# Sum of the display controller interrupts (the vblank counter) in VB; empty when there is
# no such device (the VM). A frozen display stops this counter. vblank_count prints it.
# With the real /proc/interrupts the counts come from /sys/kernel/irq/<n>/per_cpu_count of
# the display controller interrupts, found once (VB_FILES): a few bytes per sample instead of
# the whole table, which the shell reads byte by byte. Without that directory (or with a fake
# table in the tests) the table is read as before.
IRQ_SYS=${IRQ_SYS:-/sys/kernel/irq}
VB_FILES=unknown VB=""
vblank_scan() {
	local f a l n found=""
	VB=""
	if [ "$INTERRUPTS_FILE" = /proc/interrupts ] && [ "$VB_FILES" = unknown ]; then
		VB_FILES=""
		for f in "$IRQ_SYS"/*/actions; do
			[ -r "$f" ] || continue
			VB_FILES=${VB_FILES:- }
			a=""
			{ read -r a < "$f"; } 2>/dev/null
			case "$a" in *lcd-controller*|*tcon*) VB_FILES="$VB_FILES ${f%/actions}/per_cpu_count" ;; esac
		done
	fi
	if [ "$INTERRUPTS_FILE" = /proc/interrupts ] && [ -n "$VB_FILES" ] && [ "$VB_FILES" != unknown ]; then
		# " " alone: the directory exists and no display controller is in it
		for f in $VB_FILES; do
			l=""
			{ read -r l < "$f"; } 2>/dev/null
			found=1
			VB=${VB:-0}
			# "2842,7": one count per CPU
			while [ -n "$l" ]; do
				n=${l%%,*}
				case "$l" in *,*) l=${l#*,} ;; *) l="" ;; esac
				case "$n" in ''|*[!0-9]*) continue ;; esac
				VB=$((VB + n))
			done
		done
		return 0
	fi
	{
		while IFS= read -r l; do
			case "$l" in *lcd-controller*|*tcon*) ;; *) continue ;; esac
			found=1
			set -- $l
			shift
			for n in "$@"; do
				case "$n" in ''|*[!0-9]*) break ;; esac
				VB=$(( ${VB:-0} + n ))
			done
		done < "$INTERRUPTS_FILE"
	} 2>/dev/null
	[ -n "$found" ] && VB=${VB:-0}
	return 0
}
vblank_count() { vblank_scan; [ -n "$VB" ] && echo "$VB"; return 0; }

# Physical base of the display controller (TCON) from its name in /proc/interrupts, for
# example "1c0c000.lcd-controller" -> 0x1c0c000. Empty when there is none (the VM).
tcon_base() {
	awk '/lcd-controller/ { name = $NF; sub(/\..*/, "", name); print "0x" name; exit }' \
		"$INTERRUPTS_FILE" 2>/dev/null
}

# When the TCON has its vblank interrupts masked, a page flip waits forever (the flag is
# pending but nothing wakes RetroArch). Re-enabling the three bits lets the pending flag
# raise the interrupt and complete the flip. Returns 0 if the vblank counter moved again.
# Sets KICK_WROTE when it actually wrote the register.
tcon_kick() {
	local base reg cur new vb0 vb1 i
	KICK_WROTE=""
	command -v "$DEVMEM_BIN" >/dev/null 2>&1 || return 1
	base=$(tcon_base)
	[ -n "$base" ] || return 1
	reg=$(printf '0x%x' $((base + 4)))
	cur=$("$DEVMEM_BIN" "$reg" 2>/dev/null) || return 1
	if [ $((cur & TCON_VBLANK_MASK)) -ne 0 ]; then
		trace "tcon GINT0 $cur: vblank interrupts are enabled, nothing to re-enable"
		return 1
	fi
	new=$(printf '0x%08x' $((cur | TCON_VBLANK_MASK)))
	vb0=$(vblank_count)
	"$DEVMEM_BIN" "$reg" "$new" >/dev/null 2>&1 || return 1
	KICK_WROTE=1
	trace "tcon GINT0 $cur masked: wrote $new to $reg"
	i=0
	while [ $i -lt 3 ]; do
		sleep 1
		vb1=$(vblank_count)
		if [ "$vb1" != "$vb0" ]; then
			trace "tcon vblank moving again ($vb0 -> $vb1)"
			return 0
		fi
		i=$((i + 1))
	done
	trace "tcon vblank still stalled 3 s after re-enabling it"
	return 1
}

# New kernel messages since logd run started (what came before is in the boot log), one
# "k [    12.345678] text" trace line each, as dmesg prints them. A reader of /dev/kmsg runs
# beside the sampler for the whole boot (game-governor D8: no dmesg per sample): cat copies
# the records into a FIFO and kmsg_reader, a subshell of logd, turns each new one into a
# line as it arrives. cat ends when the kernel overwrote records it had not read yet (EPIPE);
# kmsg_check starts it again after each sample, and the sequence numbers drop the records
# already traced.
KMSG_DEV=${KMSG_DEV:-/dev/kmsg}
KMSG_RD="" KMSG_CAT=""
# kmsg_reader <first usec>: records "prio,seq,usec,flags;text" on stdin -> trace lines
kmsg_reader() {
	local min=${1:-0} last=-1 l head seq us s f
	while IFS= read -r l; do
		case "$l" in ""|" "*) continue ;; esac   # continuation lines (KEY=value)
		head=${l%%;*}
		seq=${head#*,}
		us=${seq#*,}
		seq=${seq%%,*}
		us=${us%%,*}
		case "$seq$us" in ''|*[!0-9]*) continue ;; esac
		[ "$seq" -gt "$last" ] || continue
		last=$seq
		[ "$us" -ge "$min" ] || continue
		s=$((us / 1000000))
		f=00000$((us % 1000000))
		f=${f#"${f%??????}"}
		while [ ${#s} -lt 5 ]; do s=" $s"; done
		trace "k [$s.$f] ${l#*;}"
	done
}
kmsg_start() {
	local up=""
	[ -r "$KMSG_DEV" ] || return 0
	{ read -r up _ < "$PROC_ROOT/uptime"; } 2>/dev/null
	uptime_cs "${up:-0}"
	rm -f "$LOGS_RAM/kmsg.fifo"
	mkfifo "$LOGS_RAM/kmsg.fifo" 2>/dev/null || return 0
	# read-write: the FIFO keeps a writer (itself), so a cat that ends is no end of input
	( trap - TERM INT; kmsg_reader $((CS * 10000)) ) <> "$LOGS_RAM/kmsg.fifo" &
	KMSG_RD=$!
	kmsg_check
}
kmsg_check() {
	local st=""
	[ -n "$KMSG_RD" ] || return 0
	if [ -n "$KMSG_CAT" ]; then
		{ read -r st < "/proc/$KMSG_CAT/stat"; } 2>/dev/null
		st=${st##*) }
		case "${st%% *}" in ''|Z) wait "$KMSG_CAT" 2>/dev/null ;; *) return 0 ;; esac
	fi
	cat "$KMSG_DEV" > "$LOGS_RAM/kmsg.fifo" 2>/dev/null &
	KMSG_CAT=$!
}
kmsg_stop() {
	[ -n "$KMSG_CAT" ] && kill "$KMSG_CAT" 2>/dev/null
	[ -n "$KMSG_RD" ] && kill "$KMSG_RD" 2>/dev/null
	[ -n "$KMSG_CAT$KMSG_RD" ] && wait $KMSG_CAT $KMSG_RD 2>/dev/null
	rm -f "$LOGS_RAM/kmsg.fifo"
	KMSG_CAT="" KMSG_RD=""
	return 0
}

# State of the display pipeline: connector and backlight sysfs, the DRM atomic state and
# clients (who is master) from debugfs, the display controller / DSI registers and clocks.
# Tells whether the CRTC is still active and the controller still enabled when it freezes.
trace_display() {
	local f
	mountpoint -q /sys/kernel/debug 2>/dev/null || mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
	for f in /sys/class/drm/card*-*/status /sys/class/drm/card*-*/enabled /sys/class/drm/card*-*/dpms \
		/sys/class/backlight/*/brightness /sys/class/backlight/*/bl_power; do
		[ -r "$f" ] && echo "sysfs $f $(cat "$f" 2>/dev/null)"
	done
	for f in /sys/kernel/debug/dri/*/state /sys/kernel/debug/dri/*/clients; do
		[ -r "$f" ] || continue
		echo "debugfs $f"
		head -n 60 "$f" | sed 's/^/  /'
	done
	echo "regmaps: $(ls /sys/kernel/debug/regmap 2>/dev/null | tr '\n' ' ')"
	for f in /sys/kernel/debug/regmap/*lcd-controller*/registers /sys/kernel/debug/regmap/*tcon*/registers \
		/sys/kernel/debug/regmap/*dsi*/registers /sys/kernel/debug/regmap/*display-backend*/registers \
		/sys/kernel/debug/regmap/*display-frontend*/registers; do
		[ -r "$f" ] || continue
		echo "regs $f"
		head -n 80 "$f" | sed 's/^/  /'
	done
	grep -E 'tcon|dsi|mipi|pll-video|pll-mipi|gpu|mbus|pll-audio|i2s|codec|dma' /sys/kernel/debug/clk/clk_summary 2>/dev/null |
		head -n 60 | sed 's/^/clk /'
	# audio path (task 9.8): DAI and codec registers, to see whether the DAC FIFO and its
	# DMA request are enabled while the DMA controller shows no interrupt
	for f in /sys/kernel/debug/regmap/*dai*/registers /sys/kernel/debug/regmap/*codec*/registers; do
		[ -r "$f" ] || continue
		echo "regs $f"
		head -n 40 "$f" | sed 's/^/  /'
	done
}

# Detailed process snapshot (threads, kernel stack, device descriptors, interrupts, display
# state): shows where RetroArch is stuck. Prints the lines; trace_snapshot stores them.
trace_deep() {  # pid
	local pid="$1" t f r
	echo "=== snapshot of retroarch pid $pid (frontend $FE_STATE)"
	grep -E '^(State|Threads|VmRSS|VmSwap|voluntary_ctxt_switches|nonvoluntary_ctxt_switches)' \
		"/proc/$pid/status" 2>/dev/null | sed 's/^/status /'
	for t in /proc/$pid/task/*; do
		[ -d "$t" ] || continue
		echo "thread ${t##*/} $(cat "$t/comm" 2>/dev/null) state=$(sed 's/^.*) //; s/ .*//' "$t/stat" 2>/dev/null) wchan=$(cat "$t/wchan" 2>/dev/null)"
		head -n 12 "$t/stack" 2>/dev/null | sed "s/^/  stack ${t##*/} /"
	done
	for f in /proc/$pid/fd/*; do
		r=$(readlink "$f" 2>/dev/null)
		case "$r" in /dev/*) echo "fd ${f##*/} $r" ;; esac
	done
	echo "loadavg $(cat /proc/loadavg 2>/dev/null)"
	# Playback streams: RetroArch waits in poll() with no timeout for room in the ALSA
	# buffer, so a stream whose hw_ptr does not move (no DMA interrupt) also freezes it.
	for f in /proc/asound/card*/pcm*p/sub*/status /proc/asound/card*/pcm*p/sub*/hw_params; do
		[ -r "$f" ] || continue
		sed "s|^|alsa ${f#/proc/asound/} |" "$f" 2>/dev/null
	done
	sed 's/^/irq /' "$INTERRUPTS_FILE"
	trace_display
	echo "=== end of snapshot"
}

# Stores a snapshot in trace.pending in one go: the lines are built in a RAM file with few
# processes and stamped once (one trace() call per line took 11 s on the A33, which is
# too long when a frozen console may be switched off any second).
trace_snapshot() {  # pid
	local tmp="$LOGS_RAM/snapshot.tmp"
	[ "$(_size "$LOGS_RAM/trace.pending")" -lt "$TRACE_MAX_BYTES" ] || return 0
	mkdir -p "$LOGS_RAM"
	trace_deep "$1" > "$tmp" 2>/dev/null
	log_clock
	sed "s/^/$LOG_HMS /" "$tmp" >> "$LOGS_RAM/trace.pending"
	rm -f "$tmp"
	TRACE_BYTES=""   # measured again by the next trace
}

# Audio stalls reported by RetroArch (patch 0003: the ALSA write waits at most 500 ms and
# then drops audio). Only the part of the frontend log not read yet is scanned
# (AUDIO_LOG_POS, in bytes); a log that shrank (a new frontend run) is read from the start.
# Each new "stalled" or "consuming again" line becomes one event.
AUDIO_LOG_POS=0
audio_watch() {
	local size new
	size=$(_size "$FRONTEND_LOG_FILE")
	[ "$size" -ge "$AUDIO_LOG_POS" ] || AUDIO_LOG_POS=0
	[ "$size" -gt "$AUDIO_LOG_POS" ] || return 0
	new=$(tail -c +$((AUDIO_LOG_POS + 1)) "$FRONTEND_LOG_FILE" 2>/dev/null |
		grep -oE '\[ALSA\] Playback (stalled|consuming again)')
	AUDIO_LOG_POS=$size
	[ -n "$new" ] || return 0
	printf '%s\n' "$new" | while IFS= read -r l; do
		case "$l" in
			*stalled) event audio FAIL "playback stalled: the sound device stopped consuming, the game keeps running without sound; see frontend/boot-$(boot_n).log" ;;
			*again) event audio OK "playback consuming again, sound resumed" ;;
		esac
	done
	return 0
}

# First playback stream as state/rate/uptime/hw_ptr ("-" when none is open). Two samples
# give the rate the hardware really consumes: (hw_ptr2 - hw_ptr1) / (uptime2 - uptime1).
# The uptime is read right before hw_ptr (the ALSA tstamp stays 0 unless the application
# enables timestamps, which RetroArch does not).
# pcm_scan sets PCM (shell reads only, game-governor D8); pcm_pos prints it.
# _kv <file> <key>: the value of the first "<key> : value" line in KV, without the spaces
# around the colon ("" when absent)
_kv() {  # file key
	local l k
	KV=""
	{
		while IFS= read -r l; do
			case "$l" in "$2"*:*) ;; *) continue ;; esac
			k=${l%%:*}
			k=${k%"${k##*[! ]}"}         # trailing spaces of the key
			[ "$k" = "$2" ] || continue
			l=${l#*:}
			KV=${l#"${l%%[! ]*}"}         # leading spaces of the value
			break
		done < "$1"
	} 2>/dev/null
	return 0
}
pcm_scan() {
	local f p st rate up ptr l k
	PCM=-
	for f in "${ASOUND_DIR:-/proc/asound}"/card*/pcm*p/sub*/status; do
		[ -r "$f" ] || continue
		p=${f%/status}
		_kv "$f" state; st=$KV
		[ -n "$st" ] || continue
		_kv "$p/hw_params" rate; rate=${KV%%[!0-9]*}
		up=""
		{ read -r up _ < "${UPTIME_FILE:-/proc/uptime}"; } 2>/dev/null
		_kv "$f" hw_ptr; ptr=$KV
		PCM="$st/$rate/$up/$ptr"
		return 0
	done
	return 0
}
pcm_pos() { pcm_scan; echo "$PCM"; }

# OTG port (usb-device-access D1): what the kernel sees of the port, to learn how each
# console tells a PC, a charger and an OTG adapter apart. Fields, each only when present:
#   extcon=<name>:USB=<0|1>,USB-HOST=<0|1>  the PHY: USB is VBUS seen by the PHY, USB-HOST
#                                           is the ID pin pulled low (OTG adapter)
#   musb=<mode>          MUSB controller (GA36): b_idle, b_peripheral, a_host...
#   role=<name>:<role>   USB role switch: none, host or device
#   udc=<name>:<state>   gadget side: not attached, attached, configured...
#   vbus=<name>:<0|1>    online of each USB power supply (the charger input of the PMIC)
#   host_devs=<n>        USB devices behind the host ports (root hubs not counted)
# "none" when the console has none of them (the vm). SYS_ROOT is overridden by the tests.
SYS_ROOT=${SYS_ROOT:-/sys}
# usb_scan sets USB_S without a subshell (logd runs every few seconds: one fork less per
# sample, see the logs-cost check of test-vm); usb_state prints it
# (all reads are the shell's own read: no process per file)
usb_state() { usb_scan; echo "$USB_S"; }
_rd() { V=""; [ -r "$1" ] && read -r V < "$1" 2>/dev/null; return 0; }   # first line -> V

# Did <file> change since the last time this returned true for <mark>? The test builtin
# compares the modification times; a write in the same second as the mark counts as a change,
# so none is missed. On true the mark is touched (a shell redirection, no process).
file_changed() {  # file mark
	[ -e "$1" ] || return 1
	[ "$2" -nt "$1" ] && return 1
	: > "$2"
	return 0
}
usb_scan() {
	local f d l s out="" devs=0
	for f in "$SYS_ROOT"/class/extcon/*/state; do
		[ -r "$f" ] || continue
		s=""
		while IFS= read -r l; do s="$s,$l"; done < "$f"
		case "$s" in *USB*) ;; *) continue ;; esac
		d=${f%/state}
		_rd "$d/name"
		out="$out extcon=${V:-${d##*/}}:${s#,}"
	done
	for f in "$SYS_ROOT"/bus/platform/devices/musb-hdrc.*/mode; do
		[ -r "$f" ] && _rd "$f" && out="$out musb=$V"
	done
	for f in "$SYS_ROOT"/class/usb_role/*/role; do
		[ -r "$f" ] || continue
		d=${f%/role}
		_rd "$f"
		out="$out role=${d##*/}:$V"
	done
	for f in "$SYS_ROOT"/class/udc/*/state; do
		[ -r "$f" ] || continue
		d=${f%/state}
		_rd "$f"
		out="$out udc=${d##*/}:${V// /_}"
	done
	for d in "$SYS_ROOT"/class/power_supply/*; do
		_rd "$d/type"
		[ "$V" = USB ] || continue
		_rd "$d/online"
		out="$out vbus=${d##*/}:$V"
	done
	for d in "$SYS_ROOT"/bus/usb/devices/[0-9]*-*; do
		[ -e "$d" ] || continue
		case "${d##*/}" in *:*) continue ;; esac
		devs=$((devs + 1))
	done
	if [ -z "$out" ] && [ "$devs" = 0 ]; then
		USB_S=none
	else
		USB_S="${out# } host_devs=$devs"
	fi
	return 0
}

# One "usb:" trace line per sample, and a usb event when the state changes. The gadget
# (r36os-usb, D2) is "connected" while its UDC is configured by a PC.
USB_LAST=none USB_CONNECTED=0
usb_watch() {
	local s
	usb_scan
	s=$USB_S
	trace "usb: $s"
	[ "$s" = "$USB_LAST" ] && return 0
	USB_LAST=$s
	event usb OK "otg: $s"
	case " $s " in
	*" udc="*":configured "*)
		[ "$USB_CONNECTED" = 1 ] || { USB_CONNECTED=1; event usb OK "device: connected"; } ;;
	*)
		[ "$USB_CONNECTED" = 0 ] || { USB_CONNECTED=0; event usb OK "device: disconnected"; } ;;
	esac
	return 0
}

# One line per sample + detection of "RetroArch alive but not answering" and of a hang
trace_sample() {
	local pid="" line t th="" dri=0 f d gpu="" vb st utime stime threads ticks s w size
	# The frontend log only when it changed since the last look (one stat then): scan before
	# trimming; after a trim everything kept was already read
	[ -d "$LOGS_RAM" ] || mkdir -p "$LOGS_RAM"
	if file_changed "$FRONTEND_LOG_FILE" "$LOGS_RAM/audio.mark"; then
		audio_watch
		if [ "$AUDIO_LOG_POS" -gt "$FRONTEND_RAM_MAX_BYTES" ]; then
			frontend_log_trim "$FRONTEND_LOG_FILE"
			AUDIO_LOG_POS=$(_size "$FRONTEND_LOG_FILE")
		fi
	fi
	vblank_scan
	vb=$VB
	# GPU clock in MHz (devfreq): shows whether it changed when a game started
	for f in "${GPU_DEVFREQ_DIR:-/sys/class/devfreq}"/*gpu*/cur_freq; do
		[ -r "$f" ] || continue
		_rd "$f"
		gpu=$(( ${V:-0} / 1000000 ))
		break
	done
	# the launcher on screen: lume-run says no game runs, so no retroarch to look for
	[ "$FE_STATE" = launcher ] || { ra_pid && pid=$RA_PID; }
	if [ -z "$pid" ]; then
		trace "fe=$FE_STATE pid=- gpu_mhz=$gpu vblank=$vb"
		NOANS=0 HANG=0 PREV_PID="" PREV_TICKS=""
	else
		s=""
		{ read -r s < "/proc/$pid/stat"; } 2>/dev/null
		[ -n "$s" ] && s=${s##*) }
		set -- $s
		st=${1:-?} utime=${12:-0} stime=${13:-0} threads=${18:-0}
		ticks=$((utime + stime))
		line="st=$st utime=$utime stime=$stime threads=$threads"
		for t in /proc/$pid/task/*; do
			[ -d "$t" ] || continue
			s="" w=""
			{ read -r s < "$t/stat"; } 2>/dev/null
			[ -n "$s" ] && { s=${s##*) }; s=${s%% *}; }
			# wchan has no line break: read fails but keeps the text
			{ read -r w < "$t/wchan"; } 2>/dev/null
			th="$th ${t##*/}:$s:$w"
		done
		# descriptors on a /dev/dri node: the test builtin compares device and inode
		for f in /proc/$pid/fd/*; do
			for d in "${DRI_DIR:-/dev/dri}"/*; do
				[ -c "$d" ] || continue
				[ "$f" -ef "$d" ] && { dri=$((dri + 1)); break; }
			done
		done
		pcm_scan
		trace "fe=$FE_STATE pid=$pid $line dri_fds=$dri gpu_mhz=$gpu vblank=$vb pcm=$PCM tasks=$th"
		# Hung = same process, (almost) no CPU used since the last sample and the display
		# vblank counter not moving. A frontend that is only loading a big game uses CPU.
		# After a kick only the CPU counts (see KICKED_PID).
		if [ "$pid" = "$PREV_PID" ] && [ -n "$PREV_TICKS" ] && [ "$ticks" -le $((PREV_TICKS + 2)) ] &&
			{ [ -z "$vb" ] || [ "$vb" = "$PREV_VB" ] || [ "$pid" = "$KICKED_PID" ]; }; then
			HANG=$((HANG + 1))
		else
			HANG=0
			# the kicked process used CPU again: it really woke up
			[ "$pid" = "$KICKED_PID" ] && [ -n "$PREV_TICKS" ] && KICKED_PID=""
		fi
		PREV_PID=$pid PREV_TICKS=$ticks PREV_VB=$vb
		[ "$HANG" -eq 0 ] && SNAPPED=""
		# First blocked sample on a console with a display controller: take the snapshot
		# (the evidence) and try to re-enable the masked vblank interrupt before giving
		# up on the process. It is harmless when the interrupt is not masked.
		if [ "$HANG" -eq 1 ] && [ -n "$vb" ]; then
			if [ "$DEEP_N" -lt "$DEEP_MAX" ]; then
				DEEP_N=$((DEEP_N + 1))
				trace_snapshot "$pid"
				SNAPPED=1
			fi
			if [ "$KICK_N" -lt "$KICK_MAX" ]; then
				if tcon_kick; then
					[ -n "$KICK_WROTE" ] && KICK_N=$((KICK_N + 1))
					event frontend OK "recovery: re-enabled the masked display vblank interrupt; the display runs again, watching retroarch pid $pid (kick $KICK_N of $KICK_MAX)"
					# keep PREV_TICKS: if the process does not use CPU in the next two
					# samples it is killed like any other hang
					HANG=0 KICKED_PID=$pid PREV_VB=$(vblank_count)
					logs_flush
				elif [ -n "$KICK_WROTE" ]; then
					KICK_N=$((KICK_N + 1))
				fi
			fi
		fi
		if [ "$HANG" -eq "$HANG_LIMIT" ]; then
			if [ "$pid" = "$KICKED_PID" ]; then
				event frontend FAIL "retroarch pid $pid hung: blocked with no CPU for $((HANG * LOG_INTERVAL))s although the display vblank runs again (state $FE_STATE); see trace/boot-$(boot_n).log"
			else
				event frontend FAIL "retroarch pid $pid hung: blocked with no CPU and no display vblank for $((HANG * LOG_INTERVAL))s (state $FE_STATE); see trace/boot-$(boot_n).log"
			fi
			if [ -z "$SNAPPED" ] && [ "$DEEP_N" -lt "$DEEP_MAX" ]; then
				DEEP_N=$((DEEP_N + 1))
				trace_snapshot "$pid"
			fi
			if [ "$RECOVER_N" -lt "$RECOVER_MAX" ]; then
				RECOVER_N=$((RECOVER_N + 1))
				logs_flush      # the evidence first, then the kill
				kill -9 "$pid" 2>/dev/null
				event frontend OK "recovery $RECOVER_N of $RECOVER_MAX: killed the hung retroarch pid $pid; the session restarts the frontend"
				PREV_PID=""
			fi
		fi
		if [ "$FE_STATE" = no_answer ]; then
			NOANS=$((NOANS + 1))
			if [ "$NOANS" -eq "$NOANS_LIMIT" ]; then
				event frontend FAIL "retroarch pid $pid alive but no answer for $((NOANS * LOG_INTERVAL))s; see trace/boot-$(boot_n).log"
			fi
			# Snapshot when the freeze is declared and then every 6 samples
			if [ "$NOANS" -ge "$NOANS_LIMIT" ] && [ $(( (NOANS - NOANS_LIMIT) % 6 )) -eq 0 ] && [ "$DEEP_N" -lt "$DEEP_MAX" ]; then
				DEEP_N=$((DEEP_N + 1))
				trace_snapshot "$pid"
			fi
		else
			[ "$NOANS" -ge "$NOANS_LIMIT" ] && event frontend OK "retroarch answering again after $((NOANS * LOG_INTERVAL))s"
			NOANS=0
		fi
	fi
	# Flush at once on every state change and while it is not answering: a frozen console
	# is usually switched off by hand, and the normal interval would lose the evidence.
	if [ "$FE_STATE" != "$PREV_STATE" ] || [ "$NOANS" -gt 0 ]; then
		logs_flush
	fi
	PREV_STATE=$FE_STATE
}

GAME_KEY="" GAME_CORE="" GAME_CONTENT="" GAME_T0=0
HOT_ZONES="" BAT_LOW=0
# Milli-units (a thermal zone temp) as "%.1f" of the value / 1000, rounded: 45678 -> 45.7
milli_tenths() {
	local t=${1:-0} x
	if [ "$t" -lt 0 ]; then
		x=$(( (50 - t) / 100 ))
		M1="-$((x / 10)).$((x % 10))"
	else
		x=$(( (t + 50) / 100 ))
		M1="$((x / 10)).$((x % 10))"
	fi
}

# Per-core load: the /proc/stat difference since the previous sample (CP_T_<n> total and
# CP_I_<n> idle + iowait jiffies, 0 before the first one), rounded to an integer percent.
# Appends ",<pct>" per core to CPU_COLS. The read stops at the first line that is not a cpu
# (the intr line that follows is long).
cpu_cols() {
	local k rest v tot idle n pt pi dt di x
	CPU_COLS=""
	{
		while read -r k rest; do
			case "$k" in cpu) continue ;; cpu[0-9]*) ;; *) break ;; esac
			set -- $rest
			tot=0
			for v in "$@"; do tot=$((tot + v)); done
			idle=$(( ${4:-0} + ${5:-0} ))
			n=${k#cpu}
			eval "pt=\${CP_T_$n:-0} pi=\${CP_I_$n:-0}"
			dt=$((tot - pt)) di=$((idle - pi))
			x=0
			if [ "$dt" -gt 0 ]; then
				x=$((100 * (dt - di)))
				if [ "$x" -ge 0 ]; then
					x=$(( (2 * x + dt) / (2 * dt) ))
				else
					x=$(( -((dt - 2 * x) / (2 * dt)) ))
				fi
			fi
			CPU_COLS="$CPU_COLS,$x"
			eval "CP_T_$n=$tot CP_I_$n=$idle"
		done < "$PROC_ROOT/stat"
	} 2>/dev/null
}

# MemAvailable and the swap in use, in MiB, as "<avail>,<swap>" in MEM_COLS
mem_cols() {
	local k v x a=0 st=0 sf=0
	{
		while read -r k v x; do
			case "$k" in
			MemAvailable:) a=$v ;;
			SwapTotal:) st=$v ;;
			SwapFree:) sf=$v; break ;;
			esac
		done < "$PROC_ROOT/meminfo"
	} 2>/dev/null
	MEM_COLS="$((a / 1024)),$(( (st - sf) / 1024 ))"
}

sample() {
	local up z t trip p line bpct bmv bma bst i=0 ty x
	SAMPLE_N=$((SAMPLE_N + 1))
	RA_FRESH="" RA_CACHE=1
	up=""
	{ read -r up _ < "$PROC_ROOT/uptime"; } 2>/dev/null
	log_clock "$up"
	line="$LOG_TS,$up"
	for z in $ZONES; do
		i=$((i + 1))
		t=""
		{ read -r t < "$z/temp"; } 2>/dev/null
		milli_tenths "$t"
		line="$line,$M1"
		eval "trip=\${ZP_$i:-} ty=\${ZT_$i:-}"
		if [ -n "$trip" ] && [ -n "$t" ]; then
			if [ $((t / 1000)) -ge "$trip" ]; then
				case " $HOT_ZONES " in *" $z "*) ;; *)
					HOT_ZONES="$HOT_ZONES $z"
					event temperature FAIL "$ty $((t / 1000)) °C, above passive trip of $trip °C" ;;
				esac
			elif [ $((t / 1000)) -le $((trip - 5)) ]; then
				case " $HOT_ZONES " in *" $z "*)
					x=""
					for p in $HOT_ZONES; do [ "$p" = "$z" ] || x="$x $p"; done
					HOT_ZONES=$x
					event temperature OK "$ty back to $((t / 1000)) °C" ;;
				esac
			fi
		fi
	done
	for p in $POLICIES; do _rd "$p/scaling_cur_freq"; line="$line,$(( ${V:-0} / 1000 ))"; done
	cpu_cols
	mem_cols
	line="$line$CPU_COLS,$MEM_COLS"
	bpct="" bmv="" bma="" bst=""
	if [ -n "$BAT" ]; then
		_rd "$BAT/capacity"; bpct=$V
		_rd "$BAT/voltage_now"; bmv=$(( ${V:-0} / 1000 ))
		_rd "$BAT/current_now"; bma=$(( ${V:-0} / 1000 ))
		_rd "$BAT/status"; bst=$V
		if [ -n "$bpct" ]; then
			if [ "$bpct" -lt 10 ] && [ $BAT_LOW = 0 ]; then
				BAT_LOW=1; event battery FAIL "below 10% ($bpct%, $bmv mV, $bst)"
			elif [ "$bpct" -gt 15 ]; then BAT_LOW=0; fi
		fi
	fi
	line="$line,$bpct,$bmv,$bma,$bst"
	frontend_state
	game_track "$up"
	csv_field "$FE_CORE"
	line="$line,$FE_STATE,$CSV"
	csv_field "$FE_CONTENT"
	line="$line,$CSV,$FPS,"
	[ -n "$GAME_KEY" ] && line="$line$GAME_NOMINAL"
	# the lume status says what runs: no lookup for lume-run without the launcher, nor for
	# lume-ui during a game (it exits while the game runs)
	for p in lume-ui lume-run r36os-input; do
		case "$p" in
		lume-ui) [ "$FE_STATE" = launcher ] || { line="$line,,"; continue; } ;;
		lume-run) [ -n "$LUME" ] || { line="$line,,"; continue; } ;;
		esac
		proc_usage "$p" "$up"
		line="$line,$PU_OUT"
	done
	echo "$line" >> "$LOGS_RAM/metrics.pending"
	trace_sample
	usb_watch
	RA_CACHE=""
}

# Nominal FPS of the running core: the last "Geometry: ... FPS: <n>," line of the frontend
# log, written by RetroArch when the core loads.
core_nominal_fps() {
	grep -o 'Geometry: .* FPS: [0-9.]*' "$FRONTEND_LOG_FILE" 2>/dev/null | tail -n 1 |
		sed 's/.*FPS: //'
}

# Game opened/closed (a pause in the menu is still the same game) and the game FPS:
# frame counter difference (GET_STATUS, patch 0004) over the uptime difference between two
# samples while the game runs. Two samples in a row below 95% of the nominal FPS give a
# "slow" event; the first sample back at full speed gives an OK event.
FPS="" FPS_PREV_FRAMES="" FPS_PREV_T="" GAME_NOMINAL="" SLOW_N=0 SLOW=0
FPS_SLOW_PCT=95
game_track() {  # uptime
	local up=$1 key="" a b x
	case "$FE_STATE" in game|paused) key="$FE_CORE|$FE_CONTENT" ;; esac
	if [ "$key" != "$GAME_KEY" ]; then
		# under the launcher, lume-run logs the start and the end (without names)
		if [ -n "$GAME_KEY" ] && [ -z "$LUME" ]; then
			event game OK "closed: core=$GAME_CORE content=$GAME_CONTENT duration=$(( ${up%.*} - GAME_T0 ))s"
		fi
		if [ -n "$key" ]; then
			GAME_CORE=$FE_CORE GAME_CONTENT=$FE_CONTENT GAME_T0=${up%.*}
			[ -z "$LUME" ] && event game OK "opened: core=$FE_CORE content=$FE_CONTENT"
		fi
		GAME_KEY=$key GAME_NOMINAL="" FPS_PREV_FRAMES="" SLOW_N=0 SLOW=0
	fi
	FPS=""
	# the nominal FPS is looked for in the frontend log only when the log changed since the
	# last look (a native game has no such line and would grep every sample)
	if [ -n "$GAME_KEY" ] && [ -z "$GAME_NOMINAL" ] && file_changed "$FRONTEND_LOG_FILE" "$LOGS_RAM/fps.mark"; then
		GAME_NOMINAL=$(core_nominal_fps)
	fi
	# only while the game runs: paused in the menu, the counter counts menu frames
	if [ "$FE_STATE" != game ] || [ -z "$FE_FRAMES" ]; then
		FPS_PREV_FRAMES=""
		return 0
	fi
	if [ -n "$FPS_PREV_FRAMES" ] && [ "$FE_FRAMES" -ge "$FPS_PREV_FRAMES" ]; then
		# tenths of a frame per second, rounded, over the uptime difference in centiseconds
		uptime_cs "$up"; a=$CS
		uptime_cs "$FPS_PREV_T"; b=$CS
		if [ "$a" -gt "$b" ]; then
			x=$(( ((FE_FRAMES - FPS_PREV_FRAMES) * 2000 + a - b) / (2 * (a - b)) ))
			FPS="$((x / 10)).$((x % 10))"
		fi
	fi
	FPS_PREV_FRAMES=$FE_FRAMES FPS_PREV_T=$up
	[ -n "$FPS" ] && [ -n "$GAME_NOMINAL" ] || return 0
	# fps * 100 < nominal * pct, both in hundredths
	uptime_cs "$FPS"; a=$CS
	uptime_cs "$GAME_NOMINAL"; b=$CS
	if [ $((a * 100)) -lt $((b * FPS_SLOW_PCT)) ]; then
		SLOW_N=$((SLOW_N + 1))
		if [ "$SLOW_N" -ge 2 ] && [ "$SLOW" = 0 ]; then
			SLOW=1
			event game FAIL "slow: core=$GAME_CORE $FPS fps (nominal $GAME_NOMINAL)${GAME_CONTENT:+ content=$GAME_CONTENT}"
		fi
	else
		SLOW_N=0
		if [ "$SLOW" = 1 ]; then
			SLOW=0
			event game OK "full speed again: core=$GAME_CORE $FPS fps (nominal $GAME_NOMINAL)"
		fi
	fi
}

# Waits for the frontend (up to 60 s): 0 when it started
wait_frontend() {
	local i=0
	while [ $i -lt "${FRONTEND_WAIT:-60}" ]; do
		dmesg | grep -q "lume: frontend started" && return 0
		sleep 1
		i=$((i + 1))
	done
	return 1
}

# The frontend is up (boot-dtb-select D6, D10). A device tree still pending here is one
# the screen could not confirm (no confirm key in the initramfs): it is confirmed now,
# good=<it> and no pending in ROMS/system/etc/dtb-<soc>[-<serial>].conf, keeping manual=
# and bad=. Every other pending one was confirmed or reverted on the screen, and one still
# pending at the next boot did not get here, so lume-bootsel discards it.
DTB_CONF_DIR=${DTB_CONF_DIR:-/storage/system/etc}
dtb_confirm() {
	local id soc name conf manual bad
	id=$(dtb_id)
	soc=$(dtb_soc)
	name=$(dtb_conf_name)
	[ -n "$id" ] && [ -n "$name" ] || return 0
	logs_on_disk || return 0
	conf=$DTB_CONF_DIR/$name
	grep -qx "pending=$id" "$conf" 2>/dev/null || return 0
	manual=$(sed -n 's/^manual=//p' "$conf" 2>/dev/null | tail -n 1)
	bad=$(sed -n 's/^bad=//p' "$conf" 2>/dev/null | tail -n 1)
	printf '# Lume Retro OS: device tree choice of the %s device %s (lume-bootsel, r36os-logd)\nmanual=%s\ngood=%s\npending=\nbad=%s\n' \
		"$soc" "$(dtb_serial)" "$manual" "$id" "$bad" > "$conf.tmp" || return 0
	fsync "$conf.tmp" 2>/dev/null
	mv -f "$conf.tmp" "$conf"
	event boot OK "device tree $id confirmed: the frontend started (no question on the screen)"
}

# Retrato do hardware deste boot (hw/boot-<n>.txt), depois que o frontend sobe
hw_snapshot() {
	local out="$LOGS_RAM/hw.txt" n
	n=$(boot_n)
	/usr/libexec/r36os/hwinfo > "$out" 2>&1
	if logs_on_disk; then atomic_copy "$out" "$LOGS_DIR/hw/boot-$n.txt"; fi
}

# The wait between samples without a sleep process: a read with a timeout on a FIFO that
# this process holds open for reading and writing, so nothing ever arrives on it. A trapped
# TERM ends the read at once. Falls back to sleep when the FIFO cannot be made.
TICK=""
tick_open() {
	rm -f "$LOGS_RAM/tick.fifo"
	mkfifo "$LOGS_RAM/tick.fifo" 2>/dev/null && exec 9<> "$LOGS_RAM/tick.fifo" && TICK=1
	return 0
}
tick_wait() {
	if [ -n "$TICK" ]; then
		read -r -t "$LOG_INTERVAL" _ <&9
	else
		sleep "$LOG_INTERVAL" &
		wait $!
	fi
	return 0
}

cmd_run() {
	logs_conf
	local last_flush=0 now
	trap 'kmsg_stop; logs_flush; exit 0' TERM INT
	mkdir -p "$LOGS_RAM"
	if [ "$LOG_ENABLE" = 1 ]; then
		discover
		kmsg_start
	fi
	# wait for the frontend (also to time it in the hardware snapshot), then confirm the
	# device tree; the snapshot is taken even when the frontend did not start
	if wait_frontend; then dtb_confirm; fi
	[ "$LOG_ENABLE" = 1 ] && hw_snapshot
	tick_open
	while :; do
		if [ "$LOG_ENABLE" = 1 ]; then
			sample
			kmsg_check
		fi
		now=""
		{ read -r now _ < "$PROC_ROOT/uptime"; } 2>/dev/null
		now=${now%%.*}
		if [ $((${now:-0} - last_flush)) -ge "$LOG_FLUSH" ]; then
			logs_flush
			last_flush=${now:-0}
		fi
		tick_wait
	done
}

cmd_stop() {
	event shutdown OK "clean"
	logs_flush
	logs_on_disk && { : > "$CLEAN_MARK"; fsync "$CLEAN_MARK" 2>/dev/null; sync; }
	return 0
}

[ -n "${LOGD_LIB:-}" ] && return 0   # testes: só as funções

case "$1" in
start) cmd_start ;;
run) cmd_run ;;
flush) logs_conf; logs_flush ;;
stop) cmd_stop ;;
*) echo "usage: $0 start|run|flush|stop" >&2; exit 2 ;;
esac

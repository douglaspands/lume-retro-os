#!/sbin/openrc-run
# Frontend session (D10): starts straight on tty1, with no login. The frontend is chosen in
# /etc/conf.d/frontend. The restart loop lives in r36os-session (no supervise-daemon).
# Nothing a game does not use is waited for: playlists, lume-index, NetworkManager and
# Bluetooth start after this service (build-speed D20).

description="Frontend session (${FRONTEND:-retroarch})"
command=/usr/libexec/r36os/session
command_background=yes
pidfile=/run/frontend.pid

depend() {
	need localmount r36os-persist
	use seatd alsa udev
	after udev-settle r36os-hwsummary r36os-savesync
}

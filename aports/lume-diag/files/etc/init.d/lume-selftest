#!/sbin/openrc-run
# Acceptance self-test of the VM: only acts with lume.selftest=1 on the kernel cmdline.
# Not after lume-playlists: that one starts after the frontend (build-speed D20), and the
# self-test generates the playlists itself once its test games are copied.

description="Acceptance self-test (VM)"

depend() {
	need localmount
	after lume-persist lume-savesync
	before frontend
}

start() {
	grep -qw "lume.selftest=1" /proc/cmdline || return 0
	ebegin "Self-test: mounting TESTDATA disk"
	local dev
	dev=$(findfs LABEL=TESTDATA 2>/dev/null)
	mkdir -p /run/lume/testdata
	if [ -z "$dev" ] || ! mount -t vfat -o rw,sync "$dev" /run/lume/testdata; then
		eend 1 "TESTDATA disk missing"
		return 1
	fi
	# Network commands (GET_STATUS, SAVE_STATE, QUIT): already on in retroarch-lume.cfg
	# (diagnostic logs); repeated here so the self-test does not depend on it
	# quit_press_twice off: the test quits with the QUIT command, which would otherwise
	# need two presses (the console default asks for confirmation to shut down)
	printf 'network_cmd_enable = "true"\nnetwork_cmd_port = "55355"\nquit_press_twice = "false"\n' > /run/lume/retroarch-extra.cfg
	chmod 644 /run/lume/retroarch-extra.cfg
	start-stop-daemon --start --background --make-pidfile --pidfile /run/lume-selftest.pid \
		--exec /usr/libexec/lume/selftest -- run
	# Failure forced once (test of the service events): the self-test runs anyway
	if [ -f /run/lume/testdata/fail-service ]; then
		rm -f /run/lume/testdata/fail-service
		sync
		eend 1 "failure forced by self-test"
		return 1
	fi
	eend $?
}

# Pacote local do Lume Retro OS: core PPSSPP (PSP) para o libretro.
# Release do upstream sem alterações, com os patches 000N-*.patch por cima.
pkgname=libretro-ppsspp
pkgver=1.18.1
pkgrel=1
pkgdesc="Sony PlayStation Portable core for libretro (PPSSPP)"
url="https://www.ppsspp.org/"
# Desativado (convenção do Alpine: arch vazio): o PSP está fora desta versão e fica como
# pendência (tasks.md, 12.1). Para reativar: arch="x86_64 aarch64 armv7".
arch=""
license="GPL-2.0-or-later"
# ffmpeg6: o PPSSPP 1.18 usa a API do FFmpeg 6 (decodificação de áudio e vídeo do PSP)
makedepends="cmake samurai linux-headers mesa-dev libzip-dev zlib-dev snappy-dev python3 ffmpeg6-dev"
source="ppsspp-$pkgver.tar.xz::https://github.com/hrydgard/ppsspp/releases/download/v$pkgver/ppsspp-$pkgver.tar.xz
	0001-ffmpeg-optional-components.patch
	0002-glslang-cstdint.patch
	"
builddir="$srcdir/ppsspp-$pkgver"
options="!check" # sem testes no alvo libretro

# Padrões do Alpine mais o -O2 do build Release do upstream (a otimização por CPU fica
# para uma change futura). Única exceção:
# no armv7, -marm, porque o JIT ARM do PPSSPP chama funções C com BL/BLX em modo ARM e o
# gcc do Alpine armv7 gera Thumb-2 por padrão (o Makefile libretro do upstream também usa
# -marm). O CMake do PPSSPP detecta o ARMv7 sozinho e acrescenta -mfpu=neon.
case "$CARCH" in
armv7) _cflags="-marm" ;;
esac

build() {
	CFLAGS="$CFLAGS $_cflags" \
	CXXFLAGS="$CXXFLAGS $_cflags" \
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DLIBRETRO=ON \
		-DUSING_GLES2=ON \
		-DUSE_FFMPEG=ON \
		-DUSE_SYSTEM_FFMPEG=ON \
		-DUSE_SYSTEM_LIBZIP=ON \
		-DUSE_SYSTEM_SNAPPY=ON \
		-DUSE_DISCORD=OFF \
		-DUSE_MINIUPNPC=OFF \
		-DUSE_WAYLAND_WSI=OFF \
		-DUSING_X11_VULKAN=OFF \
		-DENABLE_TESTS=OFF
	cmake --build build
}

package() {
	install -Dm644 build/lib/ppsspp_libretro.so "$pkgdir"/usr/lib/libretro/ppsspp_libretro.so
}


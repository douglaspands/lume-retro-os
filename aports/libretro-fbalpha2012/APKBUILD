# Lume Retro OS local package (not in Alpine).
# FB Alpha 2012 (v0.2.97.29), the full core with every board, from libretro/fbalpha2012: an
# alternative arcade core under measurement against fbneo on the GA36 (game-experience-tuning
# 10). Default upstream build (makefile.libretro, platform unix, -O2), no per-CPU flags: they
# wait for P-10. The commit is the newest of master (2026-07-28). The FB Alpha license forbids
# selling and asking for donations and requires the license text to travel with the binary:
# it is installed in /usr/share/licenses/ (see README, License). The info file comes from
# libretro-core-info (fbalpha2012_libretro.info), copied by rootfs/configure.sh.
pkgname=libretro-fbalpha2012
pkgver=0.2.97.29
pkgrel=0
_commit="0ce31536bef3162fe7e69ff5f555334ec4913cef"
pkgdesc="FB Alpha 2012 libretro core (all arcade boards)"
url="https://github.com/libretro/fbalpha2012"
arch="all"
license="custom"
source="$pkgname-$_commit.tar.gz::https://github.com/libretro/fbalpha2012/archive/$_commit.tar.gz"
builddir="$srcdir/fbalpha2012-$_commit/svn-current/trunk"
options="!check" # No tests

build() {
	# 2012 code: sprintf(buf, non_literal) trips the Alpine default -Werror=format-security
	export CFLAGS="$CFLAGS -Wno-error=format-security"
	export CXXFLAGS="$CXXFLAGS -Wno-error=format-security"
	make -f makefile.libretro
}

package() {
	install -Dm644 fbalpha2012_libretro.so "$pkgdir"/usr/lib/libretro/fbalpha2012_libretro.so
	install -Dm644 src/license.txt "$pkgdir"/usr/share/licenses/$pkgname/license.txt
}
sha512sums="
7e8d4cb6c0ca8348ad4f3275a2494086d7c3ab0892b0c39101252ee7e891d63664e52fe4aea4af43a742f82f3ef70fb7e80b31fd7322c54d1eddd02fa94ec2af  libretro-fbalpha2012-0ce31536bef3162fe7e69ff5f555334ec4913cef.tar.gz
"

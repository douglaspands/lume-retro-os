#!/sbin/openrc-run
# Input daemon of the console (lume-launcher D8): one virtual gamepad from the built-in
# controls, the Fn+Start combo for the launcher and the volume buttons, before the frontend.
# The profile is the one of the board (/etc/r36os/board).

description="Built-in controls: one gamepad, Fn+Start and volume"
supervisor="supervise-daemon"
command="/usr/bin/r36os-input"
command_args="--profile /usr/share/r36os/input/$(cat /etc/r36os/board 2>/dev/null).conf"
respawn_delay=2
respawn_max=5

depend() {
	need udev
	after udev-settle
	before frontend r36os-hwsummary
}

# Lume Retro OS: the input daemon (lume-launcher D8; it grew out of r36os-padmerge). Grabs
# the built-in controls of the console, publishes one virtual gamepad under the name the
# RetroArch autoconfig knows, turns Fn+Start into "quit" for the launcher and handles the
# volume buttons. One profile per board in /usr/share/r36os/input/.
# Also r36os-shot (lume-launcher D12): a PNG of the screen through DRM, used over the cable,
# and r36os-evrec (virtual-gamepad D2): record and replay the virtual gamepad, as root.
pkgname=r36os-input
pkgver=1.0
pkgrel=10
pkgdesc="Built-in controls of the console: one gamepad, Fn+Start and volume (Lume Retro OS)"
url="https://example.invalid"
arch="x86_64 armv7 aarch64"
license="GPL-2.0-or-later"
depends="openrc alsa-utils"
# linux/input.h, linux/uinput.h and the DRM uapi headers; zlib for the PNG of r36os-shot
makedepends="linux-headers zlib-dev"
options="!check" # tested on the host (tests/unit/test_r36os_input.py, test_r36os_shot.py,
                 # test_r36os_evrec.py)
replaces="r36os-padmerge"
provides="r36os-padmerge=$pkgver-r$pkgrel"
source="input.c
	shot.c
	evrec.c
	r36os-input.initd
	61-r36os-input.rules
	ga36.conf
	r36s.conf
	vm.conf
	"
builddir="$srcdir"

build() {
	${CC:-cc} $CFLAGS $LDFLAGS -Wall -Wextra -Werror -o r36os-input input.c
	${CC:-cc} $CFLAGS $LDFLAGS -Wall -Wextra -Werror -o r36os-shot shot.c -lz
	${CC:-cc} $CFLAGS $LDFLAGS -Wall -Wextra -Werror -o r36os-evrec evrec.c
}

package() {
	install -Dm755 r36os-input "$pkgdir"/usr/bin/r36os-input
	install -Dm755 r36os-shot "$pkgdir"/usr/bin/r36os-shot
	install -Dm755 r36os-evrec "$pkgdir"/usr/bin/r36os-evrec
	install -Dm755 "$srcdir"/r36os-input.initd "$pkgdir"/etc/init.d/r36os-input
	install -Dm644 "$srcdir"/61-r36os-input.rules \
		"$pkgdir"/usr/lib/udev/rules.d/61-r36os-input.rules
	for p in ga36 r36s vm; do
		install -Dm644 "$srcdir"/$p.conf "$pkgdir"/usr/share/r36os/input/$p.conf
	done
}


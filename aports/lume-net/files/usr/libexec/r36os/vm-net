#!/bin/sh
# Local network of the vm image only (virtual-gamepad 3.3): `r36os vm --ssh` gives the vm a
# QEMU user network (restrict=on: no route out of the PC) with the vm's port 22 forwarded to
# 127.0.0.1:<port> of the PC only, so `r36os dev --host 127.0.0.1:<port>` reaches the vm the
# way it reaches a console on the USB cable.
#
# vm-net run: takes one DHCP lease on the virtio network interface (address only: no route,
# no DNS), then runs dropbear in the foreground on that address only, root with no password
# and no forwarding, like the cable (usb-device-access D4). The r36os-vmnet service runs it
# under supervise-daemon, after the frontend, and only on the vm with a virtio NIC.
# vm-net ifname: prints the virtio network interface (exit 1 when there is none: test-vm).
# deconfig|bound|renew|leasefail|nak: the udhcpc events (this script is its -s script).
#
# Environment for the tests: BOARD_FILE, NET_CLASS (default /sys/class/net), IP, UDHCPC,
# DROPBEAR, KMSG, SELF (this script, for udhcpc -s), RUN_DIR (the leased address).
BOARD_FILE=${BOARD_FILE:-/etc/r36os/board}
NET_CLASS=${NET_CLASS:-/sys/class/net}
IP=${IP:-ip}
UDHCPC=${UDHCPC:-udhcpc}
DROPBEAR=${DROPBEAR:-dropbear}
KMSG=${KMSG:-/dev/kmsg}
SELF=${SELF:-/usr/libexec/r36os/vm-net}
RUN_DIR=${RUN_DIR:-/run/r36os}

say() {
	echo "vm-net: $1"
	[ -w "$KMSG" ] && echo "r36os-vmnet: $1" >> "$KMSG" 2>/dev/null
	return 0
}

is_vm() {
	[ "$(cat "$BOARD_FILE" 2>/dev/null)" = vm ]
}

# the first network interface driven by virtio_net (the consoles have none)
vm_ifname() {
	local d drv
	for d in "$NET_CLASS"/*; do
		[ -e "$d/device/driver" ] || continue
		drv=$(readlink "$d/device/driver")
		[ "${drv##*/}" = virtio_net ] && { echo "${d##*/}"; return 0; }
	done
	return 1
}

cmd_run() {
	local ifc addr
	is_vm || { say "not the vm: no network"; return 1; }
	ifc=$(vm_ifname) || { say "no virtio network interface"; return 1; }
	$IP link set "$ifc" up
	rm -f "$RUN_DIR/vm-net.addr"
	# one lease, then quit: the QEMU lease outlives any vm session
	if ! "$UDHCPC" -i "$ifc" -f -q -n -t 10 -T 1 -s "$SELF"; then
		say "no DHCP lease on $ifc"
		return 1
	fi
	addr=$(cat "$RUN_DIR/vm-net.addr" 2>/dev/null)
	[ -n "$addr" ] || { say "no address on $ifc"; return 1; }
	mkdir -p /etc/dropbear 2>/dev/null
	say "ssh on $addr:22 (root, no password, vm only)"
	exec "$DROPBEAR" -F -E -R -B -j -k -p "$addr:22"
}

# udhcpc events: only the address (no default route, no resolv.conf)
dhcp_event() {
	case "$1" in
	deconfig)
		$IP -4 addr flush dev "$interface" 2>/dev/null
		$IP link set "$interface" up
		;;
	bound|renew)
		$IP -4 addr flush dev "$interface" 2>/dev/null
		$IP -4 addr add "$ip/${mask:-24}" dev "$interface"
		mkdir -p "$RUN_DIR"
		echo "$ip" > "$RUN_DIR/vm-net.addr"
		say "address $ip/${mask:-24} on $interface"
		;;
	esac
	return 0
}

case "${1:-}" in
run) cmd_run ;;
ifname) vm_ifname ;;
deconfig|bound|renew|leasefail|nak) dhcp_event "$1" ;;
*) echo "usage: vm-net run|ifname" >&2; exit 2 ;;
esac

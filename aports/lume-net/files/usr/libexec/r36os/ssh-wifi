#!/bin/sh
# SSH over Wi-Fi (lume-launcher D18): root over the Wi-Fi network when the user turns it on in
# the launcher (Settings > Wi-Fi, ssh_wifi in the launcher's settings.toml), with the code the
# panel shows as the password of the user "console" (uid 0).
#
# The SSH of the USB cable (usb-gadget, root without a password on 10.55.0.1) is a cable from
# the PC; a Wi-Fi network reaches everyone on it, so here:
#  - the password is the code on the console's screen: 8 characters of 32, kept on the card
#    (system/ssh/wifi-code) until the user asks for a new one in the launcher, which writes the
#    file; this applies it to "console" in /etc/shadow (the RAM layer) with chpasswd;
#  - root's empty password does not work here (no -B), only on the cable;
#  - public keys in system/ssh/authorized_keys on the card also work (advanced), copied to
#    /root/.ssh with the modes dropbear asks for (FAT keeps none);
#  - listening only on the address of the Wi-Fi interface, never a Wi-Fi Direct group
#    (p2p-*) and never 0.0.0.0; without the option or a Wi-Fi address nothing listens;
#  - the host key lives on the card, so the PC sees the same one after every boot.
#
# usage: ssh-wifi apply   once: start, move or stop to match the option and the address
#        ssh-wifi watch   the service: apply every few seconds (the option is a file the
#                         launcher writes as the game user; this runs as root)
# SETTINGS, CODE, KEYS, HOSTKEY, NET_CLASS, IP, DROPBEAR, DROPBEARKEY, CHPASSWD, ROOT_SSH, RUN
# and INTERVAL only change for the tests.
SETTINGS=${SETTINGS:-/storage/system/lume/settings.toml}
CODE=${CODE:-/storage/system/ssh/wifi-code}
KEYS=${KEYS:-/storage/system/ssh/authorized_keys}
HOSTKEY=${HOSTKEY:-/storage/system/ssh/dropbear_ed25519_host_key}
NET_CLASS=${NET_CLASS:-/sys/class/net}
IP=${IP:-ip}
DROPBEAR=${DROPBEAR:-dropbear}
DROPBEARKEY=${DROPBEARKEY:-dropbearkey}
CHPASSWD=${CHPASSWD:-chpasswd}
ROOT_SSH=${ROOT_SSH:-/root/.ssh}
RUN=${RUN:-/run/r36os}
INTERVAL=${INTERVAL:-4}
PID=$RUN/ssh-wifi.pid
ADDR=$RUN/ssh-wifi.addr
APPLIED=$RUN/ssh-wifi.applied
# the code's alphabet: no 0/O, 1/I/L (the launcher makes new codes with the same one)
ALPHABET=23456789ABCDEFGHJKMNPQRSTUVWXYZ

say() { echo "ssh-wifi: $*"; logger -t r36os-ssh-wifi "$*" 2>/dev/null; return 0; }

enabled() { grep -Eq '^[[:space:]]*ssh_wifi[[:space:]]*=[[:space:]]*true[[:space:]]*$' "$SETTINGS" 2>/dev/null; }

# the first wireless interface by name, not a Wi-Fi Direct group (lume-ui picks the same)
wifi_iface() {
	for d in "$NET_CLASS"/*; do
		n=${d##*/}
		case $n in p2p*) continue ;; esac
		if [ -e "$d/wireless" ] || [ -e "$d/phy80211" ]; then echo "$n"; return 0; fi
	done
	return 1
}

wifi_addr() {
	i=$(wifi_iface) || return 0
	"$IP" -4 -o addr show dev "$i" 2>/dev/null | sed -n 's/.* inet \([0-9.]*\)\/.*/\1/p' | head -n 1
}

# the address the running server listens on (empty when none runs)
running_addr() {
	[ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null && cat "$ADDR" 2>/dev/null
	return 0
}

# A new code, "XXXX-XXXX", from /dev/urandom.
new_code() {
	c=$(tr -dc "$ALPHABET" < /dev/urandom | head -c 8)
	echo "${c%????}-${c#????}"
}

# The code on the card (made when missing), applied as the password of "console" whenever it
# changed; the card's text is only trusted when it looks like a code.
apply_code() {
	code=$(head -n 1 "$CODE" 2>/dev/null | tr -d '\r\n ')
	case $code in
	[2-9A-Z][2-9A-Z][2-9A-Z][2-9A-Z]-[2-9A-Z][2-9A-Z][2-9A-Z][2-9A-Z]) ;;
	*)
		code=$(new_code)
		mkdir -p "${CODE%/*}"
		echo "$code" > "$CODE.tmp" && mv -f "$CODE.tmp" "$CODE"
		say "new code made"
		;;
	esac
	if [ "$(cat "$APPLIED" 2>/dev/null)" != "$code" ]; then
		echo "console:$code" | "$CHPASSWD" > /dev/null 2>&1 || { say "code not applied"; return 1; }
		mkdir -p "$RUN"
		echo "$code" > "$APPLIED"
		say "code applied"
	fi
}

install_keys() {
	if [ ! -s "$KEYS" ]; then
		rm -f "$ROOT_SSH/authorized_keys"
		return 0
	fi
	mkdir -p "$ROOT_SSH" && chmod 700 "$ROOT_SSH" || return 1
	cmp -s "$KEYS" "$ROOT_SSH/authorized_keys" 2>/dev/null && return 0
	cp "$KEYS" "$ROOT_SSH/authorized_keys.tmp" && chmod 600 "$ROOT_SSH/authorized_keys.tmp" &&
		mv -f "$ROOT_SSH/authorized_keys.tmp" "$ROOT_SSH/authorized_keys"
}

stop_ssh() {
	if [ -f "$PID" ]; then
		kill "$(cat "$PID")" 2>/dev/null
		rm -f "$PID" "$ADDR"
		say "stopped"
	fi
	# the keys only stay while it runs; "console" goes back to locked
	rm -f "$ROOT_SSH/authorized_keys"
	if [ -f "$APPLIED" ]; then
		echo 'console:!' | "$CHPASSWD" -e > /dev/null 2>&1
		rm -f "$APPLIED"
	fi
}

start_ssh() {
	apply_code || return 1
	install_keys || { say "keys not installed"; return 1; }
	if [ ! -s "$HOSTKEY" ]; then
		mkdir -p "${HOSTKEY%/*}"
		"$DROPBEARKEY" -t ed25519 -f "$HOSTKEY" > /dev/null 2>&1 || { say "no host key"; return 1; }
	fi
	mkdir -p "$RUN"
	# passwords allowed (the code of "console"), but no -B: root's empty one does not work;
	# -j -k: no forwarding
	"$DROPBEAR" -F -E -j -k -r "$HOSTKEY" -p "$1:22" 2> /dev/null &
	echo $! > "$PID"
	echo "$1" > "$ADDR"
	say "listening on $1:22"
}

apply() {
	want=""
	if enabled; then want=$(wifi_addr); fi
	have=$(running_addr)
	if [ -n "$want" ] && [ "$want" = "$have" ]; then
		# a new code asked in the launcher, or a key added or removed on the card
		apply_code
		install_keys
		return 0
	fi
	[ -z "$want" ] && [ -z "$have" ] && [ ! -f "$PID" ] && return 0
	stop_ssh
	if [ -n "$want" ]; then start_ssh "$want"; fi
	return 0
}

case "${1:-}" in
apply) apply ;;
watch)
	trap 'stop_ssh; exit 0' TERM INT
	while :; do
		apply
		sleep "$INTERVAL" &
		wait $!
	done ;;
*) echo "usage: ssh-wifi apply|watch" >&2; exit 2 ;;
esac

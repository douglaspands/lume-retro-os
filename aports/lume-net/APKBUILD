# Lume Retro OS: the net fragment (build-speed D2, node 8.1). The Wi-Fi SSH and hostshare services, the NetworkManager and dbus settings.
# The files live in files/ at the same paths and modes they have in the image, and the package
# ships them as they are.
#
# noarch: built once in the x86_64 builder and published as the same .apk for every
# architecture (r36os build, packages.build_noarch). No ELF file may be added to files/.
pkgname=lume-net
pkgver=1.0
pkgrel=0
pkgdesc="Network and Bluetooth settings: SSH over Wi-Fi, hostshare, NetworkManager, bluez policy"
url="https://example.invalid"
arch="noarch"
license="GPL-2.0-or-later"
depends="lume-core"
options="!check" # tested on the host (tests/unit and the shell suites)
# etc/conf.d/bluetooth and etc/conf.d/networkmanager are files of bluez-openrc and
# networkmanager-openrc; the image carries the Lume version (rc_after frontend).
# The image has always carried the Lume version: replaces lets apk install it on top and
# replaces_priority makes the Lume file win whichever package apk unpacks first.
replaces="bluez-openrc networkmanager-openrc"
replaces_priority=100
# services `r36os push --hot` restarts when they are running (empty: none)
_lume_restart="bluetooth r36os-hostshare"
builddir="$srcdir"

build() {
	:
}

package() {
	mkdir -p "$pkgdir"
	cp -a "$startdir"/files/. "$pkgdir"/
	# a checkout may have any umask: pin the directories (the files keep the git modes)
	find "$pkgdir" -type d -exec chmod 755 {} +
	chown -R 0:0 "$pkgdir"
}

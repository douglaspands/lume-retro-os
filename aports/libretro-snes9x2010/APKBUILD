# Pacote local do Lume Retro OS (não existe no Alpine).
pkgname=libretro-snes9x2010
# Fixado antes da série do renderizador em thread (2026-09-13 em diante): no master,
# SetupOBJ (src/ppu.c) acessa S9xCurRenderRegs nulo e o core cai no primeiro quadro.
pkgver=0_git20260816
pkgrel=0
_commit="7db129b1ecdccb38cb4d7184bcbed39beed79656"
pkgdesc="Super Nintendo core for libretro (Snes9x 1.52, leve)"
url="https://github.com/libretro/snes9x2010"
arch="all"
license="custom"
makedepends="linux-headers"
source="$pkgname-$_commit.tar.gz::https://github.com/libretro/snes9x2010/archive/$_commit.tar.gz"
builddir="$srcdir/snes9x2010-$_commit"
options="!check" # No tests

build() {
	make -f Makefile
}

package() {
	install -Dm644 snes9x2010_libretro.so "$pkgdir"/usr/lib/libretro/snes9x2010_libretro.so
}

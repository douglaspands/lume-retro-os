# Lume Retro OS local package (not in Alpine).
# MAME 2003-Plus (MAME 0.78 plus backports): an alternative arcade core under measurement
# against fbneo on the GA36 (game-experience-tuning 10; it was disabled on 2026-11-11, when
# the arcade went to fbneo on every console). Default upstream build (Makefile, platform unix,
# -O2), no per-CPU flags: they wait for P-10. The commit is the newest of master (2026-11-19).
# MAME non-commercial license (LICENSE.md, installed in /usr/share/licenses/). The info file
# comes from libretro-core-info (mame2003_plus_libretro.info), copied by rootfs/configure.sh.
pkgname=libretro-mame2003-plus-cyclone-lume
pkgver=0_git20261119
pkgrel=0
_commit="2a60eda71ae0fea543a76a43b5d58086a5485256"
pkgdesc="MAME 2003-Plus (MAME 0.78 with backports), arcade core for libretro (Lume, Cyclone build)"
url="https://github.com/libretro/mame2003-plus-libretro"
arch="armv7"
license="custom:MAME"
makedepends="linux-headers libretro-core-info binutils"
source="$pkgname-$_commit.tar.gz::https://github.com/libretro/mame2003-plus-libretro/archive/$_commit.tar.gz"
builddir="$srcdir/mame2003-plus-libretro-$_commit"
options="!check" # No tests

prepare() {
	default_prepare
	# The ST-V video forces initial-exec TLS, which musl refuses in a .so opened by dlopen
	# ("initial-exec TLS resolves to dynamic definition"). Without the attribute the
	# compiler uses the dynamic model, which works on musl.
	sed -i 's/__thread __attribute__((tls_model("initial-exec")))/__thread/' \
		src/vidhrdw/stvvid.c
	grep -q 'tls_model("initial-exec")' src/vidhrdw/stvvid.c && return 1
	return 0
}

_upstream_build() {
	make -f Makefile
}

_upstream_package() {
	install -Dm644 mame2003_plus_libretro.so "$pkgdir"/usr/lib/libretro/mame2003_plus_libretro.so
	install -Dm644 LICENSE.md "$pkgdir"/usr/share/licenses/$pkgname/LICENSE.md
}

# --- Lume build (generated by lume_tool.cores_lume from the upstream aport; edit the generator,
# not this block). CPU flags of the architecture, nothing else changed (no -Ofast, no LTO) ---
_lume_core="mame2003_plus"
_lume_id="mame2003_plus_cyclone_lume"
_lume_label="Lume, Cyclone"
_lume_infodir=/usr/share/libretro/info   # where libretro-core-info installs the info files
case "$CARCH" in
armv7) _lume_flags="-marm -mcpu=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard" ;;
aarch64) _lume_flags="-mcpu=cortex-a35" ;;
*) _lume_flags="" ;;
esac

# Cyclone (68000) and DrZ80 (Z80): the ARM assembly CPU cores of this emulator
make() {
	command make "$@" USE_CYCLONE=1 USE_DRZ80=1
}

build() {
	# the flags go last in the CFLAGS/CXXFLAGS of the environment, which every Makefile of this
	# core takes (checked with make -n); `_cflags` is the per-arch part that some upstream
	# aports add themselves, covered by the flags
	_cflags=""
	if [ -n "$_lume_flags" ]; then
		export CFLAGS="$CFLAGS $_lume_flags"
		export CXXFLAGS="$CXXFLAGS $_lume_flags"
	fi
	_upstream_build
}

package() {
	_upstream_package
	_libdir="$pkgdir"/usr/lib/libretro
	_so="$_libdir/${_lume_id}_libretro.so"
	mv "$_libdir/${_lume_core}_libretro.so" "$_so" || return 1
	# the info file of the upstream core (libretro-core-info) under the new core id; its
	# corename names the folder of the options of the core, so it must differ
	_info="$_lume_infodir/${_lume_core}_libretro.info"
	_out="$pkgdir"/usr/share/libretro/info/${_lume_id}_libretro.info
	[ -f "$_info" ] || { error "$_info is missing (libretro-core-info)"; return 1; }
	install -dm755 "$pkgdir"/usr/share/libretro/info
	sed -e "s/^\(corename *= *\"[^\"]*\)\"/\1 (${_lume_label})\"/" \
		-e "s/^\(display_name *= *\"[^\"]*\)\"/\1 (${_lume_label})\"/" \
		"$_info" > "$_out"
	grep -q "^corename *= *\".*(${_lume_label})\"" "$_out" \
		|| { error "no corename in $_info"; return 1; }
	# armv7: the flags reached the compiler (the FPU default of the distro is vfpv3-d16, no NEON)
	if [ "$CARCH" = armv7 ]; then
		_attrs=$(readelf -A "$_so") || return 1
		echo "$_attrs" | grep -E 'Tag_(CPU_name|CPU_arch|FP_arch|Advanced_SIMD_arch)'
		echo "$_attrs" | grep -q Tag_Advanced_SIMD_arch \
			|| { error "no NEON in $_so: the CPU flags did not reach the compiler"; return 1; }
		# the assembly CPU cores really are in the library
		_syms=$(readelf -sW "$_so") || return 1
		for _s in CycloneRun DrZ80Run; do
			echo "$_syms" | grep -q "$_s" || { error "$_s is not in $_so"; return 1; }
		done
	fi
}


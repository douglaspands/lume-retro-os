# Lume Retro OS: the game controller of the power service (openspec game-governor D12, D17). In
# a game profile with controller=load, r36os-power starts it: the userspace governor, one step
# of the frequency table up or down by the load of the busiest thread of the game, inside the
# profile limits and under the thermal cap. With controller=auto it finds the bottleneck (CPU,
# GPU, frame pacing, thermal) from /proc and the DRM fdinfo and raises only that resource: the
# CPU clock or the GPU devfreq floor. Stopped at the end of the game.
pkgname=r36os-powerctl
pkgver=1.1
pkgrel=0
pkgdesc="CPU and GPU clocks by the load and bottleneck of the game (Lume Retro OS)"
url="https://example.invalid"
arch="x86_64 armv7 aarch64"
license="GPL-2.0-or-later"
options="!check" # tested on the host (tests/unit/test_r36os_powerctl.py)
source="powerctl.c"
builddir="$srcdir"

build() {
	${CC:-cc} $CFLAGS $LDFLAGS -Wall -Wextra -Werror -o r36os-powerctl powerctl.c
}

package() {
	install -Dm755 r36os-powerctl "$pkgdir"/usr/bin/r36os-powerctl
}

sha512sums="
e129fde952743c17b1b418a652041338cdf495fd33c4d2a6e8da40e1f6f88f0442a349a86ef6d3edeb7b38e5e8379dfaa3f5ab5aa9a1e386b33c0966973c58c0  powerctl.c
"

+/* Lume: the status bar, the chord hint and the Lume menu (text from lume-run) */
+enum gfx_widget_lume_kind
+{
+   GFX_WIDGET_LUME_HUD = 0,
+   GFX_WIDGET_LUME_HINT,
+   GFX_WIDGET_LUME_MENU,
+   GFX_WIDGET_LUME_LAST
+};
+
+void gfx_widget_lume_show(enum gfx_widget_lume_kind kind, const char *text);
+
 void gfx_widgets_iterate(
       void *data_disp,
       void *settings_data,
@@ -428,6 +439,7 @@ dispgfx_widget_t *dispwidget_get_ptr(void);
 extern const gfx_widget_t gfx_widget_screenshot;

From: Lume Retro OS
Subject: [PATCH] volume: 0-100% in 5% steps, capped at 0 dB

Upstream, each volume key press changes the gain by 0.5 dB between -80 and
+12 dB, and the volume widget shows the dB value and the linear amplitude as
a percent. On a handheld this is hard to read: -29.5 dB shows as 3%, going
from silence to full takes 160 presses, and above 0 dB the percent passes
100% (up to 398%) while the small speaker only clips.

The volume keys now move a 0-100% level in 5% steps on a perceptual curve,
amplitude = level^2, i.e. dB = 40 * log10(level / 100): 100% is 0 dB, 50% is
-12 dB, 10% is -40 dB and 0% is -80 dB (the lowest RetroArch accepts). A
volume set in the menu snaps to the grid on the next key press. The widget
shows the same level, as a bar and a percent, without the dB value. The
menu's Volume setting is capped at 0 dB too.

--- a/command.c
+++ b/command.c
@@ -20,6 +20,7 @@
 #include <stdlib.h>
 #include <stddef.h>
 #include <locale.h>
+#include <math.h>
 #ifdef HAVE_NETWORKING
 #include <net/net_compat.h>
 #include <net/net_socket.h>
@@ -1157,6 +1158,27 @@
 }
 #endif

+/* Lume: the volume keys move a 0-100% level in 5% steps, capped at 0 dB
+ * (no gain above the original sound, which only clips on the small
+ * speaker). The level follows a perceptual curve, amplitude = level^2:
+ * dB = 40 * log10(level / 100), so 50% is -12 dB and 10% is -40 dB.
+ * Level 0 is -80 dB, the lowest volume RetroArch accepts. */
+#define LUME_VOLUME_STEP 5.0f
+
+static float lume_volume_db_to_level(float db)
+{
+   if (db <= -80.0f)
+      return 0.0f;
+   return 100.0f * (float)pow(10.0, db / 40.0);
+}
+
+static float lume_volume_level_to_db(float level)
+{
+   if (level < LUME_VOLUME_STEP / 2.0f)
+      return -80.0f;
+   return 40.0f * (float)log10(level / 100.0f);
+}
+
 void command_event_set_volume(
       settings_t *settings,
       float gain,
@@ -1165,16 +1187,24 @@
 {
    size_t _len;
    char msg[128];
-   float new_volume = settings->floats.audio_volume + gain;
-   new_volume       = MAX(new_volume, -80.0f);
-   new_volume       = MIN(new_volume, 12.0f);
+   float level      = lume_volume_db_to_level(settings->floats.audio_volume);
+   float new_volume;
+   /* Snap to the step grid first, so a volume set in the menu (any dB)
+    * joins the 5% steps on the next key press. A gain kept from before
+    * (above 0 dB) counts as 100%. */
+   level            = MIN(level, 100.0f);
+   level            = (float)floor(level / LUME_VOLUME_STEP + 0.5f)
+      * LUME_VOLUME_STEP;
+   level           += (gain > 0.0f) ? LUME_VOLUME_STEP : -LUME_VOLUME_STEP;
+   level            = MAX(level, 0.0f);
+   level            = MIN(level, 100.0f);
+   new_volume       = lume_volume_level_to_db(level);
    configuration_set_float(settings, settings->floats.audio_volume, new_volume);
    _len             = strlcpy(msg, msg_hash_to_str(MSG_AUDIO_VOLUME),
          sizeof(msg));
    _len            += strlcpy(msg + _len, ": ", sizeof(msg) - _len);
-   _len            += snprintf(msg + _len, sizeof(msg) - _len, "%.1f",
-         new_volume);
-   _len            += strlcpy(msg + _len, " dB", sizeof(msg) - _len);
+   _len            += snprintf(msg + _len, sizeof(msg) - _len, "%d%%",
+         (int)level);

 #if defined(HAVE_GFX_WIDGETS)
    if (widgets_active)

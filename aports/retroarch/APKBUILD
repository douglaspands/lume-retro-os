# Baseado em community/retroarch do Alpine v3.24 (Bart Ribbers, David Demelier).
# Variante do Lume Retro OS: só KMS/DRM + EGL + GLES 2, udev e ALSA.
# Sem X11, Wayland, Qt, SDL2, PulseAudio, FFmpeg e Vulkan. Assets e autoconfiguração
# de controles entram como pacotes separados em rootfs/packages.txt.
# pkgrel alto para o repositório local vencer o pacote do Alpine.
pkgname=retroarch
pkgver=1.22.2
pkgrel=115
arch="all"
url="https://retroarch.com"
pkgdesc="Reference frontend for the libretro API (KMS/GLES, Lume Retro OS)"
license="GPL-2.0-only"
depends="libretro-core-info"
makedepends="linux-headers mesa-dev libdrm-dev zlib-dev alsa-lib-dev eudev-dev
	freetype-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/libretro/retroarch/archive/v$pkgver.tar.gz
	config.patch
	0001-quit-shuts-down.patch
	0002-shut-down-asks-confirmation.patch
	0003-alsa-bounded-write-wait.patch
	0004-status-frame-count.patch
	0005-volume-percent-steps.patch
	0006-reset-to-distro-defaults.patch
	0007-config-autosave.patch
	0009-network-commands-on-localhost.patch
	0010-quit-label-follows-the-frontend.patch
	0011-lume-level-line.patch
	0012-lume-hud-hint-menu.patch
	0013-lume-menu-lock.patch
	0014-alsa-close-the-stream-while-paused.patch
	"
subpackages="$pkgname-doc"
builddir="$srcdir/RetroArch-$pkgver"
options="!check" # No tests

# 0001: quitting RetroArch powers the console off (lume-session), so the "Quit" item becomes
# "Shut Down" in English (us), Brazilian Portuguese (pt_br) and Spanish (es, the only Spanish
# of RetroArch; "Apagar" works for Latin America and Spain). If upstream changes that text,
# the patch no longer applies and the build stops.
# 0002: o item "Desligar" do menu pede confirmação (selecionar duas vezes em até 3 s),
# seguindo o quit_press_twice, e a mensagem "Pressione novamente..." passa a dizer desligar.
# Só o item do menu muda: o atalho e o comando de rede QUIT (self-test) não mudam.
# 0003: the ALSA driver waits at most 500 ms for room in the playback buffer
# (upstream waits forever). A device that stops consuming used to freeze the whole
# frontend on the first audio write of a game (GA36, task 9.8); now the game keeps
# running without sound and the log says "[ALSA] Playback stalled".
# 0004: the GET_STATUS network command also returns the video frame counter
# (",frames=<n>" at the end), so lume-logd records the game FPS (task 9.13).
# 0005: the volume keys move a 0-100% level in 5% steps (perceptual curve), capped at
# 0 dB; the volume widget shows only the percent, and the menu volume stops at 0 dB.
# 0006: "Reset to Default Config" also loads $LUME_RETROARCH_DEFAULTS (factory config +
# fixed keys, written by the frontend script), so a reset lands on the distro defaults.
# 0007: the main config is saved one second after the last change in the menu (or volume
# keys), not only on a clean quit, so a crash or a forced restart keeps the settings.
# 0008 (a fixed 3 dB headroom under the volume setting, for the GA36 speaker) was
# removed on 2026-11-13 at the user's request: the R36S speaker is too quiet, and the
# loudness belongs to the analog volume on the mixer (docs/PENDENCIAS.md, P-29). The
# number stays unused; the patch is in the git history.
# 0009: the UDP network commands (55355) listen on 127.0.0.1 only: with Wi-Fi, nobody on
# the network can send commands; lume-logd asks through 127.0.0.1 (usb-device-access D11).
# 0010: opened by the lume-launcher (LUME_RETROARCH_QUIT=launcher, set by the frontend
# script), quitting goes back to the game list: the item keeps the upstream wording and
# quits without the confirmation of 0002. As the fallback frontend, 0001 and 0002 hold.
# 0012: LUME_HUD, LUME_HINT and LUME_MENU draw lume-run's status bar, chord hint and Lume
# menu over the game as graphics widgets (lume-hud-actions D8); RetroArch only draws the
# text it gets, and each widget hides 3 s after its last command.
# 0013: lume_menu_lock (on in retroarch-lume.cfg): during a game of the launcher (content
# on the command line) the menu is the Quick Menu only; Back at its root resumes the game,
# and the main menu never stays on screen. The menu opened without a game is not locked
# (device-fixes 9.9; the unlock in the Lume settings is P-101).
# 0014: the ALSA driver closes the playback stream when stopped (menu open) instead of
# pausing it, and pausing the game stops the driver too; the first samples after the pause
# open it again. Only a closed stream lets DAPM switch the speaker amplifier off: a paused
# or underrun one keeps it on (~12 mA on the GA36; device-fixes 7.3, D9).
#
# Wi-Fi and Bluetooth (usb-device-access D9-D11): the menus use NetworkManager (nmcli, the
# only Wi-Fi driver outside Lakka builds) and bluez (bluetoothctl, no D-Bus build needed).

build() {
	./configure \
		--prefix=/usr \
		--disable-builtinzlib \
		--disable-discord \
		--disable-vg \
		--disable-videocore \
		--disable-x11 \
		--disable-wayland \
		--disable-qt \
		--disable-sdl \
		--disable-sdl2 \
		--disable-pulse \
		--disable-jack \
		--disable-oss \
		--disable-ffmpeg \
		--disable-vulkan \
		--disable-opengl1 \
		--disable-ssl \
		--enable-bluetooth \
		--enable-wifi \
		--enable-builtinflac \
		--enable-dynamic \
		--enable-udev \
		--enable-alsa \
		--enable-freetype \
		--enable-egl \
		--enable-kms \
		--enable-opengles
	make
}

package() {
	DESTDIR="$pkgdir" make install
}


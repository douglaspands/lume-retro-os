# Baseado em community/retroarch do Alpine v3.24 (Bart Ribbers, David Demelier).
# Variante do Lume Retro OS: só KMS/DRM + EGL + GLES 2, udev e ALSA.
# Sem X11, Wayland, Qt, SDL2, PulseAudio, FFmpeg e Vulkan. Assets e autoconfiguração
# de controles entram como pacotes separados em rootfs/packages.txt.
# pkgrel alto para o repositório local vencer o pacote do Alpine.
pkgname=retroarch
pkgver=1.22.2
pkgrel=108
arch="all"
url="https://retroarch.com"
pkgdesc="Reference frontend for the libretro API (KMS/GLES, Lume Retro OS)"
license="GPL-2.0-only"
depends="libretro-core-info"
makedepends="linux-headers mesa-dev libdrm-dev zlib-dev alsa-lib-dev eudev-dev
	freetype-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/libretro/retroarch/archive/v$pkgver.tar.gz
	config.patch
	0001-quit-shuts-down.patch
	0002-shut-down-asks-confirmation.patch
	0003-alsa-bounded-write-wait.patch
	0004-status-frame-count.patch
	0005-volume-percent-steps.patch
	0006-reset-to-distro-defaults.patch
	0007-config-autosave.patch
	0008-audio-headroom.patch
	"
subpackages="$pkgname-doc"
builddir="$srcdir/RetroArch-$pkgver"
options="!check" # No tests

# 0001: sair do RetroArch desliga o console (r36os-session), então o item "Sair" vira
# "Desligar" em inglês (us), português do Brasil (pt_br) e espanhol (es, o único espanhol
# do RetroArch; "Apagar" vale para a América Latina e a Espanha). Se o upstream mudar
# esse texto, o patch deixa de aplicar e o build para.
# 0002: o item "Desligar" do menu pede confirmação (selecionar duas vezes em até 3 s),
# seguindo o quit_press_twice, e a mensagem "Pressione novamente..." passa a dizer desligar.
# Só o item do menu muda: o atalho e o comando de rede QUIT (self-test) não mudam.
# 0003: the ALSA driver waits at most 500 ms for room in the playback buffer
# (upstream waits forever). A device that stops consuming used to freeze the whole
# frontend on the first audio write of a game (GA36, task 9.8); now the game keeps
# running without sound and the log says "[ALSA] Playback stalled".
# 0004: the GET_STATUS network command also returns the video frame counter
# (",frames=<n>" at the end), so r36os-logd records the game FPS (task 9.13).
# 0005: the volume keys move a 0-100% level in 5% steps (perceptual curve), capped at
# 0 dB; the volume widget shows only the percent, and the menu volume stops at 0 dB.
# 0006: "Reset to Default Config" also loads $LUME_RETROARCH_DEFAULTS (factory config +
# fixed keys, written by the frontend script), so a reset lands on the distro defaults.
# 0007: the main config is saved one second after the last change in the menu (or volume
# keys), not only on a clean quit, so a crash or a forced restart keeps the settings.
# 0008: a fixed 3 dB headroom under the volume setting: 100% stays clean on the GA36
# speaker (it was harsh on loud passages at 0 dB).

build() {
	./configure \
		--prefix=/usr \
		--disable-builtinzlib \
		--disable-discord \
		--disable-vg \
		--disable-videocore \
		--disable-x11 \
		--disable-wayland \
		--disable-qt \
		--disable-sdl \
		--disable-sdl2 \
		--disable-pulse \
		--disable-jack \
		--disable-oss \
		--disable-ffmpeg \
		--disable-vulkan \
		--disable-opengl1 \
		--disable-ssl \
		--disable-bluetooth \
		--disable-wifi \
		--enable-builtinflac \
		--enable-dynamic \
		--enable-udev \
		--enable-alsa \
		--enable-freetype \
		--enable-egl \
		--enable-kms \
		--enable-opengles
	make
}

package() {
	DESTDIR="$pkgdir" make install
}


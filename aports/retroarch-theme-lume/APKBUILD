# Tema Lume para o XMB do RetroArch (D11), gerado de theme/lume/ pelo generate.py.
# O orquestrador monta theme/lume em /theme e o catálogo em /catalog.
# Ao mudar o tema ou o catálogo, suba o pkgrel.
pkgname=retroarch-theme-lume
pkgver=1.0
pkgrel=1
_lucide=1.70.0
pkgdesc="Tema Lume (Plus Jakarta Sans, Lucide, Aurora) para o XMB do Lume Retro OS"
url="https://github.com/lucide-icons/lucide"
arch="noarch"
license="OFL-1.1 AND ISC AND custom"
makedepends="python3 py3-pillow"
options="!check"
source="lucide-static-$_lucide.tgz::https://registry.npmjs.org/lucide-static/-/lucide-static-$_lucide.tgz"
builddir="$srcdir"
_theme=${R36OS_THEME_DIR:-/theme}
_catalog=${R36OS_CATALOG:-/catalog/systems.json}

build() {
	python3 "$_theme"/generate.py \
		--out "$builddir"/out \
		--lucide "$srcdir"/package/font/lucide.ttf \
		--codepoints "$srcdir"/package/font/codepoints.json \
		--catalog "$_catalog" \
		--theme "$_theme"
}

package() {
	mkdir -p "$pkgdir"/usr/share/r36os/retroarch-assets
	cp -r "$builddir"/out/xmb "$pkgdir"/usr/share/r36os/retroarch-assets/
	install -Dm644 "$builddir"/out/licenses/OFL.txt "$builddir"/out/licenses/LUCIDE-LICENSE.txt \
		-t "$pkgdir"/usr/share/licenses/$pkgname/
}
sha512sums="
03d52063df20f7822e1d063bae5eff005c075fb4f5a8da73af28a6f8ac3908685d576493a1bb4163e89bfd9e38a21caa5c4241f3c82f5c501e27ceee38e1ca2f  lucide-static-1.70.0.tgz
"

#!/bin/sh
# Default mixer of each board, applied at every boot before the frontend. The ALSA state
# is not persisted (/ is an overlay on RAM), so each boot starts from the driver defaults.
#
# GA36 (A33, mainline sun8i-codec): the driver boots with the AIF1 -> DAC path switched
# off ("AIF1 Slot 0 Digital DAC") and "AIF1 DA0" at 0. DAPM then sees no complete path
# to an output and keeps the codec AIF1 clock gated and in reset. The codec is the I2S
# bit-clock master, so the DAI FIFO never drains, the DMA stops after the first FIFO fill
# (hw_ptr stays at 32) and RetroArch blocks forever in snd_pcm_wait() as soon as a game
# writes audio: that was the "game freezes" of task 9.8.
#
# Volume (device-fixes D9, task 7.2): the user level of the output (level-<output>, see
# volume.sh) is applied to the volume control of the board, the one lume-input moves:
#  - GA36: the analog "Headphone" (0-63, 1 dB per step, 63 = 0 dB; 100% is 54, the loudest
#    clean one on the speaker; it also feeds the speaker amplifier),
#    with its switch off at 0% (mute) and on otherwise; the digital "DAC" stays at 0 dB
#    (160) and on; the "Speaker" amplifier switch is off at 0% too (it hisses otherwise)
#    and on at any other level. One level, "speaker" (the jack switch is mechanical). Without a level
#    file: the one-time conversion of the old volume, the DAC, while it holds a level of the
#    old system (not at 0 dB, e.g. a restart by "lume push --hot"); else 70%.
#  - R36S: the digital "Master" of the RK817 (0-255, 255 = 0 dB) until task 7.1, with the
#    speaker level (the jack service applies the headphones one on insertion); 70% without
#    a file, as the jack service.
# The file is not written here (no card write on the boot path): lume-input and the
# launcher write it on the first change.
#
# Environment for the tests: BOARD_FILE (default /etc/lume/board), AMIXER (default amixer),
# LEVEL_DIR (default /storage/system/audio), AUDIO_LIBDIR (volume.sh, default this folder).
BOARD_FILE=${BOARD_FILE:-/etc/lume/board}
AMIXER=${AMIXER:-amixer}
. "${AUDIO_LIBDIR:-${0%/*}}/volume.sh"
board=$(cat "$BOARD_FILE" 2>/dev/null)
rc=0

set_ctl() {  # <card> <simple control> <value...>
	local card="$1" ctl="$2"
	shift 2
	if "$AMIXER" -c "$card" -q sset "$ctl" "$@" >/dev/null 2>&1; then
		echo "mixer: $ctl = $*"
	else
		echo "mixer: FAILED to set $ctl = $* on card $card"
		rc=1
	fi
}

case "$board" in
	ga36)
		c=GA36MB
		set_ctl "$c" 'AIF1 Slot 0 Digital DAC' on
		# digital volumes: -120 dB + 0.75 dB per step, so 160 = 0 dB
		set_ctl "$c" 'AIF1 DA0' 160
		pct=$(level_read speaker) from=level-speaker
		if [ -z "$pct" ]; then
			old=$(ctl_raw "$AMIXER" "$c" DAC)
			if [ -n "$old" ] && [ "$old" != 160 ]; then
				pct=$(vol_pct_from_raw 0 160 750 "$old") from="old DAC $old"
			else
				pct=$VOL_DEFAULT_PCT from=default
			fi
		fi
		echo "mixer: speaker level $pct% ($from)"
		set_ctl "$c" 'DAC' 160 on
		set_ctl "$c" 'Headphone Source' DAC
		if [ "$pct" -gt 0 ]; then sw=on; else sw=off; fi
		set_ctl "$c" 'Headphone' "$(vol_raw 0 54 1000 "$pct")" "$sw"
		# the amplifier switch follows the level (task 7.5, "mixer_amp Speaker" in the
			# lume-input profile): off at 0% or it hisses, on otherwise
			set_ctl "$c" 'Speaker' "$sw"
		;;
	r36s)
		# R36S (RK817 codec, simple-audio-card "rk817_int"): the speaker output and the
		# left headphone pin are the same inside the codec, so "Playback Mux" picks one;
		# the speaker at boot, the jack service switches it on headphone insertion (D10).
		# Only "Internal Speakers" is a pin switch in the DTS; the headphone widget has
		# no switch on the real card (first boot on the R36S, 2026-11-12).
		c=rk817int
		set_ctl "$c" 'Playback Mux' SPK
		pct=$(level_read speaker) from=level-speaker
		[ -z "$pct" ] && pct=$VOL_DEFAULT_PCT from=default
		echo "mixer: speaker level $pct% ($from)"
		set_ctl "$c" 'Master' "$(vol_raw 0 255 373 "$pct")"
		set_ctl "$c" 'Internal Speakers' on
		;;
	*)
		echo "mixer: no defaults for board '${board:-unknown}'"
		;;
esac
exit "$rc"

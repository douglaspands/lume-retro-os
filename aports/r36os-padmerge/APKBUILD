c36a9bcd3fce4058e85156b4b02b0971963b28e192d149e17dca2e2fd487571e6debc69f1344bb150da495c2a4d7ae17c7fc888e2508cc0c0b9ab511d883b31e  r36os-padmerge.initd
05ab00782eae719f90fc7444198ab696a9679ac1378a8b3e94f9c89e9e9136e277a97aba5683205905b3fd0a745434e4a12033f3fabcbeed3d6733fe624680f5  61-r36os-padmerge.rules
"

# Lume Retro OS: one gamepad for the R36S. Joins the built-in buttons (gpio-keys) and the
# sticks (adc-joystick behind the SARADC mux) into "R36S Gamepad" through uinput, before
# the frontend starts (r36s-single-card, design D8). Only the R36S needs it, so it is built
# for aarch64 only and listed in board/r36s/hw-packages.txt.
pkgname=r36os-padmerge
pkgver=1.0
pkgrel=0
pkgdesc="Join the R36S buttons and sticks into one gamepad (Lume Retro OS)"
url="https://example.invalid"
arch="aarch64"
license="GPL-2.0-or-later"
depends="openrc"
makedepends="linux-headers" # linux/input.h and linux/uinput.h
options="!check" # tested on the host and in the VM with fake uinput devices
source="padmerge.c
	r36os-padmerge.initd
	61-r36os-padmerge.rules
	"
builddir="$srcdir"

build() {
	${CC:-cc} $CFLAGS $LDFLAGS -Wall -Wextra -Werror -o r36os-padmerge padmerge.c
}

package() {
	install -Dm755 r36os-padmerge "$pkgdir"/usr/bin/r36os-padmerge
	install -Dm755 "$srcdir"/r36os-padmerge.initd "$pkgdir"/etc/init.d/r36os-padmerge
	install -Dm644 "$srcdir"/61-r36os-padmerge.rules \
		"$pkgdir"/usr/lib/udev/rules.d/61-r36os-padmerge.rules
}

sha512sums="

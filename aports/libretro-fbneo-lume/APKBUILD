# Baseado em testing/libretro-fbneo do Alpine edge (David Demelier),
# atualizado para o master atual (zlib embutido do próprio FBNeo).
pkgname=libretro-fbneo-lume
pkgver=0_git20261108
pkgrel=0
_commit="77016b4dff6c76beba08d24ea1c61ed2750bc0a7"
pkgdesc="FinalBurn Neo, an Emulator for Arcade Games & Select Consoles (Lume build)"
url="https://github.com/libretro/FBNeo"
arch="all"

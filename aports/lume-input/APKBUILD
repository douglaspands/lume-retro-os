# Lume Retro OS: the input daemon (lume-launcher D8; it grew out of lume-padmerge). Grabs
# the built-in controls of the console, publishes one virtual gamepad under the name the
# RetroArch autoconfig knows, turns Fn+Start into "quit" for the launcher and handles the
# volume buttons. One profile per board in /usr/share/lume/input/.
# Also lume-shot (lume-launcher D12): a PNG of the screen through DRM, used over the cable,
# and lume-evrec (virtual-gamepad D2): record and replay the virtual gamepad, as root.
pkgname=lume-input
pkgver=1.0
pkgrel=11
pkgdesc="Built-in controls of the console: one gamepad, Fn+Start and volume (Lume Retro OS)"
url="https://example.invalid"
arch="x86_64 armv7 aarch64"
license="GPL-2.0-or-later"
depends="openrc alsa-utils"
# linux/input.h, linux/uinput.h and the DRM uapi headers; zlib for the PNG of lume-shot
makedepends="linux-headers zlib-dev"
options="!check" # tested on the host (tests/unit/test_lume_input.py, test_lume_shot.py,
                 # test_lume_evrec.py)
replaces="lume-padmerge"
provides="lume-padmerge=$pkgver-r$pkgrel"
source="input.c
	shot.c
	evrec.c
	lume-input.initd
	61-lume-input.rules
	ga36.conf
	r36s.conf
	vm.conf
	"
builddir="$srcdir"

build() {
	${CC:-cc} $CFLAGS $LDFLAGS -Wall -Wextra -Werror -o lume-input input.c
	${CC:-cc} $CFLAGS $LDFLAGS -Wall -Wextra -Werror -o lume-shot shot.c -lz
	${CC:-cc} $CFLAGS $LDFLAGS -Wall -Wextra -Werror -o lume-evrec evrec.c
}

package() {
	install -Dm755 lume-input "$pkgdir"/usr/bin/lume-input
	install -Dm755 lume-shot "$pkgdir"/usr/bin/lume-shot
	install -Dm755 lume-evrec "$pkgdir"/usr/bin/lume-evrec
	install -Dm755 "$srcdir"/lume-input.initd "$pkgdir"/etc/init.d/lume-input
	install -Dm644 "$srcdir"/61-lume-input.rules \
		"$pkgdir"/usr/lib/udev/rules.d/61-lume-input.rules
	for p in ga36 r36s vm; do
		install -Dm644 "$srcdir"/$p.conf "$pkgdir"/usr/share/lume/input/$p.conf
	done
}


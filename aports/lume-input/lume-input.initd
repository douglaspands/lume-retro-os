#!/sbin/openrc-run
# Input daemon of the console (lume-launcher D8): one virtual gamepad from the built-in
# controls, the Fn+Start combo for the launcher and the volume buttons, before the frontend.
# The profile is the one of the board (/etc/lume/board).

description="Built-in controls: one gamepad, Fn+Start and volume"
supervisor="supervise-daemon"
command="/usr/bin/lume-input"
command_args="--profile /usr/share/lume/input/$(cat /etc/lume/board 2>/dev/null).conf"
respawn_delay=2
respawn_max=5
# above the game (nice -5, game-governor D13): Fn+Start must end a hung game
nice=-10

depend() {
	need udev
	after udev-settle
	before frontend lume-hwsummary
}

#!/sbin/openrc-run
# Listas de jogos do RetroArch geradas de roms/ e do catálogo, a cada boot.

description="Game playlists"

depend() {
	need localmount
	after r36os-persist
	before frontend
}

start() {
	ebegin "Generating game playlists"
	if mountpoint -q /storage; then
		/usr/bin/r36os-playlists
		chown -R game:game /home/game/.config/retroarch/playlists
	fi
	eend 0
}

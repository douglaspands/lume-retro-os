#!/sbin/openrc-run
# Resumo de hardware (vídeo, áudio, controle, bateria, ROMS) antes do frontend.

description="Hardware summary"

depend() {
	after udev-settle alsa seatd r36os-persist r36os-savesync r36os-playlists
	before frontend
}

start() {
	ebegin "Hardware summary"
	/usr/libexec/r36os/hwsummary
	eend 0
}

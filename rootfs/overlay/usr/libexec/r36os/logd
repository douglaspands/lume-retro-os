#!/bin/sh
# r36os-logd (D14): logs de diagnóstico em ROMS/logs/.
#
#   logd start  contador de boot, desligamento anterior (limpo ou abrupto), logs.conf
#               com os padrões e eventos do boot (ROMS, kernel)
#   logd run    laço: retrato do hardware (uma vez), métricas a cada interval s e
#               descarga em lote a cada flush s
#   logd flush  descarga imediata (usada pelo self-test e pela sessão)
#   logd stop   descarga final e marcador de desligamento limpo
. /usr/libexec/r36os/lib.sh
. /usr/libexec/r36os/logs.sh

CLEAN_MARK=$LOGS_DIR/.clean
COUNTER=$LOGS_DIR/.boot

cmd_start() {
	local prev n
	mkdir -p "$LOGS_RAM"
	n=0
	if logs_on_disk; then
		mkdir -p "$LOGS_DIR/boot" "$LOGS_DIR/hw" "$LOGS_DIR/metrics" "$LOGS_DIR/frontend"
		if [ ! -f "$LOGS_CONF" ]; then
			mkdir -p "$(dirname "$LOGS_CONF")"
			printf '%s\n' "$LOGS_CONF_DEFAULT" > "$LOGS_CONF"
		fi
		prev=$(tr -cd '0-9' < "$COUNTER" 2>/dev/null)
		n=$(( ${prev:-0} + 1 ))
		echo "$n" > "$COUNTER.tmp" && fsync "$COUNTER.tmp" 2>/dev/null && mv -f "$COUNTER.tmp" "$COUNTER"
		echo "$n" > "$LOGS_RAM/boot-n"
		if [ -n "$prev" ]; then
			if [ -f "$CLEAN_MARK" ]; then
				event shutdown OK "previous clean (boot $prev)"
			else
				event shutdown FAIL "previous abrupt (boot $prev): power loss or crash"
			fi
		fi
		rm -f "$CLEAN_MARK"
	else
		echo 0 > "$LOGS_RAM/boot-n"
		event logs FAIL "no ROMS: logs in RAM only for this boot"
	fi
	logs_conf
	event boot OK "started: $(board) kernel $(uname -r) boot_id=$(cat /proc/sys/kernel/random/boot_id)"

	# ROMS (mensagens do initramfs no dmesg)
	dmesg | sed -n 's/.*lume: \(ROMS partition created.*\)/\1/p' | while read -r l; do event roms OK "$l"; done
	dmesg | sed -n 's/.*lume: ROMS checked: \(.*\)/\1/p' | while read -r l; do event roms OK "checked: $l"; done
	dmesg | sed -n 's/.*lume: \(ERROR.*\)/\1/p' | while read -r l; do event boot FAIL "$l"; done
	# Erros do kernel neste boot (nível err ou pior): contagem e os 3 primeiros
	local errs
	errs=$(dmesg -l err,crit,alert,emerg 2>/dev/null)
	if [ -n "$errs" ]; then
		event kernel FAIL "$(echo "$errs" | wc -l) error message(s); first: $(echo "$errs" | head -n 3 | sed 's/^\[[^]]*\] *//' | tr '\n' '|')"
	else
		event kernel OK "no error messages"
	fi
	logs_flush
}

# Colunas variáveis do CSV, descobertas uma vez por boot
ZONES="" POLICIES="" CPUS="" BAT=""
discover() {
	local z p c ps
	for z in /sys/class/thermal/thermal_zone*; do [ -r "$z/temp" ] && ZONES="$ZONES $z"; done
	for p in /sys/devices/system/cpu/cpufreq/policy*; do [ -r "$p/scaling_cur_freq" ] && POLICIES="$POLICIES $p"; done
	CPUS=$(sed -n 's/^cpu\([0-9][0-9]*\) .*/\1/p' /proc/stat | tr '\n' ' ')
	for ps in /sys/class/power_supply/*; do
		[ "$(cat "$ps/type" 2>/dev/null)" = Battery ] && { BAT=$ps; break; }
	done
	{
		printf 'time,uptime_s'
		for z in $ZONES; do printf ',temp_%s_c' "$(cat "$z/type" 2>/dev/null | tr -c 'a-zA-Z0-9_\n' '_')"; done
		for p in $POLICIES; do printf ',freq_%s_mhz' "${p##*/}"; done
		for c in $CPUS; do printf ',cpu%s_pct' "$c"; done
		printf ',mem_avail_mb,swap_used_mb,bat_pct,bat_mv,bat_ma,bat_status,frontend,core,content\n'
	} > "$LOGS_RAM/metrics.header"
}

# Primeiro trip passivo de cada zona (°C), para o evento de temperatura
passive_trip() {  # zona
	local t
	for t in "$1"/trip_point_*_type; do
		[ "$(cat "$t" 2>/dev/null)" = passive ] || continue
		echo $(( $(cat "${t%_type}_temp") / 1000 ))
		return
	done
}

# Estado do frontend pelo comando de rede local (GET_STATUS)
FE_STATE="" FE_CORE="" FE_CONTENT=""
frontend_state() {
	local r st rest
	FE_CORE="" FE_CONTENT=""
	if ! pidof retroarch >/dev/null 2>&1; then
		# outro frontend instalado em /usr/libexec/r36os/frontends/, ou nenhum
		if pgrep -f /usr/libexec/r36os/frontends/ >/dev/null 2>&1; then
			FE_STATE=other
		else
			FE_STATE=stopped
		fi
		return
	fi
	r=$(printf GET_STATUS | nc -u -w1 127.0.0.1 55355 2>/dev/null)
	set -- $r
	st=${2:-}
	case "$st" in
	PLAYING|PAUSED)
		FE_STATE=game
		[ "$st" = PAUSED ] && FE_STATE=paused
		rest=${r#GET_STATUS $st }
		FE_CORE=${rest%%,*}
		rest=${rest#*,}
		FE_CONTENT=${rest%,crc32=*}
		;;
	CONTENTLESS) FE_STATE=menu ;;
	*) FE_STATE=no_answer ;;
	esac
}

csv_field() { printf '%s' "$1" | tr ',\n' ';;'; }

GAME_KEY="" GAME_CORE="" GAME_CONTENT="" GAME_T0=0
HOT_ZONES="" BAT_LOW=0
sample() {
	local now up z t trip p c line mem swap bpct bmv bma bst cpus
	now=$(date '+%Y-%m-%dT%H:%M:%S')
	up=$(cut -d' ' -f1 /proc/uptime)
	line="$now,$up"
	for z in $ZONES; do
		t=$(cat "$z/temp" 2>/dev/null)
		line="$line,$(awk -v t="${t:-0}" 'BEGIN{printf "%.1f", t/1000}')"
		trip=$(passive_trip "$z")
		if [ -n "$trip" ] && [ -n "$t" ]; then
			if [ $((t / 1000)) -ge "$trip" ]; then
				case " $HOT_ZONES " in *" $z "*) ;; *)
					HOT_ZONES="$HOT_ZONES $z"
					event temperature FAIL "$(cat "$z/type") $((t / 1000)) °C, above passive trip of $trip °C" ;;
				esac
			elif [ $((t / 1000)) -le $((trip - 5)) ]; then
				case " $HOT_ZONES " in *" $z "*)
					HOT_ZONES=$(echo "$HOT_ZONES" | sed "s| $z||")
					event temperature OK "$(cat "$z/type") back to $((t / 1000)) °C" ;;
				esac
			fi
		fi
	done
	for p in $POLICIES; do line="$line,$(( $(cat "$p/scaling_cur_freq" 2>/dev/null || echo 0) / 1000 ))"; done
	# Ocupação por núcleo: diferença de /proc/stat desde a amostra anterior
	cpus=$(awk -v prev="$LOGS_RAM/stat.prev" '
		BEGIN { while ((getline l < prev) > 0) { split(l, a, " "); pt[a[1]] = a[2]; pi[a[1]] = a[3] } }
		/^cpu[0-9]/ { tot = 0; for (i = 2; i <= NF; i++) tot += $i; idle = $5 + $6
			out = out sprintf(",%.0f", (tot - pt[$1]) > 0 ? 100 * (1 - (idle - pi[$1]) / (tot - pt[$1])) : 0)
			now = now $1 " " tot " " idle "\n" }
		END { printf "%s", now > prev; print out }' /proc/stat)
	line="$line$cpus"
	mem=$(awk '/^MemAvailable:/{a=$2} /^SwapTotal:/{st=$2} /^SwapFree:/{sf=$2} END{printf "%d,%d", a/1024, (st-sf)/1024}' /proc/meminfo)
	line="$line,$mem"
	bpct="" bmv="" bma="" bst=""
	if [ -n "$BAT" ]; then
		bpct=$(cat "$BAT/capacity" 2>/dev/null)
		bmv=$(( $(cat "$BAT/voltage_now" 2>/dev/null || echo 0) / 1000 ))
		bma=$(( $(cat "$BAT/current_now" 2>/dev/null || echo 0) / 1000 ))
		bst=$(cat "$BAT/status" 2>/dev/null)
		if [ -n "$bpct" ]; then
			if [ "$bpct" -lt 10 ] && [ $BAT_LOW = 0 ]; then
				BAT_LOW=1; event battery FAIL "below 10% ($bpct%, $bmv mV, $bst)"
			elif [ "$bpct" -gt 15 ]; then BAT_LOW=0; fi
		fi
	fi
	line="$line,$bpct,$bmv,$bma,$bst"
	frontend_state
	line="$line,$FE_STATE,$(csv_field "$FE_CORE"),$(csv_field "$FE_CONTENT")"
	echo "$line" >> "$LOGS_RAM/metrics.pending"

	# Jogo aberto/fechado (a pausa no menu continua sendo o mesmo jogo)
	local key=""
	case "$FE_STATE" in game|paused) key="$FE_CORE|$FE_CONTENT" ;; esac
	if [ "$key" != "$GAME_KEY" ]; then
		if [ -n "$GAME_KEY" ]; then
			event game OK "closed: core=$GAME_CORE content=$GAME_CONTENT duration=$(( ${up%.*} - GAME_T0 ))s"
		fi
		if [ -n "$key" ]; then
			GAME_CORE=$FE_CORE GAME_CONTENT=$FE_CONTENT GAME_T0=${up%.*}
			event game OK "opened: core=$FE_CORE content=$FE_CONTENT"
		fi
		GAME_KEY=$key
	fi
}

# Retrato do hardware deste boot (hw/boot-<n>.txt), depois que o frontend sobe
hw_snapshot() {
	local out="$LOGS_RAM/hw.txt" n
	n=$(boot_n)
	# espera o frontend (até 60 s) para medir o tempo até ele
	local i=0
	while [ $i -lt 60 ] && ! dmesg | grep -q "lume: frontend started"; do sleep 1; i=$((i + 1)); done
	/usr/libexec/r36os/hwinfo > "$out" 2>&1
	if logs_on_disk; then atomic_copy "$out" "$LOGS_DIR/hw/boot-$n.txt"; fi
}

cmd_run() {
	logs_conf
	local last_flush=0 now
	trap 'logs_flush; exit 0' TERM INT
	if [ "$LOG_ENABLE" = 1 ]; then
		discover
		: > "$LOGS_RAM/stat.prev"
		hw_snapshot
	fi
	while :; do
		[ "$LOG_ENABLE" = 1 ] && sample
		now=$(cut -d. -f1 /proc/uptime)
		if [ $((now - last_flush)) -ge "$LOG_FLUSH" ]; then
			logs_flush
			last_flush=$now
		fi
		sleep "$LOG_INTERVAL" &
		wait $!
	done
}

cmd_stop() {
	event shutdown OK "clean"
	logs_flush
	logs_on_disk && { : > "$CLEAN_MARK"; fsync "$CLEAN_MARK" 2>/dev/null; sync; }
	return 0
}

case "$1" in
start) cmd_start ;;
run) cmd_run ;;
flush) logs_conf; logs_flush ;;
stop) cmd_stop ;;
*) echo "usage: $0 start|run|flush|stop" >&2; exit 2 ;;
esac

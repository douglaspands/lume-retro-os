#!/bin/sh
# r36os-persist (D7): persistência seletiva da configuração do RetroArch.
#
#   persist restore   no boot: semente de fábrica, cartão -> RAM, fuso e hostname
#   persist watch     daemon: inotifyd + debounce de 2 s, RAM -> cartão (atômico)
#   persist flush     sincroniza tudo agora (antes de desligar)
#
# O RetroArch grava em ~game/.config/retroarch, na camada em RAM. Só esta pasta,
# system/etc/timezone e system/etc/hostname persistem em ROMS/system/.
. "${PERSIST_LIBSH:-/usr/libexec/r36os/lib.sh}"

# Os PERSIST_* só são trocados pelos testes.
RAM=${PERSIST_RAM:-/home/game/.config/retroarch}
SYS=${PERSIST_SYS:-/storage/system}
CARD=$SYS/retroarch
FACTORY=${PERSIST_FACTORY:-/usr/share/r36os/factory/retroarch}
DIRTY=$R36OS_RUN/persist.dirty
DEBOUNCE=2

storage_ok() { mountpoint -q "${PERSIST_MOUNT:-/storage}"; }

# The build language (r36os build --lang) is only the factory default: it reaches a card
# through the factory config seeded below, on a card with no configuration yet. The menu
# language the user picks is never overwritten by a later build.
restore() {
	mkdir -p "$RAM"
	if storage_ok; then
		if [ ! -d "$CARD" ]; then
			log "factory RetroArch configuration (ROMS/system/ missing)"
			mirror "$FACTORY" "$CARD"
			mkdir -p "$SYS/etc"
			sync
		fi
		cp -a "$CARD/." "$RAM/"
	else
		log "no ROMS: factory configuration in RAM only"
		cp -a "$FACTORY/." "$RAM/"
	fi
	chown -R game:game /home/game/.config

	local tz host
	tz=$(head -n1 "$SYS/etc/timezone" 2>/dev/null | tr -cd 'A-Za-z0-9/_+-')
	if [ -n "$tz" ] && [ -f "/usr/share/zoneinfo/$tz" ]; then
		ln -sf "/usr/share/zoneinfo/$tz" /etc/localtime
		echo "$tz" > /etc/timezone
		log "timezone: $tz"
	elif [ -n "$tz" ]; then
		log "unknown timezone in system/etc/timezone: $tz"
	fi
	host=$(head -n1 "$SYS/etc/hostname" 2>/dev/null | tr -cd 'A-Za-z0-9-')
	if [ -n "$host" ]; then
		hostname "$host"
		echo "$host" > /etc/hostname
		log "hostname: $host"
	fi
}

flush() {
	storage_ok || return 0
	rm -f "$DIRTY"
	mirror "$RAM" "$CARD"
	sync
}

# Chamado a cada segundo pelo watch_tree: sincroniza 2 s depois da última mudança.
tick() {
	[ -e "$DIRTY" ] || return 0
	local now last
	now=$(date +%s)
	last=$(stat -c %Y "$DIRTY" 2>/dev/null) || return 0
	[ $((now - last)) -ge $DEBOUNCE ] && flush
	return 0
}

[ -n "${PERSIST_LIB:-}" ] && return 0   # testes: só as funções

case "$1" in
restore) restore ;;
flush) flush ;;
watch)
	storage_ok || exit 0
	WATCH_TICK=tick
	WATCH_NAME=persist
	watch_tree /usr/libexec/r36os/persist-event wymnd "$RAM"
	;;
*) echo "usage: $0 restore|watch|flush" >&2; exit 2 ;;
esac

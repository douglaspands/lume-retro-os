#!/bin/sh
# r36os-persist (D7): persistência seletiva da configuração do RetroArch.
#
#   persist restore   no boot: semente de fábrica, cartão -> RAM, fuso e hostname
#   persist watch     daemon: inotifyd + debounce de 2 s, RAM -> cartão (atômico)
#   persist flush     sincroniza tudo agora (antes de desligar)
#
# O RetroArch grava em ~game/.config/retroarch, na camada em RAM. Só esta pasta,
# system/etc/timezone e system/etc/hostname persistem em ROMS/system/.
. "${PERSIST_LIBSH:-/usr/libexec/r36os/lib.sh}"

# Os PERSIST_* só são trocados pelos testes.
RAM=${PERSIST_RAM:-/home/game/.config/retroarch}
SYS=${PERSIST_SYS:-/storage/system}
CARD=$SYS/retroarch
FACTORY=${PERSIST_FACTORY:-/usr/share/r36os/factory/retroarch}
BUILD_LANG=${PERSIST_BUILD_LANG:-/etc/r36os/language}
DIRTY=$R36OS_RUN/persist.dirty
DEBOUNCE=2

storage_ok() { mountpoint -q "${PERSIST_MOUNT:-/storage}"; }

# user_language de um retroarch.cfg (vazio se não houver)
cfg_language() {
	sed -n 's/^user_language *= *"\{0,1\}\([0-9][0-9]*\)"\{0,1\} *$/\1/p' "$1" 2>/dev/null | tail -n 1
}

# O idioma do build (r36os build --lang) vale para cartões que já têm configuração:
# quando muda em relação ao último build que rodou no cartão (system/etc/language, ou
# ausente em cartões antigos), troca só o user_language da configuração do usuário. Com o
# mesmo idioma, a escolha feita no menu não é tocada. Devolve 0 se alterou a configuração.
lang_sync() {
	local want have fac cur
	want=$(head -n1 "$BUILD_LANG" 2>/dev/null | tr -cd 'A-Za-z_')
	[ -n "$want" ] || return 1
	have=$(head -n1 "$SYS/etc/language" 2>/dev/null | tr -cd 'A-Za-z_')
	[ "$want" = "$have" ] && return 1
	fac=$(cfg_language "$FACTORY/retroarch.cfg")
	cur=$(cfg_language "$RAM/retroarch.cfg")
	mkdir -p "$SYS/etc"
	if printf '%s\n' "$want" > "$SYS/etc/language.tmp.$$"; then
		fsync "$SYS/etc/language.tmp.$$" 2>/dev/null
		mv -f "$SYS/etc/language.tmp.$$" "$SYS/etc/language"
	fi
	[ -n "$fac" ] && [ -f "$RAM/retroarch.cfg" ] && [ "$cur" != "$fac" ] || return 1
	if [ -n "$cur" ]; then
		sed -i "s/^user_language *=.*/user_language = \"$fac\"/" "$RAM/retroarch.cfg"
	else
		printf 'user_language = "%s"\n' "$fac" >> "$RAM/retroarch.cfg"
	fi
	log "menu language set to the build language ($want): user_language $cur -> $fac"
	return 0
}

restore() {
	mkdir -p "$RAM"
	if storage_ok; then
		if [ ! -d "$CARD" ]; then
			log "factory RetroArch configuration (ROMS/system/ missing)"
			mirror "$FACTORY" "$CARD"
			mkdir -p "$SYS/etc"
			sync
		fi
		cp -a "$CARD/." "$RAM/"
		lang_sync && mirror "$RAM" "$CARD" && sync
	else
		log "no ROMS: factory configuration in RAM only"
		cp -a "$FACTORY/." "$RAM/"
	fi
	chown -R game:game /home/game/.config

	local tz host
	tz=$(head -n1 "$SYS/etc/timezone" 2>/dev/null | tr -cd 'A-Za-z0-9/_+-')
	if [ -n "$tz" ] && [ -f "/usr/share/zoneinfo/$tz" ]; then
		ln -sf "/usr/share/zoneinfo/$tz" /etc/localtime
		echo "$tz" > /etc/timezone
		log "timezone: $tz"
	elif [ -n "$tz" ]; then
		log "unknown timezone in system/etc/timezone: $tz"
	fi
	host=$(head -n1 "$SYS/etc/hostname" 2>/dev/null | tr -cd 'A-Za-z0-9-')
	if [ -n "$host" ]; then
		hostname "$host"
		echo "$host" > /etc/hostname
		log "hostname: $host"
	fi
}

flush() {
	storage_ok || return 0
	rm -f "$DIRTY"
	mirror "$RAM" "$CARD"
	sync
}

# Chamado a cada segundo pelo watch_tree: sincroniza 2 s depois da última mudança.
tick() {
	[ -e "$DIRTY" ] || return 0
	local now last
	now=$(date +%s)
	last=$(stat -c %Y "$DIRTY" 2>/dev/null) || return 0
	[ $((now - last)) -ge $DEBOUNCE ] && flush
	return 0
}

[ -n "${PERSIST_LIB:-}" ] && return 0   # testes: só as funções

case "$1" in
restore) restore ;;
flush) flush ;;
watch)
	storage_ok || exit 0
	WATCH_TICK=tick
	WATCH_NAME=persist
	watch_tree /usr/libexec/r36os/persist-event wymnd "$RAM"
	;;
*) echo "usage: $0 restore|watch|flush" >&2; exit 2 ;;
esac

#!/bin/sh
# Hardware summary before frontend: video, audio, gamepad, battery and ROMS.
# Each item outputs "ok" or "fail"; on VM battery appears as "absent" without failure.
. /usr/libexec/r36os/lib.sh
OUT=$R36OS_RUN/hwsummary
FAILS=0
: > "$OUT.tmp"

item() {  # name state detail
	[ "$2" = fail ] && FAILS=$((FAILS + 1))
	printf '  %-9s %-7s %s\n' "$1" "$2" "$3" | tee -a "$OUT.tmp"
}

# Video: DRM driver of card0 (GPU)
drv=""
[ -e /sys/class/drm/card0/device/driver ] && drv=$(basename "$(readlink /sys/class/drm/card0/device/driver)")
if [ -c /dev/dri/card0 ] && [ -n "$drv" ]; then
	item video ok "$drv ($(cat /sys/class/drm/card0-*/modes 2>/dev/null | head -n1))"
else
	item video fail "no /dev/dri/card0"
fi

# Audio: first ALSA card
card=$(sed -n 's/^ *0 \[[^]]*\]: *//p' /proc/asound/cards 2>/dev/null)
if [ -n "$card" ]; then item audio ok "$card"; else item audio fail "no ALSA card"; fi

# Gamepad: joystick, or keyboard (VM)
pad=$(awk '/^N: Name=/{n=$0; sub(/^N: Name="/,"",n); sub(/"$/,"",n)} /^H: Handlers=.*js[0-9]/{print n; exit}' /proc/bus/input/devices)
kbd=$(awk '/^N: Name=/{n=$0; sub(/^N: Name="/,"",n); sub(/"$/,"",n)} /^H: Handlers=.*kbd/ && /event/{print n; exit}' /proc/bus/input/devices)
if [ -n "$pad" ]; then
	item gamepad ok "$pad"
elif [ "$(board)" = vm ] && [ -n "$kbd" ]; then
	item gamepad ok "keyboard: $kbd"
else
	item gamepad fail "no game controller"
fi

# Battery
bat=""
for ps in /sys/class/power_supply/*; do
	[ "$(cat "$ps/type" 2>/dev/null)" = Battery ] && { bat=$ps; break; }
done
if [ -n "$bat" ]; then
	item battery ok "$(cat "$bat/capacity" 2>/dev/null)% ($(cat "$bat/status" 2>/dev/null))"
elif [ "$(board)" = vm ]; then
	item battery absent "VM without battery"
else
	item battery fail "no Battery power supply"
fi

# Games partition
if mountpoint -q /storage; then
	item ROMS ok "$(df -h /storage | awk 'NR==2{print $4 " free of " $2}')"
else
	item ROMS fail "games partition not mounted"
fi

mv "$OUT.tmp" "$OUT"
[ $FAILS -eq 0 ] && log "hardware summary: all ok" || log "hardware summary: $FAILS failed item(s)"
exit 0

#!/bin/sh
# Pin the GPU devfreq to its highest frequency (non-fatal: a failure only logs).
#
# Why: on the GA36 (Allwinner A33, Mali-400 with the lima driver) the GPU has no
# regulator in the device tree and runs under devfreq "simple_ondemand". It idles at the
# lowest operating point while the menu is shown, and the first heavy load (a game
# starting) would make devfreq change the GPU clock under load. The console freezes
# exactly at that moment, with the process alive and waiting; the clock change is the
# main suspect (not confirmed). Keeping the GPU at its boot-time frequency removes it.
# See task 9.8, docs/LOGS.md (trace/ gpu_mhz) and docs/referencia/ga36-emuelec/gpu.md.
#
# GPU_DEVFREQ_DIR is only replaced by the tests.

TAG=r36os-gpu
DIR=${GPU_DEVFREQ_DIR:-/sys/class/devfreq}

note() { logger -t "$TAG" "$*" 2>/dev/null; echo "lume: $*"; }

found=0
for d in "$DIR"/*; do
	[ -d "$d" ] || continue
	case "${d##*/}" in *gpu*) ;; *) continue ;; esac
	found=1
	freqs=$(cat "$d/available_frequencies" 2>/dev/null)
	if [ -z "$freqs" ]; then
		note "gpu devfreq ${d##*/}: no available_frequencies, left as is"
		continue
	fi
	# Highest frequency in Hz (numeric sort; the list is space separated)
	max=$(for f in $freqs; do echo "$f"; done | sort -n | tail -n 1)
	# max_freq first, so that min_freq never exceeds it
	echo "$max" > "$d/max_freq" 2>/dev/null
	if echo "$max" > "$d/min_freq" 2>/dev/null; then
		note "gpu devfreq ${d##*/}: pinned to $((max / 1000000)) MHz (was $(( $(cat "$d/cur_freq" 2>/dev/null || echo 0) / 1000000 )) MHz)"
	else
		note "gpu devfreq ${d##*/}: could not write min_freq, left as is"
	fi
done

[ "$found" = 1 ] || logger -t "$TAG" "no gpu devfreq device, nothing to pin" 2>/dev/null
exit 0

From: Douglas Panhota <douglaspands@gmail.com>
Date: Thu, 12 Nov 2026 22:00:00 -0300
Subject: [PATCH] Input: adc-joystick - invert with the range of the axis code

adc_joystick_invert() looks up the range of the axis with
input_abs_get_min/max(dev, axis), which take an ABS_* event code, but both
callers pass the channel index. The two only agree when channel i reports
event code i. On the R36S V5 the channels are ABS_X, ABS_RX, ABS_Y, ABS_RY:
the inverted ABS_Y (channel 2) took the range of ABS_Z, which the device
does not have (0..0), and was reported as 0 - raw, from -839 to -156
against a range of 180..800. RetroArch saw the left stick pinned at one end
and the menu took no other input.

Pass the event code of the axis.

diff --git a/drivers/input/joystick/adc-joystick.c b/drivers/input/joystick/adc-joystick.c
index ff44f99..ea58c6e 100644
--- a/drivers/input/joystick/adc-joystick.c
+++ b/drivers/input/joystick/adc-joystick.c
@@ -27,10 +27,10 @@ struct adc_joystick {
 };

 static int adc_joystick_invert(struct input_dev *dev,
-			       unsigned int axis, int val)
+			       unsigned int code, int val)
 {
-	int min = input_abs_get_min(dev, axis);
-	int max = input_abs_get_max(dev, axis);
+	int min = input_abs_get_min(dev, code);
+	int max = input_abs_get_max(dev, code);

 	return (max + min) - val;
 }
@@ -45,7 +45,7 @@ static void adc_joystick_poll(struct input_dev *input)
 		if (ret < 0)
 			return;
 		if (joy->axes[i].inverted)
-			val = adc_joystick_invert(input, i, val);
+			val = adc_joystick_invert(input, joy->axes[i].code, val);
 		input_report_abs(input, joy->axes[i].code, val);
 	}
 	input_sync(input);
@@ -95,7 +95,7 @@ static int adc_joystick_handle(const void *data, void *private)
 		else
 			val &= GENMASK(msb, 0);
 		if (joy->axes[i].inverted)
-			val = adc_joystick_invert(joy->input, i, val);
+			val = adc_joystick_invert(joy->input, joy->axes[i].code, val);
 		input_report_abs(joy->input, joy->axes[i].code, val);
 	}


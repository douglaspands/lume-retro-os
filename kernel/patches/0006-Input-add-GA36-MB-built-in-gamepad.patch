From f85f26cb6e48ebe6676d894ec7a14507d571cc8a Mon Sep 17 00:00:00 2001
From: Douglas Panhota <douglaspands@gmail.com>
Date: Mon, 9 Nov 2026 21:10:16 -0300
Subject: [PATCH 6/6] Input: add GA36-MB built-in gamepad

GPIO buttons plus the analog sticks microcontroller on a UART (serdev, 9600 baud), as one input device. The handshake follows the vendor udt_joystick.ko module. Port of the goodluckOS driver (GPL, commit 8d676e2327a6).
---
 drivers/input/joystick/Kconfig                |  11 +
 drivers/input/joystick/Makefile               |   1 +
 drivers/input/joystick/ga36mb-gamepad-proto.h | 108 ++++++++
 drivers/input/joystick/ga36mb-gamepad.c       | 237 ++++++++++++++++++
 4 files changed, 357 insertions(+)
 create mode 100644 drivers/input/joystick/ga36mb-gamepad-proto.h
 create mode 100644 drivers/input/joystick/ga36mb-gamepad.c

diff --git a/drivers/input/joystick/Kconfig b/drivers/input/joystick/Kconfig
index 7755e5b..889ab6c 100644
--- a/drivers/input/joystick/Kconfig
+++ b/drivers/input/joystick/Kconfig
@@ -74,6 +74,17 @@ config JOYSTICK_COBRA
 	  To compile this driver as a module, choose M here: the
 	  module will be called cobra.
 
+config JOYSTICK_GA36MB
+	tristate "GA36-MB built-in gamepad"
+	depends on OF && SERIAL_DEV_BUS
+	help
+	  Say Y here to use the built-in controls of the GA36-MB V1.2
+	  handheld: GPIO buttons plus the analog sticks microcontroller on a
+	  UART, presented as one input device.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called ga36mb-gamepad.
+
 config JOYSTICK_GF2K
 	tristate "Genius Flight2000 Digital joysticks and gamepads"
 	select GAMEPORT
diff --git a/drivers/input/joystick/Makefile b/drivers/input/joystick/Makefile
index 9976f59..74bb091 100644
--- a/drivers/input/joystick/Makefile
+++ b/drivers/input/joystick/Makefile
@@ -15,6 +15,7 @@ obj-$(CONFIG_JOYSTICK_COBRA)		+= cobra.o
 obj-$(CONFIG_JOYSTICK_DB9)		+= db9.o
 obj-$(CONFIG_JOYSTICK_FSIA6B)		+= fsia6b.o
 obj-$(CONFIG_JOYSTICK_GAMECON)		+= gamecon.o
+obj-$(CONFIG_JOYSTICK_GA36MB)		+= ga36mb-gamepad.o
 obj-$(CONFIG_JOYSTICK_GF2K)		+= gf2k.o

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Douglas Panhota <douglaspands@gmail.com>
Date: Mon, 16 Nov 2026 10:00:00 -0300
Subject: [PATCH] drm/panel: add a generic MIPI-DSI panel described in the
 device tree (ROCKNIX generic-dsi)

The vendor device trees of the R36S clones (RK3326) describe their panels
only as a Rockchip init sequence for simple-panel-dsi, a binding the
mainline kernel does not have. The Lume system converts those trees for
its kernel (boot-dtb-select D12), and the panel of a converted tree needs
a driver that takes the sequence, the modes and the delays from the
device tree.

This is a port of the ROCKNIX panel-generic-dsi driver (GPL-2.0, Danil
Zagoskin, ROCKNIX), which already runs those clones on mainline kernels,
with the same compatible (rocknix,generic-dsi) and the same text format
(panel_description), so the converted trees and the ROCKNIX ones stay
interchangeable. Changes from the ROCKNIX driver: the panel helpers of
this kernel (devm_drm_panel_alloc, the core tracks the prepared state),
modes and commands in arrays, a bad description line fails the probe, no
firmware file, and an error in the init sequence stops the prepare.

Added for Lume: the display ID (DCS DAh to DCh, one byte each) read once
after the reset, logged ("panel id: ...") and shown in the panel_id
attribute of the DSI device, as in the R36S V5 and GA36 panel drivers,
so the initramfs can learn which device tree fits the panel (D15).

Plus a binding for the compatible and the rocknix vendor prefix.

diff --git a/Documentation/devicetree/bindings/display/panel/rocknix,generic-dsi.yaml b/Documentation/devicetree/bindings/display/panel/rocknix,generic-dsi.yaml
new file mode 100644
index 0000000..a0fd123
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/rocknix,generic-dsi.yaml
@@ -0,0 +1,89 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/rocknix,generic-dsi.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MIPI-DSI video mode panel described by text (ROCKNIX generic DSI)
+
+maintainers:
+  - Douglas Panhota <douglaspands@gmail.com>
+
+description: |
+  A DSI panel whose link settings, video modes and init sequence are given as
+  text in the device tree, in the format of the ROCKNIX panel-generic-dsi
+  driver. Used for the panels of RK3326 handhelds whose vendor device trees
+  only carry a Rockchip init sequence (simple-panel-dsi), converted for the
+  mainline kernel.
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: rocknix,generic-dsi
+
+  reg:
+    maxItems: 1
+
+  panel_description:
+    $ref: /schemas/types.yaml#/definitions/string-array
+    description: |
+      One line per string. "G size=<w>,<h> delays=<prepare>,<reset>,<init>,
+      <enable>,<ready> format=<rgb888|rgb666|rgb666_packed|rgb565> lanes=<n>
+      flags=<MIPI DSI mode flags>" sets the link; each "M clock=<kHz>
+      horizontal=<active>,<front porch>,<sync>,<back porch> vertical=<...>
+      [default=1]" is a video mode; each "I seq=<hex bytes> [wait=<hex ms>]"
+      or "I dcs=<hex> data=<hex bytes> [wait=<hex ms>]" is a DCS write of the
+      init sequence. Text after '#' is a comment.
+    minItems: 2
+    maxItems: 512
+
+  vdd-supply:
+    description: panel power supply
+
+  iovcc-supply:
+    description: I/O power supply
+
+  reset-gpios: true
+
+  enable-gpios: true
+
+  backlight: true
+
+  rotation: true
+
+  port: true
+
+required:
+  - compatible
+  - reg
+  - panel_description
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "rocknix,generic-dsi";
+            reg = <0>;
+            vdd-supply = <&vcc_lcd>;
+            iovcc-supply = <&vcc_lcd>;
+            reset-gpios = <&gpio3 16 GPIO_ACTIVE_LOW>;
+            backlight = <&backlight>;
+            panel_description =
+                "G size=153,85 delays=100,100,20,200,20 format=rgb888 lanes=4 flags=0xe03",
+                "M clock=27000 horizontal=640,120,10,120 vertical=480,17,4,13 default=1",
+                "I seq=b9f11287",
+                "I seq=11 wait=fa",
+                "I seq=29 wait=32";
+        };
+    };
+
+...

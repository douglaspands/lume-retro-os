From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Douglas Panhota <douglaspands@gmail.com>
Date: Fri, 13 Nov 2026 23:30:00 -0300
Subject: [PATCH] usb: musb: gadget: keep an Rx packet that arrived before the request

Commit 3fc137386c46 ("usb: musb: Fix hardware lockup on first Rx endpoint
request") made musb_ep_restart() flush the Rx FIFO instead of calling
rxstate(), so that ->complete() never runs inside usb_ep_queue(). Its
message accepts that "one or two packets" may be dropped.

On the GA36-MB V1.2 (Allwinner A33) that loss breaks MTP. umtprd serves it
through FunctionFS with a blocking read(): one Rx request per command,
queued only after the previous answer was written. libmtp sends the next
command about 30 us after it reads an answer, before umtprd queued its
read, so the packet waits in the FIFO, its interrupt finds an empty queue,
and the flush in musb_ep_restart() throws it away. The host then waits
20 s for an answer to a command the device never saw ("Unable to read
device information", GNOME cannot mount the console). Measured from the
PC: OpenSession followed by GetDeviceInfo with no gap is lost on the first
try, every time; with a 5 ms gap, 50 of 50 are answered.

Keep the packet instead: when the FIFO already holds one, musb_ep_restart()
schedules a work item that takes the controller lock and runs musb_g_rx()
for every Rx endpoint with a queued request and RXPKTRDY set, the same
path as the Rx interrupt. ->complete() still never runs inside
usb_ep_queue().

Do not flush an FIFO that looked empty either: a packet landing between
the read of RXCSR and the flush was dropped too (a first version of this
patch kept that flush and lost 1 command in about 700 sent back to back).
A packet that arrives after the check finds the request queued and is
handled by the Rx interrupt, as before 3fc137386c46.

diff --git a/drivers/usb/musb/musb_core.h b/drivers/usb/musb/musb_core.h
index 91b5b6b..02872ef 100644
--- a/drivers/usb/musb/musb_core.h
+++ b/drivers/usb/musb/musb_core.h
@@ -288,6 +288,7 @@ struct musb {
 	struct delayed_work	deassert_reset_work;
 	struct delayed_work	finish_resume_work;
 	struct delayed_work	gadget_work;
+	struct work_struct	rx_pending_work;
 	u16			hwvers;

 	u16			intrrxe;
diff --git a/drivers/usb/musb/musb_gadget.c b/drivers/usb/musb/musb_gadget.c
index caf4d4c..10a7f77 100644
--- a/drivers/usb/musb/musb_gadget.c
+++ b/drivers/usb/musb/musb_gadget.c
@@ -1170,11 +1170,53 @@ void musb_ep_restart(struct musb *musb, struct musb_request *req)
 	if (req->tx) {
 		txstate(musb, req);
 	} else {
+		/*
+		 * A packet that arrived while the queue was empty is still in the
+		 * FIFO and its interrupt is gone. Flushing it loses it: a function
+		 * that queues one request at a time (FunctionFS with a blocking
+		 * read(), as umtprd does for MTP) then never sees the command the
+		 * host sent right after the previous answer, and the host waits
+		 * forever. Hand it to musb_g_rx() from a work item instead, so
+		 * ->complete() still never runs inside usb_ep_queue().
+		 *
+		 * With no packet waiting there is nothing to flush, and a flush
+		 * would drop a packet landing between the read of RXCSR and the
+		 * write: a later packet finds this request queued and is handled
+		 * by the Rx interrupt.
+		 */
 		csr = musb_readw(epio, MUSB_RXCSR);
-		csr |= MUSB_RXCSR_FLUSHFIFO | MUSB_RXCSR_P_WZC_BITS;
-		musb_writew(epio, MUSB_RXCSR, csr);
-		musb_writew(epio, MUSB_RXCSR, csr);
+		if (csr & MUSB_RXCSR_RXPKTRDY)
+			schedule_work(&musb->rx_pending_work);
+	}
+}
+
+/*
+ * Deliver the packets that musb_ep_restart() found waiting in an Rx FIFO,
+ * outside usb_ep_queue(), through the same path as the Rx interrupt.
+ */
+static void musb_g_rx_pending_work(struct work_struct *work)
+{
+	struct musb *musb = container_of(work, struct musb, rx_pending_work);
+	struct musb_hw_ep *hw_ep;
+	struct musb_ep *musb_ep;
+	unsigned long flags;
+	u8 epnum;
+
+	pm_runtime_get_sync(musb->controller);
+	spin_lock_irqsave(&musb->lock, flags);
+	for (epnum = 1; epnum < musb->nr_endpoints; epnum++) {
+		hw_ep = musb->endpoints + epnum;
+		musb_ep = hw_ep->is_shared_fifo ? &hw_ep->ep_in : &hw_ep->ep_out;
+		if (!musb_ep->desc || musb_ep->is_in || musb_ep->busy ||
+		    !next_request(musb_ep))
+			continue;
+		musb_ep_select(musb->mregs, epnum);
+		if (musb_readw(hw_ep->regs, MUSB_RXCSR) & MUSB_RXCSR_RXPKTRDY)
+			musb_g_rx(musb, epnum);
 	}
+	spin_unlock_irqrestore(&musb->lock, flags);
+	pm_runtime_mark_last_busy(musb->controller);
+	pm_runtime_put_autosuspend(musb->controller);
 }

 static int musb_ep_restart_resume_work(struct musb *musb, void *data)
@@ -1789,6 +1831,7 @@ int musb_gadget_setup(struct musb *musb)
 	/* don't support otg protocols */
 	musb->g.is_otg = 0;
 	INIT_DELAYED_WORK(&musb->gadget_work, musb_gadget_work);
+	INIT_WORK(&musb->rx_pending_work, musb_g_rx_pending_work);
 	musb_g_init_endpoints(musb);

 	musb->is_active = 0;
@@ -1811,6 +1854,7 @@ void musb_gadget_cleanup(struct musb *musb)
 		return;

 	cancel_delayed_work_sync(&musb->gadget_work);
+	cancel_work_sync(&musb->rx_pending_work);
 	usb_del_gadget_udc(&musb->g);
 }


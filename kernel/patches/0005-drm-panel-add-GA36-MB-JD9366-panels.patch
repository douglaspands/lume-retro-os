From acb89e31be139835a1fb5370ebf742dda35fafd8 Mon Sep 17 00:00:00 2001
From: Douglas Panhota <douglaspands@gmail.com>
Date: Mon, 9 Nov 2026 21:10:16 -0300
Subject: [PATCH 5/6] drm/panel: add GA36-MB JD9366 panels

Driver for the two 640x480 MIPI-DSI panel variants (Jadard JD9366) of the GA36-MB V1.2. The compatible selects the initialization sequence: panel 1 is the vendor lcd.ko table, panel 2 the goodluckOS sequence. Port of the goodluckOS driver (GPL-2.0, commit 8d676e2327a6).
---
 drivers/gpu/drm/panel/Kconfig               |  10 +
 drivers/gpu/drm/panel/Makefile              |   1 +
 drivers/gpu/drm/panel/panel-ga36mb-jd9366.c | 450 ++++++++++++++++++++
 3 files changed, 461 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-ga36mb-jd9366.c

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index 967265e..17bc5a0 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -145,6 +145,16 @@ config DRM_PANEL_FEIYANG_FY07024DI26A30D
 	  Say Y if you want to enable support for panels based on the
 	  Feiyang FY07024DI26A30-D MIPI-DSI interface.
 
+config DRM_PANEL_GA36MB_JD9366
+	tristate "GA36-MB JD9366 640x480 MIPI-DSI panels"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  Say Y if you want to enable support for the two 640x480 MIPI-DSI
+	  panel variants (Jadard JD9366 controller) of the GA36-MB V1.2
+	  handheld.
+
 config DRM_PANEL_DSI_CM
 	tristate "Generic DSI command mode panels"
 	depends on OF

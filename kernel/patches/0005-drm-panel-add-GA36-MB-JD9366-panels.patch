+struct jd9366_step {
+	u8 cmd;
+	u8 len;			/* 0 or 1 parameter */
+	u8 param;
+	u16 delay_ms;		/* not zero: sleep instead of sending */
+};
+
+#define JD9366_CMD(c, p)	{ .cmd = (c), .len = 1, .param = (p) }
+#define JD9366_CMD0(c)		{ .cmd = (c) }
+#define JD9366_DELAY(ms)	{ .delay_ms = (ms) }
+/* Register page select: FF 30 52 <page>, sent as three 1-parameter writes like the vendor */
+#define JD9366_PAGE(p)		JD9366_CMD(0xff, 0x30), JD9366_CMD(0xff, 0x52), JD9366_CMD(0xff, (p))
+
+struct jd9366_variant {
+	const struct jd9366_step *steps;
+	size_t count;
+};

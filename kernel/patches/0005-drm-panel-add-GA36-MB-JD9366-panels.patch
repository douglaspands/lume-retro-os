+/*
+ * Vendor FEX timing: 30 MHz, htotal 1040, hbp 120 and hsync 40, vtotal 518, vbp 12 and
+ * vsync 6. In the Allwinner counting hbp/vbp include the sync, so the back porch is
+ * hbp - hsync and the front porch is the rest.
+ */
+static const struct drm_display_mode jd9366_mode = {
+	.clock = 30000,
+	.hdisplay = 640,
+	.hsync_start = 640 + 280,
+	.hsync_end = 640 + 280 + 40,
+	.htotal = 1040,
+	.vdisplay = 480,
+	.vsync_start = 480 + 26,
+	.vsync_end = 480 + 26 + 6,
+	.vtotal = 518,
+	.flags = DRM_MODE_FLAG_NHSYNC | DRM_MODE_FLAG_NVSYNC,
+	.width_mm = 71,
+	.height_mm = 53,
+};
+
+static inline struct jd9366 *panel_to_jd9366(struct drm_panel *panel)
+{
+	return container_of(panel, struct jd9366, panel);
+}
+
+static int jd9366_send_init(struct jd9366 *ctx)
+{
+	struct mipi_dsi_device *dsi = to_mipi_dsi_device(ctx->dev);
+	size_t i;
+	int ret;
+
+	for (i = 0; i < ctx->variant->count; i++) {
+		const struct jd9366_step *step = &ctx->variant->steps[i];
+		u8 buf[2] = { step->cmd, step->param };
+
+		if (step->delay_ms) {
+			msleep(step->delay_ms);
+			continue;
+		}
+		ret = mipi_dsi_dcs_write_buffer(dsi, buf, step->len + 1);
+		if (ret < 0) {
+			dev_err(ctx->dev, "DCS write of 0x%02x failed: %d\n", step->cmd, ret);
+			return ret;
+		}
+	}
+	return 0;
+}
+
+static void jd9366_power_off(struct jd9366 *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	if (ctx->supply_on) {
+		regulator_disable(ctx->supply);
+		ctx->supply_on = false;
+	}
+}
+
+/* Supply on and a reset pulse: the panel is ready for commands afterwards */
+static int jd9366_power_on(struct jd9366 *ctx, unsigned int settle_ms)
+{
+	int ret;
+
+	ret = regulator_enable(ctx->supply);
+	if (ret < 0)
+		return ret;
+	ctx->supply_on = true;
+	msleep(settle_ms);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(10000, 15000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(settle_ms);
+	return 0;
+}
+
+static int jd9366_prepare(struct drm_panel *panel)
+{
+	struct jd9366 *ctx = panel_to_jd9366(panel);
+	int ret;
+
+	if (ctx->prepared)
+		return 0;
+
+	/*
+	 * Start from a cold panel: the bootloader may have left it lit, and the probe leaves
+	 * the supply on after its test read.
+	 */
+	if (ctx->supply_on) {
+		jd9366_power_off(ctx);
+		msleep(50);
+	}
+
+	ret = jd9366_power_on(ctx, 120);
+	if (ret < 0)
+		return ret;
+
+	ret = jd9366_send_init(ctx);
+	if (ret < 0) {
+		jd9366_power_off(ctx);
+		return ret;
+	}
+
+	ctx->prepared = true;
+	return 0;
+}
+
+static int jd9366_enable(struct drm_panel *panel)
+{
+	struct jd9366 *ctx = panel_to_jd9366(panel);
+
+	if (ctx->enabled)
+		return 0;
+	backlight_enable(ctx->backlight);
+	ctx->enabled = true;
+	return 0;
+}
+
+static int jd9366_disable(struct drm_panel *panel)
+{
+	struct jd9366 *ctx = panel_to_jd9366(panel);
+
+	if (!ctx->enabled)
+		return 0;
+	backlight_disable(ctx->backlight);
+	ctx->enabled = false;
+	return 0;
+}
+
+static int jd9366_unprepare(struct drm_panel *panel)
+{
+	struct jd9366 *ctx = panel_to_jd9366(panel);
+	struct mipi_dsi_device *dsi = to_mipi_dsi_device(ctx->dev);
+
+	if (!ctx->prepared)
+		return 0;
+
+	mipi_dsi_dcs_set_display_off(dsi);
+	mipi_dsi_dcs_enter_sleep_mode(dsi);
+	msleep(120);
+	jd9366_power_off(ctx);
+	ctx->prepared = false;
+	return 0;
+}
+
+static int jd9366_get_modes(struct drm_panel *panel, struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &jd9366_mode);
+}
+
+static const struct drm_panel_funcs jd9366_funcs = {
+	.prepare = jd9366_prepare,
+	.enable = jd9366_enable,
+	.disable = jd9366_disable,
+	.unprepare = jd9366_unprepare,
+	.get_modes = jd9366_get_modes,
+};
+
+/*
+ * Ask the panel for its power mode before registering it. A panel that never answers
+ * would otherwise be registered and every DCS write would time out, delaying the boot
+ * by minutes (goodluckOS). Retries with a fresh power cycle, as goodluckOS does.
+ */
+static int jd9366_check_bus(struct jd9366 *ctx, struct mipi_dsi_device *dsi)
+{
+	u8 mode;
+	int ret, i;
+
+	for (i = 0; i < 5; i++) {
+		ret = jd9366_power_on(ctx, 20);
+		if (ret < 0)
+			return ret;
+		ret = mipi_dsi_dcs_read(dsi, MIPI_DCS_GET_POWER_MODE, &mode, 1);
+		if (ret >= 0)
+			return 0;
+		jd9366_power_off(ctx);
+		msleep(20);
+	}
+	return ret;
+}
+
+static int jd9366_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct jd9366 *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct jd9366, panel, &jd9366_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->dev = dev;
+	ctx->variant = of_device_get_match_data(dev);
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio), "cannot get the reset GPIO\n");
+
+	ctx->supply = devm_regulator_get(dev, "power");
+	if (IS_ERR(ctx->supply))
+		return dev_err_probe(dev, PTR_ERR(ctx->supply), "cannot get the power supply\n");
+
+	ctx->backlight = devm_of_find_backlight(dev);
+	if (IS_ERR(ctx->backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->backlight), "cannot get the backlight\n");
+
+	mipi_dsi_set_drvdata(dsi, ctx);
+	dsi->lanes = 2;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_MODE_LPM | MIPI_DSI_CLOCK_NON_CONTINUOUS;
+	ctx->panel.prepare_prev_first = true;
+
+	ret = jd9366_check_bus(ctx, dsi);
+	if (ret < 0) {
+		dev_err(dev, "the panel does not answer on the DSI bus: %d\n", ret);
+		return -ENODEV;
+	}
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		dev_err(dev, "mipi_dsi_attach() failed: %d\n", ret);
+		drm_panel_remove(&ctx->panel);
+		jd9366_power_off(ctx);
+		return ret;
+	}
+	return 0;
+}
+
+static void jd9366_remove(struct mipi_dsi_device *dsi)
+{
+	struct jd9366 *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+	jd9366_power_off(ctx);
+}
+
+static const struct of_device_id jd9366_of_match[] = {
+	{ .compatible = "ga36mb,jd9366-panel1", .data = &jd9366_variant1 },
+	{ .compatible = "ga36mb,jd9366-panel2", .data = &jd9366_variant2 },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, jd9366_of_match);
+
+static struct mipi_dsi_driver jd9366_driver = {
+	.probe = jd9366_probe,
+	.remove = jd9366_remove,
+	.driver = {
+		.name = "panel-ga36mb-jd9366",
+		.of_match_table = jd9366_of_match,
+	},
+};
+module_mipi_dsi_driver(jd9366_driver);

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Douglas Panhota <douglaspands@gmail.com>
Date: Thu, 12 Nov 2026 18:00:00 -0300
Subject: [PATCH] drm/rockchip: dsi: board lane rate and transition times for an external PHY

With an external D-PHY (the Innosilicon PHY of PX30/RK3326) the glue
derives the lane rate from the mode (pixel clock x bpp / lanes x 10/8)
and hands the host the LP/HS transition times of hstt_table, which holds
the values of the internal Synopsys PHY of RK3399.

On the R36S V5 the factory kernel (4.4 BSP) runs the link at 180 Mbps and
programs PHY_TMR_LPCLK_CFG 0x00400040 and PHY_TMR_CFG 0x14102710 (clock
lane lp2hs/hs2lp 64/64, data lanes lp2hs/hs2lp 16/20), read back from the
running factory system. Mainline ran 198 Mbps with 40/22 and 33/15 and
the panel never shows the video.

Let the board give both, on the DSI node:
- rockchip,lane-rate: lane rate in Mbps (the property of the vendor kernel);
- rockchip,phy-hstt: <clk_lp2hs clk_hs2lp data_lp2hs data_hs2lp>, in lane
  byte clocks.
Without them nothing changes.

diff --git a/Documentation/devicetree/bindings/display/rockchip/rockchip,dw-mipi-dsi.yaml b/Documentation/devicetree/bindings/display/rockchip/rockchip,dw-mipi-dsi.yaml
--- a/Documentation/devicetree/bindings/display/rockchip/rockchip,dw-mipi-dsi.yaml
+++ b/Documentation/devicetree/bindings/display/rockchip/rockchip,dw-mipi-dsi.yaml
@@ -58,6 +58,22 @@ properties:
   power-domains:
     maxItems: 1

+  rockchip,lane-rate:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Lane rate in Mbps of the external D-PHY, for a board that needs a fixed
+      rate instead of the one worked out from the mode.
+
+  rockchip,phy-hstt:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    items:
+      - description: clock lane LP to HS time
+      - description: clock lane HS to LP time
+      - description: data lanes LP to HS time
+      - description: data lanes HS to LP time
+    description:
+      LP/HS transition times of an external D-PHY, in lane byte clocks.
+
 required:
   - compatible
   - clocks
diff --git a/drivers/gpu/drm/rockchip/dw-mipi-dsi-rockchip.c b/drivers/gpu/drm/rockchip/dw-mipi-dsi-rockchip.c
index f102039..35c0936 100644
--- a/drivers/gpu/drm/rockchip/dw-mipi-dsi-rockchip.c
+++ b/drivers/gpu/drm/rockchip/dw-mipi-dsi-rockchip.c
@@ -277,6 +277,10 @@ struct dw_mipi_dsi_rockchip {
 	/* optional external dphy */
 	struct phy *phy;
 	union phy_configure_opts phy_opts;
+	/* board overrides for the external dphy (0 / false: computed) */
+	u32 lane_rate_mbps;
+	bool has_hstt;
+	struct dw_mipi_dsi_dphy_timing hstt;

 	/* being a phy for other mipi hosts */
 	unsigned int usage_mode;
@@ -587,9 +591,15 @@ dw_mipi_dsi_get_lane_mbps(void *priv_data, const struct drm_display_mode *mode,

 	/* for external phy only a the mipi_dphy_config is necessary */
 	if (dsi->phy) {
-		phy_mipi_dphy_get_default_config(mode->clock * 1000 * 10 / 8,
-						 bpp, lanes,
-						 &dsi->phy_opts.mipi_dphy);
+		if (dsi->lane_rate_mbps)
+			/* board lane rate (rockchip,lane-rate), as the vendor kernel */
+			phy_mipi_dphy_get_default_config_for_hsclk(dsi->lane_rate_mbps * 1000000ULL,
+								   lanes,
+								   &dsi->phy_opts.mipi_dphy);
+		else
+			phy_mipi_dphy_get_default_config(mode->clock * 1000 * 10 / 8,
+							 bpp, lanes,
+							 &dsi->phy_opts.mipi_dphy);
 		/*
 		 * The host line timings are counted in lane byte clocks, so they must
 		 * use the rate the PHY really runs at, not the requested one. The
@@ -730,8 +740,18 @@ static int
 dw_mipi_dsi_phy_get_timing(void *priv_data, unsigned int lane_mbps,
 			   struct dw_mipi_dsi_dphy_timing *timing)
 {
+	struct dw_mipi_dsi_rockchip *dsi = priv_data;
 	int i;

+	/*
+	 * hstt_table holds the transition times of the internal Synopsys PHY; a board
+	 * with an external PHY can give its own (rockchip,phy-hstt).
+	 */
+	if (dsi->has_hstt) {
+		*timing = dsi->hstt;
+		return 0;
+	}
+
 	for (i = 0; i < ARRAY_SIZE(hstt_table); i++)
 		if (lane_mbps < hstt_table[i].maxfreq)
 			break;
@@ -1409,6 +1429,25 @@ static int dw_mipi_dsi_rockchip_probe(struct platform_device *pdev)
 		return ret;
 	}

+	if (dsi->phy) {
+		u32 hstt[4] = {};
+
+		/* lane rate in Mbps, the property of the vendor kernel */
+		of_property_read_u32(np, "rockchip,lane-rate", &dsi->lane_rate_mbps);
+		/* <clk_lp2hs clk_hs2lp data_lp2hs data_hs2lp>, in lane byte clocks */
+		if (!of_property_read_u32_array(np, "rockchip,phy-hstt", hstt, 4)) {
+			dsi->hstt.clk_lp2hs = hstt[0];
+			dsi->hstt.clk_hs2lp = hstt[1];
+			dsi->hstt.data_lp2hs = hstt[2];
+			dsi->hstt.data_hs2lp = hstt[3];
+			dsi->has_hstt = true;
+		}
+		if (dsi->lane_rate_mbps || dsi->has_hstt)
+			DRM_DEV_INFO(dev, "board dphy: lane rate %u Mbps, hstt %s %u %u %u %u\n",
+				     dsi->lane_rate_mbps, dsi->has_hstt ? "set" : "table",
+				     hstt[0], hstt[1], hstt[2], hstt[3]);
+	}
+
 	dsi->pclk = devm_clk_get(dev, "pclk");
 	if (IS_ERR(dsi->pclk)) {
 		ret = PTR_ERR(dsi->pclk);

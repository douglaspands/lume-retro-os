Subject: [PATCH] drm/panel: ga36mb-jd9366: experiment, ~60 Hz by the pixel clock

Experiment kernel of device-fixes 6.3 (D13, P-25), never in the default image.

32.175 MHz is pll-mipi 297 MHz x 13 / 10 = 386.1 MHz exactly, divided by 12 (24 bits
over 2 lanes): lanes at 386.1 Mbit/s (+8.3% over the 356.4 of today). With the
vendor totals that is 59.73 Hz; the front porch 5 pixels shorter (275, htotal 1035)
gives 32175000 / (1035 x 518) = 60.013 Hz. Vertical timing unchanged.
---
diff --git a/drivers/gpu/drm/panel/panel-ga36mb-jd9366.c b/drivers/gpu/drm/panel/panel-ga36mb-jd9366.c
--- a/drivers/gpu/drm/panel/panel-ga36mb-jd9366.c
+++ b/drivers/gpu/drm/panel/panel-ga36mb-jd9366.c
@@ -194,12 +194,17 @@
  * vsync 6. In the Allwinner counting hbp/vbp include the sync, so the back porch is
  * hbp - hsync and the front porch is the rest.
  */
+/*
+ * Experiment ~60 Hz by the pixel clock (device-fixes 6.3, D13): 32.175 MHz is
+ * pll-mipi 297 MHz x 13 / 10 = 386.1 MHz divided by 12 (lanes at 386.1 Mbit/s);
+ * front porch 275 (htotal 1035): 32175000 / (1035 x 518) = 60.013 Hz.
+ */
 static const struct drm_display_mode jd9366_mode = {
-	.clock = 30000,
+	.clock = 32175,
 	.hdisplay = 640,
-	.hsync_start = 640 + 280,
-	.hsync_end = 640 + 280 + 40,
-	.htotal = 1040,
+	.hsync_start = 640 + 275,
+	.hsync_end = 640 + 275 + 40,
+	.htotal = 1035,
 	.vdisplay = 480,
 	.vsync_start = 480 + 26,
 	.vsync_end = 480 + 26 + 6,
@@ -450,6 +455,7 @@
 	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
 			  MIPI_DSI_MODE_LPM | MIPI_DSI_CLOCK_NON_CONTINUOUS;
 	ctx->panel.prepare_prev_first = true;
+	dev_info(dev, "experiment kernel 60hz: 32.175 MHz pixel clock, htotal 1035, 60.013 Hz\n");
 
 	ret = jd9366_check_bus(ctx, dsi);
 	if (ret < 0) {

+"""Busca semântica local (protótipo, ver docs/ctx/MELHORIAS.md).
+
+Embeddings estáticos (model2vec, ~30 MB, CPU, sem GPU) guardados como BLOB numa tabela comum do
+próprio index.db; a similaridade é calculada com numpy (força bruta: milhares de chunks em poucos ms).
+Não usa sqlite-vec: o Python do .venv pode vir sem `enable_load_extension`.
+
+- O modelo é baixado só na indexação, para `.ctx/models/<nome>`; a busca nunca acessa a rede.
+- Sem model2vec/numpy instalados, tudo aqui devolve None e a busca segue só com BM25.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+from pathlib import Path
+from typing import Any
+
+DEFAULT_MODEL = "minishlab/potion-base-8M"
+TEXT_CHARS = 1500  # início do chunk usado no embedding (título + caminho vêm antes)
+
+_MODELS: dict[str, Any] = {}
+
+
+def model_dir(workspace_root: Path, name: str) -> Path:
+    return workspace_root / ".ctx" / "models" / re.sub(r"[^\w.-]+", "--", name)
+
+
+def get_model(workspace_root: Path, name: str = DEFAULT_MODEL, allow_download: bool = False) -> Any:
+    """Modelo carregado (cache por processo) ou None (dependência ausente / não baixado)."""
+    key = f"{workspace_root}:{name}"
+    if key in _MODELS:
+        return _MODELS[key]
+    local = model_dir(workspace_root, name)
+    model = None
+    try:
+        os.environ.setdefault("HF_HUB_DISABLE_TELEMETRY", "1")
+        from model2vec import StaticModel
+
+        if local.is_dir():
+            model = StaticModel.from_pretrained(str(local))
+        elif allow_download:
+            os.environ.setdefault("HF_HOME", str(workspace_root / ".ctx" / "models" / ".hf"))
+            model = StaticModel.from_pretrained(name)
+            local.parent.mkdir(parents=True, exist_ok=True)
+            model.save_pretrained(str(local))
+    except Exception:
+        model = None
+    _MODELS[key] = model
+    return model
+
+
+def chunk_text(title: str, path: str, content: str) -> str:
+    return f"{title}\n{path}\n{content[:TEXT_CHARS]}"
+
+
+def encode(model: Any, texts: list[str]) -> Any:
+    """Vetores float32 normalizados (norma 1), um por texto."""
+    import numpy as np
+
+    vecs = np.asarray(model.encode(texts), dtype=np.float32)
+    norms = np.linalg.norm(vecs, axis=1, keepdims=True)
+    norms[norms == 0] = 1.0
+    return vecs / norms
+
+
+def to_blob(vec: Any) -> bytes:
+    return vec.astype("float32").tobytes()
+
+
+def top_rowids(con: Any, model: Any, query: str, limit: int) -> list[tuple[int, float]]:
+    """(rowid do chunk, similaridade de cosseno) dos `limit` chunks mais próximos da query."""
+    import numpy as np
+
+    rows = con.execute("SELECT id, vec FROM vectors").fetchall()
+    if not rows:
+        return []
+    ids = np.fromiter((r[0] for r in rows), dtype=np.int64, count=len(rows))
+    mat = np.frombuffer(b"".join(r[1] for r in rows), dtype=np.float32).reshape(len(rows), -1)
+    q = encode(model, [query])[0]
+    sims = mat @ q
+    k = min(limit, len(rows))
+    best = np.argpartition(-sims, k - 1)[:k]
+    best = best[np.argsort(-sims[best])]
+    return [(int(ids[i]), float(sims[i])) for i in best]

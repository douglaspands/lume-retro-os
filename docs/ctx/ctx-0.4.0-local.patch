+def sanitize_query(query: str, mode: str = "and") -> str:
+    """Higieniza termos para o FTS5 sem quebras de sintaxe.
+
+    mode "and": todos os termos (busca cirúrgica); "or": qualquer termo (fallback quando "and" volta
+    vazio); "trigram": cada termo com 3+ caracteres como substring (tabela chunks_tri).
+    """
+    tokens = lexical_tokens(query)
+    if mode == "trigram":
+        tokens = [t for t in tokens if len(t) >= 3]
+    if not tokens:
+        return ""
+    quoted = [f'"{t}"' for t in tokens]
+    return " OR ".join(quoted) if mode == "or" else " ".join(quoted)

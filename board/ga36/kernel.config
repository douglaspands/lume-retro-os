# GA36-MB V1.2 (Allwinner A33): fragment on top of the kernel's sunxi_defconfig (multi_v7
# reduced to the Allwinner SoCs), applied with scripts/kconfig/merge_config.sh (D3).
# The build fails if any option here does not keep the requested value in the final .config.
#
# Already in sunxi_defconfig and not repeated: DRM_SUN4I, DRM_LIMA, SND_SUN8I_CODEC(+ANALOG),
# SND_SUN4I_I2S, MFD_AXP20X_RSB, REGULATOR_AXP20X, BATTERY/CHARGER_AXP20X, AXP20X_POWER,
# INPUT_AXP20X_PEK, CPUFREQ_DT, PWM_SUN4I, BACKLIGHT_PWM, MMC_SUNXI, VFAT_FS and
# SERIAL_8250_DW.
#
# CPU frequency and thermal stay at the mainline defaults: nothing here changes the
# default governor.

# Thermal sensor: the A33 THS (1c25000, "allwinner,sun8i-a33-ths") is driven by the GPADC
# IIO driver, not by SUN8I_THERMAL (that one covers the A83T/H3 and newer SoCs and was
# already on). Without it the cpu-thermal zone of sun8i-a33.dtsi never registers: no
# temperature reading and no throttling (passive at 75 °C, hot at 90 °C, critical
# shutdown at 110 °C).
CONFIG_SUN4I_GPADC=y
# GPU cooling (task 9.10): lima registers the Mali as a devfreq cooling device only with
# this option; without it dmesg says "Failed to register cooling device" and the two GPU
# trips of the cpu-thermal zone (85 °C passive, 95 °C hot) do nothing.
CONFIG_DEVFREQ_THERMAL=y

CONFIG_LOCALVERSION="-r36os"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Boot through the vendor chain (D5): U-Boot 2017 loads an Android boot image and passes
# ATAGs (memory). The DTB is appended to the zImage, the ATAGs fill in the memory and the
# command line is this one (the vendor env is ignored). The initramfs is built into the
# kernel, so it does not depend on how the vendor U-Boot handles a ramdisk.
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_CMDLINE="root=PARTUUID=4c554d32-01 rootwait console=ttyS1,115200 console=tty1 loglevel=6"
CONFIG_CMDLINE_FORCE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="/initramfs/initramfs.cpio"

# DTB selection (boot-dtb-select D2): the initramfs reloads this same kernel (BOOT/ga36/
# zImage) with another DTB of BOOT/dtbs/a33/ through kexec_load (kexec-tools --dtb). On
# armv7 with SMP it needs PM_SLEEP_SMP, already on in sunxi_defconfig, and CPU hotplug:
# the kernel refuses kexec when it cannot kill the secondary CPUs, which the A33 can only
# do with kernel/patches/0027 (GA36 boot 20: kexec -l failed with status 255).
CONFIG_KEXEC=y
CONFIG_HOTPLUG_CPU=y
# Keys read by the selection key in the initramfs (D7): the volume keys on the LRADC.
# Already in sunxi_defconfig, repeated so the build fails if they stop being built in.
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_SUN4I_LRADC=y

# USB gadget on the OTG port (usb-device-access D2): the "Lume" gadget built through
# configfs, with FunctionFS for MTP (umtprd) and NCM for the USB network, built in so the
# boot needs no modprobe. The MUSB in dual-role is already in sunxi_defconfig, repeated so
# the build fails if it goes away.
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_NCM=y

# Host role of the OTG port (usb-device-access D8, P-38): pendrive (built in), USB
# controllers (Xbox, PlayStation, Nintendo, generic HID such as 8BitDo), keyboard, mouse.
# Device drivers are modules, loaded by udev when the device shows up.
CONFIG_USB_STORAGE=y
CONFIG_HID_GENERIC=y
CONFIG_JOYSTICK_XPAD=m
# the PS4/PS5 driver needs the multicolor LED class (the light bar); off in sunxi_defconfig
CONFIG_LEDS_CLASS_MULTICOLOR=m
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_SONY=m
CONFIG_HID_NINTENDO=m

# Wi-Fi and Bluetooth by USB dongle (usb-device-access D9, D10, P-15): Realtek rtw88
# (RTL8821CU, the reference dongle, and the other Realtek USB chips), rtl8xxxu
# (RTL8188/8192/8723 USB), Atheros ath9k_htc (AR9271); Bluetooth USB with the Realtek
# setup, classic HID (controllers, keyboards) and uhid (BLE controllers through bluez).
# The Alpine firmware files are zstd-compressed.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=m
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8723DU=m
CONFIG_RTL8XXXU=m
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HTC=m
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HIDP=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_UHID=m

# Panel: DSI, D-PHY and the JD9366 driver (kernel/patches/0005), built in with fbcon so the
# verbose boot shows on the panel early
CONFIG_DRM_SUN6I_DSI=y
CONFIG_PHY_SUN6I_MIPI_DPHY=y
CONFIG_DRM_PANEL_GA36MB_JD9366=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# No Tux on fbcon: the boot screen is the same on both consoles, with logo.bmp from the
# bootloader only
# CONFIG_LOGO is not set

# Gamepad: GPIO buttons and sticks over UART (serdev, kernel/patches/0006); joydev gives
# the js* device that the hardware summary and older tools look for
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_GA36MB=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_UINPUT=y

# Audio: simple-audio-card from sun8i-a33.dtsi, with the speaker amplifier on PH9
# (simple-audio-amplifier; without it the card stays in "deferred probe")
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=y

# Boot (D6): SYSTEM squashfs on loop, overlay with tmpfs, FAT BOOT and exFAT ROMS
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
# xattrs on the tmpfs upper layer of the root overlay; without them the kernel logged
# "overlayfs: failed to set xattr on upper" on every boot (task 9.11)
CONFIG_TMPFS_XATTR=y
CONFIG_EXFAT_FS=y
CONFIG_MSDOS_PARTITION=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Memory: compressed swap in RAM (ZRAM + LZ4)
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y


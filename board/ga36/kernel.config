# GA36-MB V1.2 (Allwinner A33): fragment on top of the kernel's sunxi_defconfig (multi_v7
# reduced to the Allwinner SoCs), applied with scripts/kconfig/merge_config.sh (D3).
# The build fails if any option here does not keep the requested value in the final .config.
#
# Already in sunxi_defconfig and not repeated: DRM_SUN4I, DRM_LIMA, SND_SUN8I_CODEC(+ANALOG),
# SND_SUN4I_I2S, MFD_AXP20X_RSB, REGULATOR_AXP20X, BATTERY/CHARGER_AXP20X, AXP20X_POWER,
# INPUT_AXP20X_PEK, KEYBOARD_SUN4I_LRADC, CPUFREQ_DT, SUN8I_THERMAL, PWM_SUN4I,
# BACKLIGHT_PWM, MMC_SUNXI, VFAT_FS and SERIAL_8250_DW.
#
# CPU frequency and thermal stay at the mainline defaults: nothing here changes the
# default governor.

CONFIG_LOCALVERSION="-r36os"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Boot through the vendor chain (D5): U-Boot 2017 loads an Android boot image and passes
# ATAGs (memory). The DTB is appended to the zImage, the ATAGs fill in the memory and the
# command line is this one (the vendor env is ignored). The initramfs is built into the
# kernel, so it does not depend on how the vendor U-Boot handles a ramdisk.
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_CMDLINE="root=PARTUUID=4c554d32-01 rootwait console=ttyS1,115200 console=tty1 loglevel=6"
CONFIG_CMDLINE_FORCE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="/initramfs/initramfs.cpio"

# Panel: DSI, D-PHY and the JD9366 driver (kernel/patches/0005), built in with fbcon so the
# verbose boot shows on the panel early
CONFIG_DRM_SUN6I_DSI=y
CONFIG_PHY_SUN6I_MIPI_DPHY=y
CONFIG_DRM_PANEL_GA36MB_JD9366=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Gamepad: GPIO buttons and sticks over UART (serdev, kernel/patches/0006); joydev gives
# the js* device that the hardware summary and older tools look for
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_GA36MB=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_UINPUT=y

# Audio: simple-audio-card from sun8i-a33.dtsi, with the speaker amplifier on PH9
# (simple-audio-amplifier; without it the card stays in "deferred probe")
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=y

# Boot (D6): SYSTEM squashfs on loop, overlay with tmpfs, FAT BOOT and exFAT ROMS
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_EXFAT_FS=y
CONFIG_MSDOS_PARTITION=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Memory: compressed swap in RAM (ZRAM + LZ4)
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y


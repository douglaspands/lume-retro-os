# Keys of the device tree list in the initramfs (boot-dtb-select D7), read by lume-bootsel
# from /etc/bootsel-keys. <role>=<key>[,<key>...], with names of linux/input-event-codes.h
# or numbers. select: held at power on, opens the list.
#
# PROVISIONAL until proof 1.3 tells which keys the factory U-Boot of the GA36 already uses
# at power on (its LRADC ranges divert the boot to recovery or fastboot).
# Volume keys: LRADC (built in, ready early); D-pad and A: the gamepad MCU (BTN_SOUTH is
# BTN_A, the A button of the GA36 driver).
select=KEY_VOLUMEDOWN
up=BTN_DPAD_UP,KEY_VOLUMEUP
down=BTN_DPAD_DOWN,KEY_VOLUMEDOWN
ok=BTN_SOUTH

# U-Boot mainline do GA36-MB V1.2 (D5): fragmento sobre o Sinlinx_SinA33_defconfig, que já
# tem a DRAM do Apêndice B (CONFIG_DRAM_CLK=552, CONFIG_DRAM_ZQ=15291, DDR3). O DT do U-Boot é
# o da própria placa (board/ga36/dts, painel 1), compilado no modo OF_UPSTREAM junto aos DTS
# do Linux que o U-Boot traz: console, cartão e PMIC são os do GA36.
# O build falha se alguma opção daqui não ficar com o valor pedido.

CONFIG_OF_UPSTREAM=y
CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun8i-a33-ga36-mb-v1.2-panel1"
#
# Tensões da AXP223: os padrões do U-Boot para o A33 já são os lidos no firmware de fábrica
# (dcdc1 3000, dcdc2 1100, dcdc3 1200, dcdc5 1500, aldo1 3000, aldo2 2500, aldo3 3000 mV).
# O dldo3 (DSI) e o dc1sw (painel) ficam para o Linux.

CONFIG_DRAM_CLK=552
CONFIG_DRAM_ZQ=15291
CONFIG_DRAM_ODT_EN=y
# Serial de debug: UART2 em PB0/PB1 (ttyS1 no Linux), 115200
CONFIG_CONS_INDEX=3
# Sem a tela do U-Boot: o painel é DSI e só o Linux sabe iniciá-lo
# CONFIG_VIDEO_SUNXI is not set
# CONFIG_VIDEO_DT_SIMPLEFB is not set
# Só o cartão (mmc0); o mmc1 em PG fica desligado
CONFIG_MMC_SUNXI_SLOT_EXTRA=-1
CONFIG_BOOTDELAY=1

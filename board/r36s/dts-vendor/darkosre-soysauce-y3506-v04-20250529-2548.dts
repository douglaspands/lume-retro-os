/*
 * Y3506_V04_20250529 2548, converted from a vendor RK3326 device tree by
 * `r36os dtb import` (boot-dtb-select D12). Do not edit: import again.
 * Source: darkosre/files/BOOT/dtb/soysauce/Y3506_V04_20250529 2548/rk3326-r36s-linux.dtb
 * SHA-256: 660ed19ae46c3953b7e1060ea3dd03093fe0c8ab4562a379542dec4d0b981b22
 * Note: speaker gain: source spk-volume 1 ignored, the native safe value is used
 */

#include "rk3326-r36s-v5.dts"

/ {
	model = "Y3506_V04_20250529 2548 (converted)";

	lume-select {
		lume,id = "darkosre-soysauce-y3506-v04-20250529-2548";
		lume,priority = <0>;
		/delete-property/ lume,default;
	};

	/delete-node/ gpio-keys;
	/delete-node/ volume-keys;

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&btn_pins>;

		button-dpad-up {
			gpios = <&gpio3 RK_PA7 GPIO_ACTIVE_LOW>;
			label = "DPAD-UP";
			linux,code = <0x220>;
		};

		button-dpad-down {
			gpios = <&gpio3 RK_PB0 GPIO_ACTIVE_LOW>;
			label = "DPAD-DOWN";
			linux,code = <0x221>;
		};

		button-dpad-left {
			gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>;
			label = "DPAD-LEFT";
			linux,code = <0x222>;
		};

		button-dpad-right {
			gpios = <&gpio3 RK_PB1 GPIO_ACTIVE_LOW>;
			label = "DPAD-RIGHT";
			linux,code = <0x223>;
		};

		button-key-btn-a {
			gpios = <&gpio3 RK_PB6 GPIO_ACTIVE_LOW>;
			label = "KEY BTN-A";
			linux,code = <0x131>;
		};

		button-btn-b {
			gpios = <&gpio3 RK_PB4 GPIO_ACTIVE_LOW>;
			label = "BTN-B";
			linux,code = <0x130>;
		};

		button-btn-y {
			gpios = <&gpio3 RK_PB3 GPIO_ACTIVE_LOW>;
			label = "BTN-Y";
			linux,code = <0x134>;
		};

		button-btn-x {
			gpios = <&gpio3 RK_PB5 GPIO_ACTIVE_LOW>;
			label = "BTN-X";
			linux,code = <0x133>;
		};

		button-f3 {
			gpios = <&gpio0 RK_PB3 GPIO_ACTIVE_LOW>;
			label = "F3";
			linux,code = <0x2c2>;
		};

		button-f4 {
			gpios = <&gpio3 RK_PD3 GPIO_ACTIVE_LOW>;
			label = "F4";
			linux,code = <0x2c3>;
		};

		button-top-left {
			gpios = <&gpio3 RK_PA3 GPIO_ACTIVE_LOW>;
			label = "TOP-LEFT";
			linux,code = <0x136>;
		};

		button-top-right {
			gpios = <&gpio3 RK_PA0 GPIO_ACTIVE_LOW>;
			label = "TOP-RIGHT";
			linux,code = <0x137>;
		};

		button-f1 {
			gpios = <&gpio3 RK_PA5 GPIO_ACTIVE_LOW>;
			label = "F1";
			linux,code = <0x2c0>;
		};

		button-top-left2 {
			gpios = <&gpio3 RK_PA2 GPIO_ACTIVE_LOW>;
			label = "TOP-LEFT2";
			linux,code = <0x138>;
		};

		button-top-right2 {
			gpios = <&gpio3 RK_PA1 GPIO_ACTIVE_LOW>;
			label = "TOP-RIGHT2";
			linux,code = <0x139>;
		};

		button-f2 {
			gpios = <&gpio3 RK_PA6 GPIO_ACTIVE_LOW>;
			label = "F2";
			linux,code = <0x2c1>;
		};

		button-f5 {
			gpios = <&gpio3 RK_PA4 GPIO_ACTIVE_LOW>;
			label = "F5";
			linux,code = <0x2c4>;
		};
	};

	volume-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&vol_pins>;
		autorepeat;

		button-gpio-btn-volup {
			gpios = <&gpio3 RK_PC6 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN-VOLUP";
			linux,code = <0x73>;
		};

		button-gpio-btn-voldn {
			gpios = <&gpio3 RK_PC5 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN-VOLDN";
			linux,code = <0x72>;
		};
	};

	mux-controller {
		mux-gpios = <&gpio0 RK_PB5 GPIO_ACTIVE_LOW>,
			    <&gpio0 RK_PB4 GPIO_ACTIVE_LOW>;
	};

	adc-mux {
		io-channels = <&saradc 1>;
	};

	/delete-node/ gpio-leds;

	gpio-leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&led_pins>;

		led-0 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
		};

		led-1 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_INDICATOR;
			gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>;
		};
	};

	rk817-sound {
		simple-audio-card,hp-det-gpios = <&gpio2 RK_PC6 GPIO_ACTIVE_HIGH>;
	};
};

&internal_display {
	compatible = "rocknix,generic-dsi";
	/delete-property/ vcc-supply;
	vdd-supply = <&vcc_lcd>;
	reset-gpios = <&gpio3 RK_PC0 GPIO_ACTIVE_LOW>;
	enable-gpios = <&gpio1 RK_PC2 GPIO_ACTIVE_LOW>;
	panel_description =
		"G size=71,71 delays=100,50,20,200,20 format=rgb888 lanes=4 flags=0xe03",
		"M clock=40000 horizontal=640,46,2,44 vertical=480,16,2,14 default=1",
		"M clock=25500 horizontal=640,188,2,190 vertical=480,13,2,5",

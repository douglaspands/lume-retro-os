/*
 * Powkiddy RGB20S , converted from a vendor RK3326 device tree by
 * `r36os dtb import` (boot-dtb-select D12). Do not edit: import again.
 * Source: arkos4clone/boot/dArkOS/consoles/rgb20s/rk3326-rgb20s-linux.dtb
 * SHA-256: 9d487e24bba08dfe40e08b0619bd8da37357f8ab2ad9b420f81f10fd776ead1a
 * Note: sticks: axes from the ROCKNIX joypad mapping, not measured
 * Note: speaker gain: source spk-volume 3 ignored, the native safe value is used
 */

#include "rk3326-r36s-v5.dts"

/ {
	model = "Powkiddy RGB20S  (converted)";

	lume-select {
		lume,id = "arkos4clone-rgb20s";
		lume,priority = <0>;
		/delete-property/ lume,default;
	};

	/delete-node/ gpio-keys;
	/delete-node/ volume-keys;

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&btn_pins>;

		button-dpad-up {
			gpios = <&gpio1 RK_PB4 GPIO_ACTIVE_LOW>;
			label = "DPAD-UP";
			linux,code = <0x220>;
		};

		button-dpad-down {
			gpios = <&gpio1 RK_PB5 GPIO_ACTIVE_LOW>;
			label = "DPAD-DOWN";
			linux,code = <0x221>;
		};

		button-dpad-left {
			gpios = <&gpio1 RK_PB6 GPIO_ACTIVE_LOW>;
			label = "DPAD-LEFT";
			linux,code = <0x222>;
		};

		button-dpad-right {
			gpios = <&gpio1 RK_PB7 GPIO_ACTIVE_LOW>;
			label = "DPAD-RIGHT";
			linux,code = <0x223>;
		};

		button-btn-a {
			gpios = <&gpio1 RK_PA2 GPIO_ACTIVE_LOW>;
			label = "BTN-A";
			linux,code = <0x131>;
		};

		button-btn-b {
			gpios = <&gpio1 RK_PA5 GPIO_ACTIVE_LOW>;
			label = "BTN-B";
			linux,code = <0x130>;
		};

		button-btn-y {
			gpios = <&gpio1 RK_PA6 GPIO_ACTIVE_LOW>;
			label = "BTN-Y";
			linux,code = <0x134>;
		};

		button-btn-x {
			gpios = <&gpio1 RK_PA7 GPIO_ACTIVE_LOW>;
			label = "BTN-X";
			linux,code = <0x133>;
		};

		button-btn-thumbr {
			gpios = <&gpio2 RK_PA2 GPIO_ACTIVE_LOW>;
			label = "BTN_THUMBR";
			linux,code = <0x2c2>;
		};

		button-btn-thumbl {
			gpios = <&gpio2 RK_PA3 GPIO_ACTIVE_LOW>;
			label = "BTN_THUMBL";
			linux,code = <0x2c3>;
		};

		button-f5 {
			gpios = <&gpio2 RK_PA4 GPIO_ACTIVE_LOW>;
			label = "F5";
			linux,code = <0x2c4>;
		};

		button-btn-tl {
			gpios = <&gpio2 RK_PA6 GPIO_ACTIVE_LOW>;
			label = "BTN_TL";
			linux,code = <0x136>;
		};

		button-btn-tr {
			gpios = <&gpio2 RK_PA7 GPIO_ACTIVE_LOW>;
			label = "BTN_TR";
			linux,code = <0x137>;
		};

		button-btn-select {
			gpios = <&gpio3 RK_PB1 GPIO_ACTIVE_LOW>;
			label = "BTN_SELECT";
			linux,code = <0x2c0>;
		};

		button-btn-tr2 {
			gpios = <&gpio3 RK_PB7 GPIO_ACTIVE_LOW>;
			label = "BTN_TR2";
			linux,code = <0x139>;
		};

		button-btn-tl2 {
			gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>;
			label = "BTN_TL2";
			linux,code = <0x138>;
		};

		button-btn-start {
			gpios = <&gpio3 RK_PB4 GPIO_ACTIVE_LOW>;
			label = "BTN_START";
			linux,code = <0x2c1>;
		};
	};

	volume-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&vol_pins>;
		autorepeat;

		button-gpio-btn-volup {
			gpios = <&gpio2 RK_PA0 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN-VOLUP";
			linux,code = <0x73>;
		};

		button-gpio-btn-voldn {
			gpios = <&gpio2 RK_PA1 GPIO_ACTIVE_LOW>;
			label = "GPIO BTN-VOLDN";
			linux,code = <0x72>;
		};
	};

	/delete-node/ adc-joystick;

	adc-joystick {
		compatible = "adc-joystick";
		io-channels = <&joystick_mux 3>,
			      <&joystick_mux 1>,
			      <&joystick_mux 2>,
			      <&joystick_mux 0>;
		poll-interval = <10>;
		#address-cells = <1>;
		#size-cells = <0>;

		axis@0 {
			reg = <0>;
			abs-flat = <32>;
			abs-fuzz = <32>;
			abs-range = <0 1023>;
			linux,code = <ABS_RY>;
		};

		axis@1 {
			reg = <1>;
			abs-flat = <32>;
			abs-fuzz = <32>;
			abs-range = <0 1023>;
			linux,code = <ABS_RX>;
		};

		axis@2 {
			reg = <2>;
			abs-flat = <32>;
			abs-fuzz = <32>;
			abs-range = <1023 0>;
			linux,code = <ABS_Y>;
		};

		axis@3 {
			reg = <3>;
			abs-flat = <32>;
			abs-fuzz = <32>;
			abs-range = <1023 0>;
			linux,code = <ABS_X>;
		};
	};

	mux-controller {
		mux-gpios = <&gpio3 RK_PB3 GPIO_ACTIVE_LOW>,
			    <&gpio3 RK_PB0 GPIO_ACTIVE_LOW>;
	};

	adc-mux {
		io-channels = <&saradc 1>;
	};

	/delete-node/ gpio-leds;

	rk817-sound {
		simple-audio-card,hp-det-gpios = <&gpio2 RK_PC6 GPIO_ACTIVE_LOW>;
	};
};

&internal_display {
	compatible = "rocknix,generic-dsi";
	/delete-property/ vcc-supply;
	vdd-supply = <&vcc_lcd>;
	reset-gpios = <&gpio3 RK_PC0 GPIO_ACTIVE_LOW>;
	panel_description =
		"G size=52,70 delays=2,1,20,120,20 format=rgb888 lanes=4 flags=0xe03",
		"M clock=50000 horizontal=640,450,46,450 vertical=480,17,5,13 default=1",
		"I seq=ff30",
		"I seq=ff52",
		"I seq=ff01",
		"I seq=e300",
		"I seq=400a",
		"I seq=0340",

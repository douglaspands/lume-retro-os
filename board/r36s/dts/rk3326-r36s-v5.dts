// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * R36S "V5" handheld game console (Rockchip RK3326).
 *
 * Structure of rk3326-odroid-go3.dts and rk3326-gameforce-chi.dts (mainline). The values
 * come from the factory device tree of the device (rk3326-r35s-linux.dtb on its BOOT
 * partition; appendix A of the alpine-retroarch-distro design). OPPs and thermal zones
 * are those of rk3326.dtsi, unchanged.
 */

/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include "rk3326.dtsi"

/ {
	model = "R36S V5";
	compatible = "r36s,r36s-v5", "rockchip,rk3326";
	chassis-type = "handset";

	aliases {
		mmc0 = &sdmmc;
		mmc1 = &sdio;
	};

	chosen {
		stdout-path = "serial2:1500000n8";
	};

	/* Sticks: SARADC channel 1 behind a 4-way mux (A gpio0 13, B gpio0 12) */
	joystick_mux_controller: mux-controller {
		compatible = "gpio-mux";
		#mux-control-cells = <0>;
		mux-gpios = <&gpio0 RK_PB5 GPIO_ACTIVE_LOW>,
			    <&gpio0 RK_PB4 GPIO_ACTIVE_LOW>;
	};

	joystick_mux: adc-mux {
		compatible = "io-channel-mux";
		io-channels = <&saradc 1>;
		io-channel-names = "parent";
		#io-channel-cells = <1>;
		mux-controls = <&joystick_mux_controller>;
		channels = "0", "1", "2", "3";
	};

	/*
	 * Channels and directions from a scripted test on the user's R36S V5 (boot 19, log
	 * boot-10, 2026-11-13: each direction held, left stick first), read from the kernel
	 * events, not from the RetroArch menu. Left stick: channel 1 horizontal and channel 3
	 * vertical, both reading high to the left and up, so inverted. Right stick: channel 2
	 * horizontal and channel 0 vertical, both reading low to the left and up, as read.
	 * adc-joystick has no calibration, so each range is centred on the rest value
	 * measured on this device (boots 15 and 16: ch0 ~435, ch2 ~455, ch1 ~520, ch3 ~490)
	 * with +-330 of travel. Calibration at start is task 6.8.
	 */
	analog_sticks: adc-joystick {
		compatible = "adc-joystick";
		io-channels = <&joystick_mux 0>,
			      <&joystick_mux 1>,
			      <&joystick_mux 2>,
			      <&joystick_mux 3>;
		poll-interval = <10>;
		#address-cells = <1>;
		#size-cells = <0>;

		/* right stick, vertical */
		axis@0 {
			reg = <0>;
			abs-flat = <32>;
			abs-fuzz = <32>;
			abs-range = <105 765>;
			linux,code = <ABS_RY>;
		};

		/* left stick, horizontal (inverted) */
		axis@1 {
			reg = <1>;
			abs-flat = <32>;
			abs-fuzz = <32>;
			abs-range = <850 190>;
			linux,code = <ABS_X>;
		};

		/* right stick, horizontal */
		axis@2 {
			reg = <2>;
			abs-flat = <32>;
			abs-fuzz = <32>;
			abs-range = <125 785>;
			linux,code = <ABS_RX>;
		};

		/* left stick, vertical (inverted) */
		axis@3 {
			reg = <3>;
			abs-flat = <32>;
			abs-fuzz = <32>;
			abs-range = <820 160>;
			linux,code = <ABS_Y>;
		};
	};

	/* PWM1, 40 us period, levels 0-160, default 80 (factory values) */
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm1 0 40000 0>;
		brightness-levels = <0 160>;
		num-interpolated-steps = <160>;
		default-brightness-level = <80>;
	};

	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <3188000>;
		charge-term-current-microamp = <300000>;
		constant-charge-current-max-microamp = <2000000>;
		constant-charge-voltage-max-microvolt = <4200000>;
		factory-internal-resistance-micro-ohms = <113000>;
		voltage-max-design-microvolt = <4200000>;
		voltage-min-design-microvolt = <3300000>;
		ocv-capacity-celsius = <20>;
		ocv-capacity-table-0 =  <4182000 100>, <4075000 95>, <4028000 90>, <4012000 85>,
					<3961000 80>, <3911000 75>, <3886000 70>, <3852000 65>,
					<3809000 60>, <3759000 55>, <3701000 50>, <3660000 45>,
					<3634000 40>, <3615000 35>, <3599000 30>, <3582000 25>,
					<3559000 20>, <3529000 15>, <3493000 10>, <3444000 5>,
					<3400000 0>;
	};

	gpio-leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&led_pins>;

		red_led: led-0 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_INDICATOR;
			gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>;
		};

		/* lit by the initramfs as soon as the kernel reaches init */
		blue_led: led-1 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
		};
	};

	/* 17 buttons, active low; r36os-padmerge joins them with the sticks (D8) */
	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&btn_pins>;

		button-up {
			gpios = <&gpio3 RK_PA7 GPIO_ACTIVE_LOW>;
			label = "DPAD-UP";
			linux,code = <BTN_DPAD_UP>;
		};

		button-down {
			gpios = <&gpio3 RK_PB0 GPIO_ACTIVE_LOW>;
			label = "DPAD-DOWN";
			linux,code = <BTN_DPAD_DOWN>;
		};

		button-left {
			gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>;
			label = "DPAD-LEFT";
			linux,code = <BTN_DPAD_LEFT>;
		};

		button-right {
			gpios = <&gpio3 RK_PB1 GPIO_ACTIVE_LOW>;
			label = "DPAD-RIGHT";
			linux,code = <BTN_DPAD_RIGHT>;
		};

		button-a {
			gpios = <&gpio3 RK_PB6 GPIO_ACTIVE_LOW>;
			label = "EAST";
			linux,code = <BTN_EAST>;
		};

		button-b {
			gpios = <&gpio3 RK_PB4 GPIO_ACTIVE_LOW>;
			label = "SOUTH";
			linux,code = <BTN_SOUTH>;
		};

		button-x {
			gpios = <&gpio3 RK_PB5 GPIO_ACTIVE_LOW>;
			label = "NORTH";
			linux,code = <BTN_NORTH>;
		};

		button-y {
			gpios = <&gpio3 RK_PB3 GPIO_ACTIVE_LOW>;
			label = "WEST";
			linux,code = <BTN_WEST>;
		};

		button-l1 {
			gpios = <&gpio3 RK_PA3 GPIO_ACTIVE_LOW>;
			label = "TL";
			linux,code = <BTN_TL>;
		};

		button-r1 {
			gpios = <&gpio3 RK_PA0 GPIO_ACTIVE_LOW>;
			label = "TR";
			linux,code = <BTN_TR>;
		};

		button-l2 {
			gpios = <&gpio3 RK_PA2 GPIO_ACTIVE_LOW>;
			label = "TL2";
			linux,code = <BTN_TL2>;
		};

		button-r2 {
			gpios = <&gpio3 RK_PA1 GPIO_ACTIVE_LOW>;
			label = "TR2";
			linux,code = <BTN_TR2>;
		};

		/* F1-F5: the order of the keys on the case is confirmed on the device */
		button-f1 {
			gpios = <&gpio3 RK_PA5 GPIO_ACTIVE_LOW>;
			label = "F1";
			linux,code = <BTN_TRIGGER_HAPPY1>;
		};

		button-f2 {
			gpios = <&gpio3 RK_PA6 GPIO_ACTIVE_LOW>;
			label = "F2";
			linux,code = <BTN_TRIGGER_HAPPY2>;
		};

		button-f3 {
			gpios = <&gpio0 RK_PB3 GPIO_ACTIVE_LOW>;
			label = "F3";
			linux,code = <BTN_TRIGGER_HAPPY3>;
		};

		button-f4 {
			gpios = <&gpio3 RK_PD3 GPIO_ACTIVE_LOW>;
			label = "F4";
			linux,code = <BTN_TRIGGER_HAPPY4>;
		};

		button-f5 {
			gpios = <&gpio3 RK_PA4 GPIO_ACTIVE_LOW>;
			label = "F5";
			linux,code = <BTN_TRIGGER_HAPPY5>;
		};
	};

	/* Volume keys (factory odroidgo3-keys), kept apart from the gamepad */
	volume-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&vol_pins>;
		autorepeat;

		button-vol-up {
			gpios = <&gpio3 RK_PC6 GPIO_ACTIVE_LOW>;
			label = "VOLUMEUP";
			linux,code = <KEY_VOLUMEUP>;
		};

		button-vol-down {
			gpios = <&gpio3 RK_PC5 GPIO_ACTIVE_LOW>;
			label = "VOLUMEDOWN";
			linux,code = <KEY_VOLUMEDOWN>;
		};
	};

	/*
	 * Speaker stage enabled by gpio3 20 (spk-ctl-gpios of the factory codec node), after
	 * the RK817 speaker output (SPKO, its class D stage). The factory driver raises it only
	 * while the speaker path plays; held high all the time (boots 18 to 24) the speaker
	 * hummed from the start of the boot. As a simple-audio-amplifier, DAPM drives it with
	 * the speaker path. (Boots 16 and 17 were silent with this wiring because of the codec,
	 * fixed by patch 0024, not because of the amplifier.)
	 */
	spk_amp: audio-amplifier {
		compatible = "simple-audio-amplifier";
		enable-gpios = <&gpio3 RK_PC4 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&spk_amp_enable_h>;
		sound-name-prefix = "Speaker Amp";
	};

	rk817-sound {
		compatible = "simple-audio-card";
		pinctrl-names = "default";
		pinctrl-0 = <&hp_det>;
		simple-audio-card,name = "rk817_int";
		simple-audio-card,aux-devs = <&spk_amp>;
		simple-audio-card,format = "i2s";
		/*
		 * Active high, as the factory rk_headset node (headset_gpio, flag 0): the line reads
		 * low with nothing plugged in. Active low reported headphones all the time, the
		 * jack service kept the playback mux on HP and the speaker was silent (boot 16).
		 */
		simple-audio-card,hp-det-gpios = <&gpio2 RK_PC6 GPIO_ACTIVE_HIGH>;
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,widgets =
			"Microphone", "Mic Jack",
			"Headphone", "Headphones",
			"Speaker", "Internal Speakers";
		simple-audio-card,routing =
			"MICL", "Mic Jack",
			"Headphones", "HPOL",
			"Headphones", "HPOR",
			"Speaker Amp INL", "SPKO",
			"Speaker Amp INR", "SPKO",
			"Internal Speakers", "Speaker Amp OUTL",
			"Internal Speakers", "Speaker Amp OUTR";
		simple-audio-card,pin-switches = "Internal Speakers";

		simple-audio-card,codec {
			sound-dai = <&rk817>;
		};

		simple-audio-card,cpu {
			sound-dai = <&i2s1_2ch>;
		};
	};

	vccsys: regulator-vccsys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v8_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3800000>;
		regulator-max-microvolt = <3800000>;
	};
};

&cpu0 {
	cpu-supply = <&vdd_arm>;
};

&cpu1 {
	cpu-supply = <&vdd_arm>;
};

&cpu2 {
	cpu-supply = <&vdd_arm>;
};

&cpu3 {
	cpu-supply = <&vdd_arm>;
};

&display_subsystem {
	status = "okay";
};

&dsi {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	/*
	 * The link as the factory kernel runs it (register dump of the running factory
	 * system, task 4.6): 180 Mbps per lane and the LP/HS transition times of
	 * PHY_TMR_LPCLK_CFG 0x00400040 and PHY_TMR_CFG 0x14102710 (kernel patch 0019).
	 */
	rockchip,lane-rate = <180>;
	rockchip,phy-hstt = <64 64 16 20>;

	/*
	 * The enable (gpio1 18, active low) and stbyb (gpio3 15, active high) lines of the
	 * factory panel node are held by the hogs below; the ST7703 driver only drives reset.
	 */
	internal_display: panel@0 {
		compatible = "r36s,r36s-v5-panel";
		reg = <0>;
		backlight = <&backlight>;
		iovcc-supply = <&vcc_lcd>;
		vcc-supply = <&vcc_lcd>;
		reset-gpios = <&gpio3 RK_PC0 GPIO_ACTIVE_LOW>;

		port {
			mipi_in_panel: endpoint {
				remote-endpoint = <&mipi_out_panel>;
			};
		};
	};

	ports {
		mipi_out: port@1 {
			reg = <1>;

			mipi_out_panel: endpoint {
				remote-endpoint = <&mipi_in_panel>;
			};
		};
	};
};

&dsi_dphy {
	/* as the factory firmware leaves it (kernel patch 0011) */
	rockchip,txclkesc-not-inverted;
	status = "okay";
};

&gpio0 {
	/* enable of the stick multiplexer (active low) */
	joystick-mux-en-hog {
		gpio-hog;
		gpios = <RK_PC1 GPIO_ACTIVE_LOW>;
		output-high;
		line-name = "joystick-mux-en";
	};
};

&gpio1 {
	lcd-enable-hog {
		gpio-hog;
		gpios = <RK_PC2 GPIO_ACTIVE_LOW>;
		output-high;
		line-name = "lcd-enable";
	};
};

&gpio3 {
	lcd-stbyb-hog {
		gpio-hog;
		gpios = <RK_PB7 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "lcd-stbyb";
	};
};

&gpu {
	mali-supply = <&vdd_logic>;
	status = "okay";
};

&i2c0 {
	clock-frequency = <400000>;
	i2c-scl-falling-time-ns = <16>;
	i2c-scl-rising-time-ns = <280>;
	status = "okay";

	rk817: pmic@20 {
		compatible = "rockchip,rk817";
		reg = <0x20>;
		#clock-cells = <1>;
		clock-names = "mclk";
		clock-output-names = "rk808-clkout1", "xin32k";
		clocks = <&cru SCLK_I2S1_OUT>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA7 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&pmic_int>, <&i2s1_2ch_mclk>;
		#sound-dai-cells = <0>;
		system-power-controller;
		wakeup-source;

		vcc1-supply = <&vccsys>;
		vcc2-supply = <&vccsys>;
		vcc3-supply = <&vccsys>;
		vcc4-supply = <&vccsys>;
		vcc5-supply = <&vccsys>;
		vcc6-supply = <&vccsys>;
		vcc7-supply = <&vccsys>;
		vcc8-supply = <&vccsys>;
		vcc9-supply = <&dcdc_boost>;

		regulators {
			vdd_logic: DCDC_REG1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <950000>;
				regulator-max-microvolt = <1350000>;
				regulator-name = "vdd_logic";
				regulator-ramp-delay = <6001>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <950000>;
				};
			};

			vdd_arm: DCDC_REG2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <950000>;
				regulator-max-microvolt = <1350000>;
				regulator-name = "vdd_arm";
				regulator-ramp-delay = <6001>;

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <950000>;
				};
			};

			vcc_ddr: DCDC_REG3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-name = "vcc_ddr";

				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};

			vcc_3v3: DCDC_REG4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc_3v3";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcc_1v0: LDO_REG1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <1000000>;
				regulator-name = "vcc_1v0";

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <1000000>;
				};
			};

			vcc1v8_soc: LDO_REG2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc1v8_soc";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			vdd1v0_soc: LDO_REG3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <1000000>;
				regulator-name = "vdd1v0_soc";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1000000>;
				};
			};

			vcc3v3_pmu: LDO_REG4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
				regulator-name = "vcc3v3_pmu";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3000000>;
				};
			};

			vccio_sd: LDO_REG5 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vccio_sd";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcc_sd: LDO_REG6 {
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc_sd";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcc2v8_dvp: LDO_REG7 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc2v8_dvp";

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			/* panel supply (vcc and iovcc of the ST7703) */
			vcc_lcd: LDO_REG8 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc_lcd";

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			vdd_11: LDO_REG9 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1100000>;
				regulator-name = "vdd_11";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1100000>;
				};
			};

			dcdc_boost: BOOST {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <4700000>;
				regulator-max-microvolt = <5400000>;
				regulator-name = "boost";
			};

			otg_switch: OTG_SWITCH {
				regulator-boot-on;
				regulator-name = "otg_switch";
			};
		};

		rk817_charger: charger {
			monitored-battery = <&battery>;
			rockchip,resistor-sense-micro-ohms = <10000>;
			rockchip,sleep-enter-current-microamp = <300000>;
			rockchip,sleep-filter-current-microamp = <100000>;
		};
	};
};

&i2s1_2ch {
	status = "okay";
};

&io_domains {
	vccio1-supply = <&vccio_sd>;
	vccio2-supply = <&vccio_sd>;
	vccio3-supply = <&vcc_3v3>;
	vccio4-supply = <&vcc_3v3>;
	vccio5-supply = <&vcc_3v3>;
	vccio6-supply = <&vcc_3v3>;
	status = "okay";
};

&pinctrl {
	btns {
		btn_pins: btn-pins {
			rockchip,pins =
				<0 RK_PB3 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PA1 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PA2 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PA4 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PA6 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PB1 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PB3 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PB4 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		vol_pins: vol-pins {
			rockchip,pins =
				<3 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	headphone {
		hp_det: hp-det {
			rockchip,pins =
				<2 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	leds {
		led_pins: led-pins {
			rockchip,pins =
				<0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>,
				<0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	pmic {
		pmic_int: pmic-int {
			rockchip,pins =
				<0 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	speaker {
		spk_amp_enable_h: spk-amp-enable-h {
			rockchip,pins =
				<3 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&pmu_io_domains {
	pmuio1-supply = <&vcc3v3_pmu>;
	pmuio2-supply = <&vcc3v3_pmu>;
	status = "okay";
};

&pwm1 {
	status = "okay";
};

&saradc {
	vref-supply = <&vcc1v8_soc>;
	status = "okay";
};

/* TF1: the system card (card detect on the native sdmmc_det pin, gpio0 3) */
&sdmmc {
	cap-mmc-highspeed;
	cap-sd-highspeed;
	no-sdio;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc_sd>;
	vqmmc-supply = <&vccio_sd>;
	status = "okay";
};

/* TF2: second slot (card detect gpio0 10); what to do with it is P-16 */
&sdio {
	cap-mmc-highspeed;
	cap-sd-highspeed;
	cd-gpios = <&gpio0 RK_PB2 GPIO_ACTIVE_LOW>;
	no-sdio;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc_sd>;
	vqmmc-supply = <&vccio_sd>;
	status = "okay";
};

&tsadc {
	status = "okay";
};

&u2phy {
	status = "okay";

	u2phy_otg: otg-port {
		status = "okay";
	};
};

&usb20_otg {
	status = "okay";
};

/* debug serial: UART2 on the m1 pins, 1500000 baud like the factory bootloader */
&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2m1_xfer>;
	status = "okay";
};

&vopb {
	status = "okay";
};

&vopb_mmu {
	status = "okay";
};

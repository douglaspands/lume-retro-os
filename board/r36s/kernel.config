# R36S V5 (Rockchip RK3326, aarch64): fragment on top of the kernel's arm64 defconfig,
# applied with scripts/kconfig/merge_config.sh (design D7 of r36s-single-card).
# The build fails if any option here does not keep the requested value in the final .config.
#
# Already in the arm64 defconfig and not repeated: ARCH_ROCKCHIP, CPUFREQ_DT, I2C_RK3X,
# MFD_RK8XX_I2C, REGULATOR_RK808, COMMON_CLK_RK808, ROCKCHIP_DW_MIPI_DSI, PWM_ROCKCHIP,
# ROCKCHIP_IOMMU, ROCKCHIP_IODOMAIN, ROCKCHIP_PM_DOMAINS, IIO, LEDS_CLASS, LEDS_GPIO, SERIAL_8250_DW, SERIAL_8250_CONSOLE, VFAT_FS, SQUASHFS, BLK_DEV_LOOP,
# BLK_DEV_INITRD, DEVTMPFS and DEVTMPFS_MOUNT.
#
# What the defconfig builds as a module and the console needs early is built in here, as
# on the GA36: the panel and fbcon (boot messages on the screen), the GPU, the PMIC
# (charger, codec), the gamepad and the filesystems of the boot. CPU frequency and thermal
# stay at the mainline defaults (OPPs and zones of rk3326.dtsi).

CONFIG_LOCALVERSION="-r36os"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Boot through the factory chain (D4/D5): the vendor U-Boot runs booti with our Image and
# DTB. The command line is this one (the boot.ini one does not count) and the initramfs is
# built into the kernel, as on the GA36. ttyS2 at 1500000 is the speed of the factory
# bootloader, so the serial never changes speed during the boot. printk.devkmsg=on: every
# line the initramfs writes to /dev/kmsg is kept (lume-bootsel lost 5 lines to the rate
# limit before a kexec, 2026-11-15).
CONFIG_CMDLINE="root=PARTUUID=4c554d32-01 rootwait console=ttyS2,1500000 console=tty1 loglevel=6 printk.devkmsg=on"
CONFIG_CMDLINE_FORCE=y
CONFIG_INITRAMFS_SOURCE="/initramfs/initramfs.cpio"

# DTB selection (boot-dtb-select D2): the initramfs reloads this same kernel (BOOT/r36s/
# Image) with another DTB of BOOT/dtbs/rk3326/ through kexec_load (kexec-tools --dtb).
# Already in the arm64 defconfig, repeated so the build fails if it goes away.
CONFIG_KEXEC=y
# kexec-tools reads VA_BITS and the page offset from /proc/kcore for kexec_load (it warned
# "Can't open (/proc/kcore)" on the R36S, 2026-11-15)
CONFIG_PROC_KCORE=y
# Watchdog through the kexec (boot-dtb-select D11): the RK3326 one (dw_wdt, node enabled in
# the DTS) built in, and the kernel stops feeding a watchdog it finds running if nobody opens
# it in 30 s (0, the default, fed it forever: a hang in user space before lume-bootsel would
# never reset). The second start reaches lume-bootsel about 3 s after the kexec.
CONFIG_WATCHDOG=y
CONFIG_DW_WATCHDOG=y
CONFIG_WATCHDOG_OPEN_TIMEOUT=30
# The log of the previous start, kept in RAM across a warm reset (boot-dtb-select 1.5: the
# second kernel of a kexec_load fell over without writing any log). ramoops in the region
# the factory kernel reserves (0x110000, below the RAM the bootloader gives the kernel),
# built in so it holds the console from the first line; read in /sys/fs/pstore.
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# Keys read by the selection key in the initramfs (D7): buttons and volume keys in
# gpio-keys. Already in the defconfig, repeated for the same reason.
CONFIG_INPUT_EVDEV=y

# USB gadget on the OTG port (usb-device-access D2): the "Lume" gadget built through
# configfs, with FunctionFS for MTP (umtprd) and NCM for the USB network, built in here
# (modules in the arm64 defconfig) so the boot needs no modprobe, as on the GA36. The DWC2
# in dual-role and the role switch (D1: default device, host set from the ID pin) are
# already in the defconfig, repeated so the build fails if they go away.
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_NCM=y

# Host role of the OTG port (usb-device-access D8, P-38): pendrive (built in, already in the
# arm64 defconfig), USB controllers (Xbox, PlayStation, Nintendo, generic HID such as
# 8BitDo), keyboard, mouse. Device drivers are modules, loaded by udev when the device
# shows up; the same block as on the GA36.
CONFIG_USB_STORAGE=y
CONFIG_HID_GENERIC=y
CONFIG_JOYSTICK_XPAD=m
# the PS4/PS5 driver needs the multicolor LED class (the light bar)
CONFIG_LEDS_CLASS_MULTICOLOR=m
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_SONY=m
CONFIG_HID_NINTENDO=m

# Wi-Fi and Bluetooth by USB dongle (usb-device-access D9, D10, P-15): Realtek rtw88
# (RTL8821CU, the reference dongle, and the other Realtek USB chips), rtl8xxxu
# (RTL8188/8192/8723 USB), Atheros ath9k_htc (AR9271); Bluetooth USB with the Realtek
# setup, classic HID (controllers, keyboards) and uhid (BLE controllers through bluez).
# The Alpine firmware files are zstd-compressed.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=m
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8723DU=m
CONFIG_RTL8XXXU=m
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HTC=m
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HIDP=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_UHID=m
CONFIG_KEYBOARD_GPIO=y

# Panel: VOP, DSI and its D-PHY, the ST7703 panel (variant in kernel/patches/0010), the
# PWM backlight and fbcon, built in so the verbose boot shows on the panel early
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_DRM_PANEL_SITRONIX_ST7703=y
# panels of the device trees converted from the clones (kernel/patches/0033, D13), and the
# ADC volume keys some of those boards have
CONFIG_DRM_PANEL_GENERIC_DSI=y
CONFIG_KEYBOARD_ADC=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# No Tux on fbcon (the arm64 defconfig turns it on): the boot screen is the same on both
# consoles, with logo.bmp from the bootloader only
# CONFIG_LOGO is not set

# GPU: Mali-G31 (Bifrost) with panfrost
CONFIG_DRM_PANFROST=y

# PMIC RK817: charger and fuel gauge (simple-battery in the DTS), RTC
CONFIG_CHARGER_RK817=y
CONFIG_RTC_DRV_RK808=y

# Audio: I2S1 and the RK817 codec in a simple-audio-card, with the speaker amplifier on
# gpio3 20 (simple-audio-amplifier)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP_I2S=y
CONFIG_SND_SOC_RK817=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=y

# Gamepad: buttons in gpio-keys and the two sticks in adc-joystick over the SARADC behind a
# GPIO multiplexer (io-channel-mux); r36os-input joins them in user space (lume-launcher D8). joydev
# gives the js* device that the hardware summary looks for.
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_ADC=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_IIO_MUX=y
CONFIG_MUX_GPIO=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_UINPUT=y
# Bring-up only (task 4.6, boot 15): log every input event in the kernel log (kernel patch
# 0021), to see whether a press is lost in the kernel, in r36os-input or in RetroArch.
# Remove after, together with the patch.
CONFIG_INPUT_EVLOG=y

# Temperature: tsadc (soc and gpu zones of rk3326.dtsi), so throttling works from the start
CONFIG_ROCKCHIP_THERMAL=y

# Boot (D6): SD card, SYSTEM squashfs on loop, overlay with tmpfs, FAT BOOT and exFAT ROMS
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXFAT_FS=y
CONFIG_MSDOS_PARTITION=y

# Game cgroups (lume-launcher D9): lume-run puts each game in its own cgroup v2 and ends it
# with cgroup.kill (core since 5.14). Already in the arm64 defconfig, repeated so the build
# fails if they go away.
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y

# Memory: compressed swap in RAM (ZRAM + LZ4)
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

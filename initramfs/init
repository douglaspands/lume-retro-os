#!/bin/busybox sh
# Initramfs init of Lume Retro OS (D6).
# BOOT (FAT32, ro) -> slots lume:runtime:base or the old SYSTEM (squashfs, loop, ro)
# + 32 MiB tmpfs -> overlay -> switch_root.
# Creates the ROMS partition on the first boot; never formats an existing partition 2.

/bin/busybox --install -s /bin
export PATH=/bin:/sbin

mkdir -p /proc /sys /dev /boot /lower /rw /newroot /tmp /roms /modules
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
# The cpio has no /dev/console: tie the output to the console only now.
exec 0</dev/console 1>/dev/console 2>&1
# No echo on the screen console: the volume keys are a keyboard to the kernel, and the
# key held at power on for the device tree list repeated its characters on tty1
# (boot-dtb-select 6.7). The emergency shell turns it back on.
stty -F /dev/tty1 -echo 2>/dev/null

. /lib/storage.sh
. /lib/slots.sh
. /lib/brightness.sh

# Console of this initramfs (written by the build, one initramfs per hardware layer)
BOARD=$(cat /etc/board 2>/dev/null)

# Status LED on as soon as the kernel reaches init (first sign of life without a serial)
for led in /sys/class/leds/*:status; do
	[ -w "$led/brightness" ] && echo 1 > "$led/brightness"
done

rescue() {
	log "ERROR: $*"
	log "opening emergency shell on console"
	stty -F /dev/tty1 echo 2>/dev/null
	exec setsid cttyhack sh
}

# Modules (VM only; on the consoles the boot drivers are built into the kernel).
if [ -f /etc/modules ]; then
	while read -r m; do
		[ -n "$m" ] && insmod "/lib/modules/$m" 2>/dev/null
	done < /etc/modules
fi

# root=PARTUUID=<MBR signature>-01, from the kernel command line.
SIG=""
for arg in $(cat /proc/cmdline); do
	case "$arg" in root=PARTUUID=*) SIG=${arg#root=PARTUUID=}; SIG=${SIG%-*} ;; esac
done
[ -n "$SIG" ] || rescue "cmdline without root=PARTUUID="

# Wait for the card by its MBR signature (10 s timeout).
find_disk() {
	local d sig
	for d in /sys/block/*; do
		d=${d##*/}
		case "$d" in loop*|ram*|zram*) continue ;; esac
		[ -b "/dev/$d" ] || continue
		sig=$(dd if="/dev/$d" bs=1 skip=440 count=4 2>/dev/null | hexdump -e '1/4 "%08x"')
		[ "$sig" = "$SIG" ] && { echo "/dev/$d"; return 0; }
	done
	return 1
}
log "console: $(console_label "$BOARD")"
log "searching for boot disk (PARTUUID=$SIG-01)..."
i=0
until DISK=$(find_disk); do
	i=$((i + 1))
	[ $i -ge 100 ] && rescue "boot disk not found within 10s"
	sleep 0.1
done
BOOT=$(part_node "$DISK" 1)
wait_node "$BOOT" || rescue "BOOT partition missing on $DISK"
log "boot disk at $DISK"

# Games partition: before any mount of the card (the kernel does not reread the
# table of a disk with a mounted partition).
ROMS_OK=$(setup_storage "$DISK")

mount -t vfat -o ro,noatime "$BOOT" /boot || rescue "failed to mount BOOT"

# ROMS before SYSTEM: the device tree selection keeps its state there; it moves to
# /newroot/storage once the root is ready.
ROMS_MOUNTED=""
mount_roms() {
	mount -t exfat -o uid=1000,gid=1000,fmask=0022,dmask=0022,noatime \
		"$(part_node "$DISK" 2)" /roms
}
case "$ROMS_OK" in ok*)
	mkdir -p /roms
	if mount_roms; then
		ROMS_MOUNTED=1
		# the ROMS lines of a start that restarted the kernel, then the check request
		# (device-fixes D3): one file test each when there is nothing
		roms_carry_replay /roms
		if ! roms_request "$DISK" /roms mount_roms "${ROMS_OK#ok }"; then
			ROMS_MOUNTED=""
			log "ERROR: failed to mount ROMS after the requested check; continuing without games partition"
		fi
	else
		log "ERROR: failed to mount ROMS; continuing without games partition"
	fi
	;;
esac

# The saved brightness (device-fixes 9.16, lib/brightness.sh): one read and one sysfs write,
# so the chosen level shows from here on instead of the device tree's until lume-input starts
[ -n "$ROMS_MOUNTED" ] && brightness_restore /roms/system/display/brightness

# Device tree selection (boot-dtb-select): lume-bootsel picks the DTB of BOOT/dtbs/<soc>/
# and, when it is not the running one, loads this same kernel with it (status 10). Then
# everything is unmounted and kexec -e restarts the kernel; the second start sees the
# choice in /chosen and goes on. On the GA36 (D16) it rewrites the boot image instead
# (status 11), and the console reboots into it. Without a device tree (the vm) it only
# logs that.
select_dtb() {
	local rc=0 kernel=""
	[ -x /bin/lume-bootsel ] || return 0
	case "$BOARD" in
	ga36) kernel=ga36/zImage ;;
	r36s) kernel=r36s/Image ;;
	esac
	lume-bootsel --boot /boot ${ROMS_MOUNTED:+--roms /roms} ${kernel:+--kernel $kernel} \
		--disk "$DISK" || rc=$?
	if [ $rc = 11 ]; then
		log "rebooting into the boot image with the chosen device tree"
		[ -n "$ROMS_MOUNTED" ] && roms_carry_save /roms "(before reboot)"
		sync
		[ -n "$ROMS_MOUNTED" ] && umount /roms
		umount /boot
		reboot -f
		# reboot -f does not return; if it does, go on with the running device tree
		log "ERROR: reboot failed; booting with the running device tree"
		mount -t vfat -o ro,noatime "$BOOT" /boot || rescue "failed to mount BOOT"
		if [ -n "$ROMS_MOUNTED" ] && ! mount_roms; then
			ROMS_MOUNTED=""
			log "ERROR: failed to mount ROMS; continuing without games partition"
		fi
		[ -n "$ROMS_MOUNTED" ] && roms_carry_drop /roms
		return 0
	fi
	[ $rc = 10 ] || return 0
	log "restarting the kernel with the chosen device tree"
	[ -n "$ROMS_MOUNTED" ] && roms_carry_save /roms "(before kexec)"
	sync
	[ -n "$ROMS_MOUNTED" ] && umount /roms
	umount /boot
	kexec -e
	# kexec -e only returns when it fails: go on with the running device tree
	log "ERROR: kexec -e failed; booting with the running device tree"
	mount -t vfat -o ro,noatime "$BOOT" /boot || rescue "failed to mount BOOT"
	if [ -n "$ROMS_MOUNTED" ] && ! mount_roms; then
		ROMS_MOUNTED=""
		log "ERROR: failed to mount ROMS; continuing without games partition"
	fi
	[ -n "$ROMS_MOUNTED" ] && roms_carry_drop /roms
	# the chosen device tree never ran: not pending, and the watchdog armed for it stops
	lume-bootsel --boot /boot ${ROMS_MOUNTED:+--roms /roms} --kexec-failed || true
}
select_dtb

# Root and kernel modules (lib/slots.sh): the slot set of BOOT/<console>/SLOTS (or SLOTS.old),
# else the old BOOT/<console>/SYSTEM, else rescue. After select_dtb: an open loop on BOOT
# would stop the umount before the kexec.
mount_root "$BOARD" /boot /slots /lower /rw /newroot /modules

if [ -n "$ROMS_MOUNTED" ]; then
	if mount --move /roms /newroot/storage; then
		CATALOG=/newroot/usr/share/lume/systems.json
		if [ -f "$CATALOG" ]; then
			# absolute path: the initramfs PATH has no /usr/bin
			IDS=$(chroot /newroot /usr/bin/jq -r '.systems[].id' /usr/share/lume/systems.json) \
				|| log "ERROR: failed to read catalog"
			make_folders /newroot/storage $IDS
		else
			log "ERROR: catalog $CATALOG missing"
			make_folders /newroot/storage
		fi
		README=/newroot/usr/share/lume/LEIA-ME.txt
		if [ -f "$README" ] && ! cmp -s "$README" /newroot/storage/LEIA-ME.txt; then
			cp "$README" /newroot/storage/LEIA-ME.txt
		fi
		log "ROMS mounted at /storage"
	else
		log "ERROR: failed to mount ROMS; continuing without games partition"
	fi
fi

mount --move /boot /newroot/boot
mount --move /dev /newroot/dev
umount /proc /sys
exec switch_root /newroot /sbin/init

#!/bin/busybox sh
# Initramfs init of Lume Retro OS (D6).
# BOOT (FAT32, ro) -> SYSTEM (squashfs, loop, ro) + 32 MiB tmpfs -> overlay -> switch_root.
# Creates the ROMS partition on the first boot; never formats an existing partition 2.

/bin/busybox --install -s /bin
export PATH=/bin:/sbin

mkdir -p /proc /sys /dev /boot /lower /rw /newroot /tmp
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
# The cpio has no /dev/console: tie the output to the console only now.
exec 0</dev/console 1>/dev/console 2>&1

. /lib/storage.sh

# Console of this initramfs (written by the build, one initramfs per hardware layer)
BOARD=$(cat /etc/board 2>/dev/null)

# Status LED on as soon as the kernel reaches init (first sign of life without a serial)
for led in /sys/class/leds/*:status; do
	[ -w "$led/brightness" ] && echo 1 > "$led/brightness"
done

rescue() {
	log "ERROR: $*"
	log "opening emergency shell on console"
	exec setsid cttyhack sh
}

# Modules (VM only; on the consoles the boot drivers are built into the kernel).
if [ -f /etc/modules ]; then
	while read -r m; do
		[ -n "$m" ] && insmod "/lib/modules/$m" 2>/dev/null
	done < /etc/modules
fi

# root=PARTUUID=<MBR signature>-01, from the kernel command line.
SIG=""
for arg in $(cat /proc/cmdline); do
	case "$arg" in root=PARTUUID=*) SIG=${arg#root=PARTUUID=}; SIG=${SIG%-*} ;; esac
done
[ -n "$SIG" ] || rescue "cmdline without root=PARTUUID="

# Wait for the card by its MBR signature (10 s timeout).
find_disk() {
	local d sig
	for d in /sys/block/*; do
		d=${d##*/}
		case "$d" in loop*|ram*|zram*) continue ;; esac
		[ -b "/dev/$d" ] || continue
		sig=$(dd if="/dev/$d" bs=1 skip=440 count=4 2>/dev/null | hexdump -e '1/4 "%08x"')
		[ "$sig" = "$SIG" ] && { echo "/dev/$d"; return 0; }
	done
	return 1
}
log "console: $(console_label "$BOARD")"
log "searching for boot disk (PARTUUID=$SIG-01)..."
i=0
until DISK=$(find_disk); do
	i=$((i + 1))
	[ $i -ge 100 ] && rescue "boot disk not found within 10s"
	sleep 0.1
done
BOOT=$(part_node "$DISK" 1)
wait_node "$BOOT" || rescue "BOOT partition missing on $DISK"
log "boot disk at $DISK"

# Games partition: before any mount of the card (the kernel does not reread the
# table of a disk with a mounted partition).
ROMS_OK=$(setup_storage "$DISK")

mount -t vfat -o ro,noatime "$BOOT" /boot || rescue "failed to mount BOOT"
SYSTEM=$(system_file "$BOARD")
# Never falls back to the SYSTEM of another console (another architecture)
[ -f "/boot/$SYSTEM" ] || rescue "BOOT has no $SYSTEM, the system of the $(console_label "$BOARD"); write the card again with the console image"
mount -t squashfs -o ro,loop "/boot/$SYSTEM" /lower || rescue "failed to mount $SYSTEM"
mount -t tmpfs -o size=32m,mode=0755 tmpfs /rw
mkdir -p /rw/upper /rw/work
mount -t overlay overlay -o lowerdir=/lower,upperdir=/rw/upper,workdir=/rw/work /newroot \
	|| rescue "failed to mount overlay"
log "root: $SYSTEM (read-only) + 32 MiB RAM layer"

if [ "$ROMS_OK" = ok ]; then
	if mount -t exfat -o uid=1000,gid=1000,fmask=0022,dmask=0022,noatime \
		"$(part_node "$DISK" 2)" /newroot/storage; then
		CATALOG=/newroot/usr/share/r36os/systems.json
		if [ -f "$CATALOG" ]; then
			# absolute path: the initramfs PATH has no /usr/bin
			IDS=$(chroot /newroot /usr/bin/jq -r '.systems[].id' /usr/share/r36os/systems.json) \
				|| log "ERROR: failed to read catalog"
			make_folders /newroot/storage $IDS
		else
			log "ERROR: catalog $CATALOG missing"
			make_folders /newroot/storage
		fi
		README=/newroot/usr/share/r36os/LEIA-ME.txt
		if [ -f "$README" ] && ! cmp -s "$README" /newroot/storage/LEIA-ME.txt; then
			cp "$README" /newroot/storage/LEIA-ME.txt
		fi
		log "ROMS mounted at /storage"
	else
		log "ERROR: failed to mount ROMS; continuing without games partition"
	fi
fi

mount --move /boot /newroot/boot
mount --move /dev /newroot/dev
umount /proc /sys
exec switch_root /newroot /sbin/init
